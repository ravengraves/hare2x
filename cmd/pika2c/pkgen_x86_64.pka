				};
				if (k == N_FLD) {
					let fld_base_eval = t_first_nn(n);
					x86_field_setup(g, fr, n, fld_base_eval);
					fr.state = 1;
					let fld_base_want_addr_eval = !fr.base_is_ptr;
					x86_eval_push(stack_ptr, &sp, fld_base_eval, fld_base_want_addr_eval);
					continue;
				};
				if (k == N_LEN) {
					let len_expr = t_first_nn(n);
					let len_ty_opt = get_expr_type(g, len_expr);
					if (len_ty_opt != null) {
