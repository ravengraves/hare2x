					let idx_node_addr = t_next_nn(t_first_nn(n));
					x86_eval_push(stack_ptr, &sp, idx_node_addr, false);
					continue;
				};
				if (k == N_FLD) {
					let deref_i: u8 = 0;
					for (deref_i < fr.field_deref) {
