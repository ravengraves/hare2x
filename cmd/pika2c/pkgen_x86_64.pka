					let ret_is_float = false;
					let ret_is_tagged = false;
					if (call_ret_ty_opt_eval != null) {
						let ret_ty_eval: *tnode = unwrap(call_ret_ty_opt_eval);
						let ret_res = resolve_alias_type(g, ret_ty_eval);
						if (ret_res != null) { ret_ty_eval = unwrap(ret_res); };
						if (ret_ty_eval.kind == N_T_SLICE) { ret_is_slice = true; }
						else if (ret_ty_eval.kind == N_T_TAGGED) { ret_is_tagged = true; }
						else if (type_is_str(ret_ty_eval, g.t.src)) { ret_is_str = true; }
						else if (x86_is_float_ty(g, ret_ty_eval)) { ret_is_float = true; };
					};
					let int_start: i64 = 0;
					if (ret_is_slice || ret_is_tagged) { int_start = 1; };
					let int_tmp: i64 = int_start;
					let float_tmp: i64 = 0;
					let stack_bytes: i64 = 0;
					for (let i = 0z; i < fr.arg_count: size; i += 1) {
						let kind_i = fr.arg_kind[i];
						if (kind_i == X86_ARG_FLOAT) {
							if (float_tmp < 8) { float_tmp += 1; } else { stack_bytes += 8; };
						} else if (kind_i == X86_ARG_STR) {
							if (int_tmp <= 4) { int_tmp += 2; } else { stack_bytes += 16; };
						} else if (kind_i == X86_ARG_TAGGED) {
							if (int_tmp <= 4) { int_tmp += 2; } else { stack_bytes += 16; };
						} else if (kind_i == X86_ARG_SLICE) {
							stack_bytes += 24;
						} else {
							if (int_tmp < 6) { int_tmp += 1; } else { stack_bytes += 8; };
						};
					};
					let stack_words = stack_bytes / 8;
					let need_pad = ((ctx.temp_depth + stack_words) & 1) != 0;
					let total_sub = stack_bytes;
					if (need_pad) { total_sub += 8; };
					if (total_sub > 0) { x86_emit_ins_pre_i_suf(&g.em, "subq $", total_sub, ", %rsp"); };
					let ret_off: i64 = 0;
					if (ret_is_slice || ret_is_tagged) {
						ret_off = x86_struct_scratch_alloc(ctx);
						x86_emit_ins_pre_i_suf(&g.em, "leaq -", ret_off, "(%rbp), %rdi");
					};
					let call_int_idx_eval = int_start;
					let call_float_idx_eval = 0i64;
					let stack_off: i64 = 0;
					for (let i2 = 0z; i2 < fr.arg_count: size; i2 += 1) {
						let call_arg_kind_i2 = fr.arg_kind[i2];
						let call_arg_scratch_i2 = fr.arg_scratch[i2];
						let call_arg_off_i2 = fr.call_scratch_base + (call_arg_scratch_i2: i64) * 8;
						if (call_arg_kind_i2 == X86_ARG_FLOAT) {
							if (call_float_idx_eval == 0) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm0"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 1) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm1"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 2) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm2"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 3) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm3"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 4) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm4"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 5) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm5"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 6) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm6"); call_float_idx_eval += 1; }
							else if (call_float_idx_eval == 7) { x86_emit_ins_pre_i_suf(&g.em, "movsd -", call_arg_off_i2, "(%rbp), %xmm7"); call_float_idx_eval += 1; }
							else {
								x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r10");
								emit_s(&g.em, "\tmovq %r10, ");
								e_i(&g.em, stack_off);
								emit_s(&g.em, "(%rsp)");
								e_nl(&g.em);
								stack_off += 8;
							};
						} else if (call_arg_kind_i2 == X86_ARG_STR) {
							if (call_int_idx_eval <= 4) {
								if (call_int_idx_eval == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rdi"); }
								else if (call_int_idx_eval == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rsi"); }
								else if (call_int_idx_eval == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rdx"); }
								else if (call_int_idx_eval == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rcx"); }
								else if (call_int_idx_eval == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r8"); };
								if (call_int_idx_eval == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %rsi"); }
								else if (call_int_idx_eval == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %rdx"); }
								else if (call_int_idx_eval == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %rcx"); }
								else if (call_int_idx_eval == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %r8"); }
								else if (call_int_idx_eval == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %r9"); };
								call_int_idx_eval += 2;
							} else {
								x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r10");
								emit_s(&g.em, "\tmovq %r10, ");
								e_i(&g.em, stack_off);
								emit_s(&g.em, "(%rsp)");
								e_nl(&g.em);
								x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %r10");
								emit_s(&g.em, "\tmovq %r10, ");
								e_i(&g.em, stack_off + 8);
								emit_s(&g.em, "(%rsp)");
								e_nl(&g.em);
								stack_off += 16;
							};
						} else if (call_arg_kind_i2 == X86_ARG_TAGGED) {
							let payload_off = call_arg_off_i2 - 8;
							if (call_int_idx_eval <= 4) {
								if (call_int_idx_eval == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rdi"); }
								else if (call_int_idx_eval == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rsi"); }
								else if (call_int_idx_eval == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rdx"); }
								else if (call_int_idx_eval == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rcx"); }
								else if (call_int_idx_eval == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r8"); };
								if (call_int_idx_eval == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq -", payload_off, "(%rbp), %rsi"); }
								else if (call_int_idx_eval == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq -", payload_off, "(%rbp), %rdx"); }
								else if (call_int_idx_eval == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq -", payload_off, "(%rbp), %rcx"); }
								else if (call_int_idx_eval == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq -", payload_off, "(%rbp), %r8"); }
								else if (call_int_idx_eval == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq -", payload_off, "(%rbp), %r9"); };
								call_int_idx_eval += 2;
							} else {
								x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r10");
								emit_s(&g.em, "\tmovq %r10, ");
								e_i(&g.em, stack_off);
								emit_s(&g.em, "(%rsp)");
								e_nl(&g.em);
								x86_emit_ins_pre_i_suf(&g.em, "movq -", payload_off, "(%rbp), %r10");
								emit_s(&g.em, "\tmovq %r10, ");
								e_i(&g.em, stack_off + 8);
								emit_s(&g.em, "(%rsp)");
								e_nl(&g.em);
								stack_off += 16;
							};
						} else if (call_arg_kind_i2 == X86_ARG_SLICE) {
							x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r10");
							emit_s(&g.em, "\tmovq %r10, ");
							e_i(&g.em, stack_off);
							emit_s(&g.em, "(%rsp)");
							e_nl(&g.em);
							x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 8, "(%rbp), %r10");
							emit_s(&g.em, "\tmovq %r10, ");
							e_i(&g.em, stack_off + 8);
							emit_s(&g.em, "(%rsp)");
							e_nl(&g.em);
							x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2 + 16, "(%rbp), %r10");
							emit_s(&g.em, "\tmovq %r10, ");
							e_i(&g.em, stack_off + 16);
							emit_s(&g.em, "(%rsp)");
							e_nl(&g.em);
							stack_off += 24;
						} else {
							if (call_int_idx_eval == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rdi"); call_int_idx_eval += 1; }
							else if (call_int_idx_eval == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rsi"); call_int_idx_eval += 1; }
							else if (call_int_idx_eval == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rdx"); call_int_idx_eval += 1; }
							else if (call_int_idx_eval == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %rcx"); call_int_idx_eval += 1; }
							else if (call_int_idx_eval == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r8"); call_int_idx_eval += 1; }
							else if (call_int_idx_eval == 5) { x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r9"); call_int_idx_eval += 1; }
							else {
								x86_emit_ins_pre_i_suf(&g.em, "movq -", call_arg_off_i2, "(%rbp), %r10");
								emit_s(&g.em, "\tmovq %r10, ");
								e_i(&g.em, stack_off);
								emit_s(&g.em, "(%rsp)");
								e_nl(&g.em);
								stack_off += 8;
							};
						};
					};
					let call_fn_node_eval2 = t_first(n);
					if (call_fn_node_eval2 == null) {
						if (total_sub > 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", total_sub, ", %rsp"); };
						last_is_float = false;
						sp -= 1;
						continue;
					};
					let call_fn_eval2: *tnode = unwrap(call_fn_node_eval2);
					if (call_fn_eval2.kind == N_ID) {
						let call_glob_ptr_eval = dict_get_bref(&g.globals, call_fn_eval2.ref);
						if (call_glob_ptr_eval != 0) {
							let call_fn_def_eval2: *tnode = call_glob_ptr_eval: uintptr: *tnode;
							if (call_fn_def_eval2.kind == N_FN && (call_fn_def_eval2.flags & F_SYMBOL) != 0) {
								let call_sym_eval: *tnode = t_first_nn(call_fn_def_eval2);
								let call_sym_ref_eval: bref = call_sym_eval.ref;
								if (call_sym_ref_eval.length > 2) {
									let call_inner_ref_eval = bref { pos = call_sym_ref_eval.pos + 1, length = call_sym_ref_eval.length - 2 };
									emit_s(&g.em, "\tcall ");
									e_bref(&g.em, call_inner_ref_eval);
									e_nl(&g.em);
								} else {
									x86_emit_ins_b(&g.em, "call %", call_fn_eval2.ref);
								};
							} else {
								emit_s(&g.em, "\tcall ");
								e_prefixed_id(g, call_fn_eval2.ref);
								e_nl(&g.em);
							};
						} else {
							emit_s(&g.em, "\tcall ");
							e_prefixed_id(g, call_fn_eval2.ref);
							e_nl(&g.em);
						};
					} else if (call_fn_eval2.kind == N_QUAL_ID) {
						let call_mod_ref_eval = bref_empty();
						let call_member_ref_eval = bref_empty();
						if (!qual_id_parts(g, call_fn_eval2, &call_mod_ref_eval, &call_member_ref_eval)) {
							err_bref(call_fn_eval2.ref, g.t.src, g.t.src_len, "invalid qualified call");
						};
						emit_s(&g.em, "\tcall ");
						emit_path_mangled(g, call_mod_ref_eval);
						e_c(&g.em, '_');
						e_bref(&g.em, call_member_ref_eval);
						e_nl(&g.em);
					} else {
						err_bref(call_fn_eval2.ref, g.t.src, g.t.src_len, "unsupported call target");
					};
					if (total_sub > 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", total_sub, ", %rsp"); };
					if (ret_is_slice || ret_is_tagged) {
						x86_emit_ins_pre_i_suf(&g.em, "leaq -", ret_off, "(%rbp), %rax");
						last_is_float = false;
					} else if (ret_is_str) {
						let str_off = x86_struct_scratch_alloc(ctx);
						x86_emit_ins_pre_i_suf(&g.em, "leaq -", str_off, "(%rbp), %r11");
						x86_emit_ins(&g.em, "movq %rax, (%r11)");
						x86_emit_ins(&g.em, "movq %rdx, 8(%r11)");
						x86_emit_ins(&g.em, "movq %r11, %rax");
						last_is_float = false;
					} else {
						last_is_float = ret_is_float;
					};
					if (ctx.call_scratch_depth > 0) { ctx.call_scratch_depth -= 1; };
					sp -= 1;
					continue;
				};
			};
		} else if (fr.state == 3) {
			if (k == N_SLICE) {
				x86_pop_to(ctx, false, false, "popq %r8");
				x86_pop_to(ctx, false, false, "popq %r11");
				let slice_off = x86_struct_scratch_alloc(ctx);
				x86_emit_ins_pre_i_suf(&g.em, "leaq -", slice_off, "(%rbp), %r9");
				let elem_sz: i64 = 8;
				if (fr.slice_elem_ty != null) { elem_sz = x86_type_elem_slot_size(g, unwrap(fr.slice_elem_ty)); };
				if (fr.slice_kind == X86_SLICE_SLICE) {
					x86_emit_ins(&g.em, "movq (%r11), %r10");
				} else {
					x86_emit_ins(&g.em, "movq %r11, %r10");
				};
				x86_emit_ins(&g.em, "movq %r8, %rcx");
				if (elem_sz != 1) { x86_emit_ins_pre_i_suf(&g.em, "imulq $", elem_sz, ", %rcx"); };
				x86_emit_ins(&g.em, "addq %rcx, %r10");
				x86_emit_ins(&g.em, "movq %r10, (%r9)");
				x86_emit_ins(&g.em, "movq %rax, %rcx");
				x86_emit_ins(&g.em, "subq %r8, %rcx");
				x86_emit_ins(&g.em, "movq %rcx, 8(%r9)");
				if (fr.slice_kind == X86_SLICE_SLICE) {
					x86_emit_ins(&g.em, "movq 16(%r11), %r10");
					x86_emit_ins(&g.em, "subq %r8, %r10");
					x86_emit_ins(&g.em, "movq %r10, 16(%r9)");
				} else if (fr.slice_kind == X86_SLICE_ARRAY) {
					x86_emit_ins_pre_i_suf(&g.em, "movq $", fr.slice_base_len, ", %r10");
					x86_emit_ins(&g.em, "subq %r8, %r10");
					x86_emit_ins(&g.em, "movq %r10, 16(%r9)");
				} else {
					x86_emit_ins(&g.em, "movq %rcx, 16(%r9)");
				};
				x86_emit_ins(&g.em, "movq %r9, %rax");
				last_is_float = false;
				sp -= 1;
				continue;
			};
		};
	};
	return last_is_float;
};

fn x86_emit_let(ctx: *x86_ctx, n: *tnode) void = {
	let g = ctx.g;
	let is_static = (n.flags & F_STATIC) != 0;
	let let_child_emit = t_first(n);
	let let_has_type_emit = false;
	let let_ty_emit: nullable *tnode = null;
	let let_init_emit: nullable *tnode = null;
	match (let_child_emit) {
	case let c: *tnode =>
		if (is_type_kind(c.kind)) {
			let_has_type_emit = true;
			let_ty_emit = c;
			let_init_emit = c.next;
		} else {
			let_init_emit = c;
		};
	case null => void;
	};
	if (let_has_type_emit) {
		vars_register(g, n.ref, unwrap(let_ty_emit): uintptr: u64);
	} else if (let_init_emit != null) {
		let let_inferred_emit = get_expr_type(g, unwrap(let_init_emit));
		if (let_inferred_emit != null) {
			vars_register(g, n.ref, unwrap(let_inferred_emit): uintptr: u64);
		} else {
			vars_register(g, n.ref, 0);
		};
	} else {
		vars_register(g, n.ref, 0);
	};
	if (is_static) { return; };
	if (let_init_emit != null) {
		let let_init_nn_emit: *tnode = unwrap(let_init_emit);
		if (let_has_type_emit && let_ty_emit != null && x86_type_is_array(g, unwrap(let_ty_emit)) && let_init_nn_emit.kind == N_ARR_LIT) {
			x86_emit_array_init(ctx, n.ref, unwrap(let_ty_emit), let_init_nn_emit);
			return;
		};
		if (!let_has_type_emit && let_init_nn_emit.kind == N_ARR_LIT) {
			let let_arr_ty_opt_emit = get_expr_type(g, let_init_nn_emit);
			if (let_arr_ty_opt_emit != null && x86_type_is_array(g, unwrap(let_arr_ty_opt_emit))) {
				x86_emit_array_init(ctx, n.ref, unwrap(let_arr_ty_opt_emit), let_init_nn_emit);
				return;
			};
		};
		if (let_has_type_emit && let_ty_emit != null && x86_type_is_struct(g, unwrap(let_ty_emit)) && let_init_nn_emit.kind == N_STRUCT_LIT) {
			x86_emit_struct_init(ctx, n.ref, unwrap(let_ty_emit), let_init_nn_emit);
			return;
		};
		if (!let_has_type_emit && let_init_nn_emit.kind == N_STRUCT_LIT) {
			let let_type_ptr_emit = dict_get_bref(&g.types, let_init_nn_emit.ref);
			if (let_type_ptr_emit != 0) {
				x86_emit_struct_init(ctx, n.ref, let_type_ptr_emit: uintptr: *tnode, let_init_nn_emit);
				return;
			};
		};
		let let_target_ty: nullable *tnode = null;
		if (let_has_type_emit && let_ty_emit != null) { let_target_ty = let_ty_emit; }
		else {
			let let_infer_ty = get_expr_type(g, let_init_nn_emit);
			if (let_infer_ty != null) { let_target_ty = unwrap(let_infer_ty); };
		};
		if (let_target_ty != null && x86_type_is_struct(g, unwrap(let_target_ty))) {
			let dst_off_struct = x86_local_offset(g, n.ref);
			if (dst_off_struct == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown struct local"); };
			x86_eval_with_expected(ctx, let_init_nn_emit, let_target_ty);
			x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_struct, "(%rbp), %r11");
			let struct_sz = x86_type_slot_size(g, unwrap(let_target_ty));
			x86_copy_struct_addr(ctx, "r11", "rax", struct_sz);
			return;
		};
		if (let_target_ty != null && x86_type_is_str(g, unwrap(let_target_ty))) {
			let dst_off_str = x86_local_offset(g, n.ref);
			if (dst_off_str == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown str local"); };
			if (node_is_str(let_init_nn_emit)) {
				let str_label = x86_emit_str_literal(ctx, let_init_nn_emit);
				emit_s(&g.em, "\tleaq .L");
				e_i(&g.em, str_label);
				emit_s(&g.em, "(%rip), %rax");
				e_nl(&g.em);
			} else {
				x86_eval_with_expected(ctx, let_init_nn_emit, let_target_ty);
			};
			x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_str, "(%rbp), %r11");
			x86_copy_struct_addr(ctx, "r11", "rax", 16);
			return;
		};
		if (let_target_ty != null && x86_type_is_slice(g, unwrap(let_target_ty))) {
			let dst_off_slice = x86_local_offset(g, n.ref);
			if (dst_off_slice == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown slice local"); };
			if (let_init_nn_emit.kind == N_ARR_LIT) {
				let slice_ty: *tnode = unwrap(let_target_ty);
				let elem_opt = t_first(slice_ty);
				if (elem_opt == null) { err_bref(n.ref, g.t.src, g.t.src_len, "slice literal missing element type"); };
				let slice_label = x86_emit_slice_from_arr_lit(ctx, let_init_nn_emit, unwrap(elem_opt));
				emit_s(&g.em, "\tleaq .L");
				e_i(&g.em, slice_label);
				emit_s(&g.em, "(%rip), %rax");
				e_nl(&g.em);
			} else {
				x86_eval_with_expected(ctx, let_init_nn_emit, let_target_ty);
			};
			x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_slice, "(%rbp), %r11");
			x86_copy_struct_addr(ctx, "r11", "rax", 24);
			return;
		};
		if (let_target_ty != null && x86_type_is_tagged(g, unwrap(let_target_ty))) {
			let let_tag_off_emit = x86_local_offset(g, n.ref);
			if (let_tag_off_emit == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown local in let"); };
			let init_ty_opt = get_expr_type(g, let_init_nn_emit);
			let init_is_tagged = false;
			if (init_ty_opt != null && x86_type_is_tagged(g, unwrap(init_ty_opt))) { init_is_tagged = true; };
			if (init_is_tagged) { x86_eval(ctx, let_init_nn_emit, false); }
			else { x86_emit_tagged_wrap(ctx, unwrap(let_target_ty), let_init_nn_emit); };
			x86_emit_ins_pre_i_suf(&g.em, "leaq -", let_tag_off_emit, "(%rbp), %r11");
			x86_copy_struct_addr(ctx, "r11", "rax", 16);
			return;
		};
		let let_is_float_emit = x86_eval_with_expected(ctx, let_init_nn_emit, let_target_ty);
		let let_off_emit = x86_local_offset(g, n.ref);
		if (let_off_emit == 0) {
			err_bref(n.ref, g.t.src, g.t.src_len, "unknown local in let");
		};
		if (let_is_float_emit) {
			x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm0, -", let_off_emit, "(%rbp)");
		} else {
			x86_emit_ins_pre_i_suf(&g.em, "movq %rax, -", let_off_emit, "(%rbp)");
		};
	};
};

fn x86_emit_assignment(ctx: *x86_ctx, n: *tnode) void = {
	let g = ctx.g;
	let asgn_target_emit = t_first_nn(n);
	let asgn_value_emit = t_next_nn(asgn_target_emit);
	let asgn_op_emit = n.ival: u16;
	if (asgn_op_emit == TK_EQ) {
		if (asgn_target_emit.kind == N_ID) {
			let asgn_ty_opt = get_expr_type(g, asgn_target_emit);
			if (asgn_ty_opt != null && x86_type_is_str(g, unwrap(asgn_ty_opt))) {
				x86_eval_with_expected(ctx, asgn_value_emit, unwrap(asgn_ty_opt));
				let dst_off_str_asgn = x86_local_offset(g, asgn_target_emit.ref);
				if (dst_off_str_asgn != 0) {
					x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_str_asgn, "(%rbp), %r11");
				} else {
					let static_id_str = x86_static_find(ctx, asgn_target_emit.ref, g.cur_fn);
					if (static_id_str != 0) {
						emit_s(&g.em, "\tleaq ");
						x86_emit_label_ref(&g.em, static_id_str);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					} else {
						let glob_ptr_str = dict_get_bref(&g.globals, asgn_target_emit.ref);
						if (glob_ptr_str == 0) { err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "unknown str target"); };
						emit_s(&g.em, "\tleaq ");
						e_prefixed_id(g, asgn_target_emit.ref);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					};
				};
				x86_copy_struct_addr(ctx, "r11", "rax", 16);
				return;
			};
			if (asgn_ty_opt != null && x86_type_is_slice(g, unwrap(asgn_ty_opt))) {
				x86_eval_with_expected(ctx, asgn_value_emit, unwrap(asgn_ty_opt));
				let dst_off_slice_asgn = x86_local_offset(g, asgn_target_emit.ref);
				if (dst_off_slice_asgn != 0) {
					x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_slice_asgn, "(%rbp), %r11");
				} else {
					let static_id_slice = x86_static_find(ctx, asgn_target_emit.ref, g.cur_fn);
					if (static_id_slice != 0) {
						emit_s(&g.em, "\tleaq ");
						x86_emit_label_ref(&g.em, static_id_slice);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					} else {
						let glob_ptr_slice = dict_get_bref(&g.globals, asgn_target_emit.ref);
						if (glob_ptr_slice == 0) { err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "unknown slice target"); };
						emit_s(&g.em, "\tleaq ");
						e_prefixed_id(g, asgn_target_emit.ref);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					};
				};
				x86_copy_struct_addr(ctx, "r11", "rax", 24);
				return;
			};
			if (asgn_ty_opt != null && x86_type_is_tagged(g, unwrap(asgn_ty_opt))) {
				let init_ty_opt = get_expr_type(g, asgn_value_emit);
				let init_is_tagged = false;
				if (init_ty_opt != null && x86_type_is_tagged(g, unwrap(init_ty_opt))) { init_is_tagged = true; };
				if (init_is_tagged) { x86_eval(ctx, asgn_value_emit, false); }
				else { x86_emit_tagged_wrap(ctx, unwrap(asgn_ty_opt), asgn_value_emit); };
				let dst_off_tag_asgn = x86_local_offset(g, asgn_target_emit.ref);
				if (dst_off_tag_asgn != 0) {
					x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_tag_asgn, "(%rbp), %r11");
				} else {
					let static_id_tag = x86_static_find(ctx, asgn_target_emit.ref, g.cur_fn);
					if (static_id_tag != 0) {
						emit_s(&g.em, "\tleaq ");
						x86_emit_label_ref(&g.em, static_id_tag);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					} else {
						let glob_ptr_tag = dict_get_bref(&g.globals, asgn_target_emit.ref);
						if (glob_ptr_tag == 0) { err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "unknown tagged target"); };
						emit_s(&g.em, "\tleaq ");
						e_prefixed_id(g, asgn_target_emit.ref);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					};
				};
				x86_copy_struct_addr(ctx, "r11", "rax", 16);
				return;
			};
			if (asgn_ty_opt != null && x86_type_is_struct(g, unwrap(asgn_ty_opt))) {
				x86_eval_with_expected(ctx, asgn_value_emit, unwrap(asgn_ty_opt));
				let dst_off_struct_asgn = x86_local_offset(g, asgn_target_emit.ref);
				if (dst_off_struct_asgn != 0) {
					x86_emit_ins_pre_i_suf(&g.em, "leaq -", dst_off_struct_asgn, "(%rbp), %r11");
				} else {
					let static_id_struct = x86_static_find(ctx, asgn_target_emit.ref, g.cur_fn);
					if (static_id_struct != 0) {
						emit_s(&g.em, "\tleaq ");
						x86_emit_label_ref(&g.em, static_id_struct);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					} else {
						let glob_ptr_struct = dict_get_bref(&g.globals, asgn_target_emit.ref);
						if (glob_ptr_struct == 0) { err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "unknown struct target"); };
						emit_s(&g.em, "\tleaq ");
						e_prefixed_id(g, asgn_target_emit.ref);
						emit_s(&g.em, "(%rip), %r11");
						e_nl(&g.em);
					};
				};
				let struct_sz = x86_type_slot_size(g, unwrap(asgn_ty_opt));
				x86_copy_struct_addr(ctx, "r11", "rax", struct_sz);
				return;
			};
			let asgn_eq_is_float_emit = x86_eval_with_expected(ctx, asgn_value_emit, asgn_ty_opt);
			let asgn_eq_off_emit = x86_local_offset(g, asgn_target_emit.ref);
			if (asgn_eq_off_emit != 0) {
				if (asgn_eq_is_float_emit) {
					x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm0, -", asgn_eq_off_emit, "(%rbp)");
				} else {
					x86_emit_ins_pre_i_suf(&g.em, "movq %rax, -", asgn_eq_off_emit, "(%rbp)");
				};
			} else {
				let static_id_eq = x86_static_find(ctx, asgn_target_emit.ref, g.cur_fn);
				if (asgn_eq_is_float_emit) {
					emit_s(&g.em, "\tmovsd %xmm0, ");
				} else {
					emit_s(&g.em, "\tmovq %rax, ");
				};
				if (static_id_eq != 0) {
					x86_emit_label_ref(&g.em, static_id_eq);
					emit_s(&g.em, "(%rip)");
					e_nl(&g.em);
				} else {
					let glob_ptr_eq = dict_get_bref(&g.globals, asgn_target_emit.ref);
					if (glob_ptr_eq == 0) {
						err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "unknown global in assignment");
					};
					e_prefixed_id(g, asgn_target_emit.ref);
					emit_s(&g.em, "(%rip)");
					e_nl(&g.em);
				};
			};
			return;
		};
		x86_eval(ctx, asgn_target_emit, true);
		x86_emit_ins(&g.em, "pushq %rax");
		let asgn_lval_ty_opt_emit = get_expr_type(g, asgn_target_emit);
		let asgn_lval_is_float_emit = x86_eval_with_expected(ctx, asgn_value_emit, asgn_lval_ty_opt_emit);
		x86_emit_ins(&g.em, "popq %rcx");
		if (asgn_lval_ty_opt_emit != null) {
			x86_store_to_addr(ctx, unwrap(asgn_lval_ty_opt_emit), "%rcx", asgn_lval_is_float_emit);
		} else {
			x86_store_to_addr(ctx, t_new(g.t, N_T_PRIM), "%rcx", asgn_lval_is_float_emit);
		};
		return;
	};
	if (asgn_target_emit.kind != N_ID) {
		let asgn_ty_opt2 = get_expr_type(g, asgn_target_emit);
		if (asgn_ty_opt2 != null) {
			x86_eval(ctx, asgn_target_emit, true);
			x86_emit_ins(&g.em, "movq %rax, %r11");
			let lhs_is_float = x86_load_from_addr(ctx, unwrap(asgn_ty_opt2));
			let lhs_is_f32 = false;
			if (lhs_is_float && x86_type_prim_size(g, unwrap(asgn_ty_opt2)) == 4) { lhs_is_f32 = true; };
			x86_push_result(ctx, lhs_is_float, lhs_is_f32);
			x86_eval_with_expected(ctx, asgn_value_emit, asgn_ty_opt2);
			if (lhs_is_float) {
				x86_pop_to(ctx, true, lhs_is_f32, "");
				if (asgn_op_emit == TK_PLUS_EQ) {
					if (lhs_is_f32) { x86_emit_ins(&g.em, "addss %xmm1, %xmm0"); }
					else { x86_emit_ins(&g.em, "addsd %xmm1, %xmm0"); };
				}
				else if (asgn_op_emit == TK_MINUS_EQ) {
					if (lhs_is_f32) { x86_emit_ins(&g.em, "subss %xmm0, %xmm1"); }
					else { x86_emit_ins(&g.em, "subsd %xmm0, %xmm1"); };
					if (lhs_is_f32) { x86_emit_ins(&g.em, "movaps %xmm1, %xmm0"); }
					else { x86_emit_ins(&g.em, "movapd %xmm1, %xmm0"); };
				} else if (asgn_op_emit == TK_STAR_EQ) {
					if (lhs_is_f32) { x86_emit_ins(&g.em, "mulss %xmm1, %xmm0"); }
					else { x86_emit_ins(&g.em, "mulsd %xmm1, %xmm0"); };
				}
				else if (asgn_op_emit == TK_SLASH_EQ) {
					if (lhs_is_f32) { x86_emit_ins(&g.em, "divss %xmm0, %xmm1"); }
					else { x86_emit_ins(&g.em, "divsd %xmm0, %xmm1"); };
					if (lhs_is_f32) { x86_emit_ins(&g.em, "movaps %xmm1, %xmm0"); }
					else { x86_emit_ins(&g.em, "movapd %xmm1, %xmm0"); };
				};
				x86_store_to_addr(ctx, unwrap(asgn_ty_opt2), "%r11", true);
			} else {
				x86_pop_to(ctx, false, false, "popq %rcx");
				if (asgn_op_emit == TK_PLUS_EQ) { x86_emit_ins(&g.em, "addq %rcx, %rax"); }
				else if (asgn_op_emit == TK_MINUS_EQ) {
					x86_emit_ins(&g.em, "subq %rax, %rcx");
					x86_emit_ins(&g.em, "movq %rcx, %rax");
				}
				else if (asgn_op_emit == TK_STAR_EQ) { x86_emit_ins(&g.em, "imulq %rcx, %rax"); }
				else if (asgn_op_emit == TK_SLASH_EQ || asgn_op_emit == TK_PERCENT_EQ) {
					x86_emit_ins(&g.em, "movq %rax, %r8");
					x86_emit_ins(&g.em, "movq %rcx, %rax");
					x86_emit_ins(&g.em, "cqo");
					x86_emit_ins(&g.em, "idivq %r8");
					if (asgn_op_emit == TK_PERCENT_EQ) { x86_emit_ins(&g.em, "movq %rdx, %rax"); };
				} else if (asgn_op_emit == TK_AMP_EQ) { x86_emit_ins(&g.em, "andq %rcx, %rax"); }
				else if (asgn_op_emit == TK_PIPE_EQ) { x86_emit_ins(&g.em, "orq %rcx, %rax"); }
				else if (asgn_op_emit == TK_CARET_EQ) { x86_emit_ins(&g.em, "xorq %rcx, %rax"); }
				else if (asgn_op_emit == TK_SHL_EQ || asgn_op_emit == TK_SHR_EQ) {
					x86_emit_ins(&g.em, "movq %rcx, %rdx");
					x86_emit_ins(&g.em, "movb %al, %cl");
					if (asgn_op_emit == TK_SHL_EQ) { x86_emit_ins(&g.em, "shlq %cl, %rdx"); }
					else { x86_emit_ins(&g.em, "shrq %cl, %rdx"); };
					x86_emit_ins(&g.em, "movq %rdx, %rax");
				};
				x86_store_to_addr(ctx, unwrap(asgn_ty_opt2), "%r11", false);
			};
			return;
		};
		err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "only simple assignments supported in x86_64 backend");
	};
	let asgn_compound_off_emit = x86_local_offset(g, asgn_target_emit.ref);
	let compound_static_id = 0i64;
	if (asgn_compound_off_emit == 0) {
		compound_static_id = x86_static_find(ctx, asgn_target_emit.ref, g.cur_fn);
		if (compound_static_id == 0) {
			let glob_ptr_compound = dict_get_bref(&g.globals, asgn_target_emit.ref);
			if (glob_ptr_compound == 0) {
				err_bref(asgn_target_emit.ref, g.t.src, g.t.src_len, "unknown local in assignment");
			};
		};
	};
	if (asgn_compound_off_emit != 0) {
		x86_emit_ins_pre_i_suf(&g.em, "movq -", asgn_compound_off_emit, "(%rbp), %rax");
	} else {
		emit_s(&g.em, "\tmovq ");
		if (compound_static_id != 0) { x86_emit_label_ref(&g.em, compound_static_id); }
		else { e_prefixed_id(g, asgn_target_emit.ref); };
		emit_s(&g.em, "(%rip), %rax");
		e_nl(&g.em);
	};
	x86_push_result(ctx, false, false);
	x86_eval(ctx, asgn_value_emit, false);
	x86_pop_to(ctx, false, false, "popq %rcx");
	if (asgn_op_emit == TK_PLUS_EQ) { x86_emit_ins(&g.em, "addq %rcx, %rax"); }
	else if (asgn_op_emit == TK_MINUS_EQ) {
		x86_emit_ins(&g.em, "subq %rax, %rcx");
		x86_emit_ins(&g.em, "movq %rcx, %rax");
	}
	else if (asgn_op_emit == TK_STAR_EQ) { x86_emit_ins(&g.em, "imulq %rcx, %rax"); }
	else if (asgn_op_emit == TK_SLASH_EQ || asgn_op_emit == TK_PERCENT_EQ) {
		x86_emit_ins(&g.em, "movq %rax, %r8");
		x86_emit_ins(&g.em, "movq %rcx, %rax");
		x86_emit_ins(&g.em, "cqo");
		x86_emit_ins(&g.em, "idivq %r8");
		if (asgn_op_emit == TK_PERCENT_EQ) { x86_emit_ins(&g.em, "movq %rdx, %rax"); };
	} else if (asgn_op_emit == TK_AMP_EQ) { x86_emit_ins(&g.em, "andq %rcx, %rax"); }
	else if (asgn_op_emit == TK_PIPE_EQ) { x86_emit_ins(&g.em, "orq %rcx, %rax"); }
	else if (asgn_op_emit == TK_CARET_EQ) { x86_emit_ins(&g.em, "xorq %rcx, %rax"); }
	else if (asgn_op_emit == TK_SHL_EQ || asgn_op_emit == TK_SHR_EQ) {
		x86_emit_ins(&g.em, "movq %rcx, %rdx");
		x86_emit_ins(&g.em, "movb %al, %cl");
		if (asgn_op_emit == TK_SHL_EQ) { x86_emit_ins(&g.em, "shlq %cl, %rdx"); }
		else { x86_emit_ins(&g.em, "shrq %cl, %rdx"); };
		x86_emit_ins(&g.em, "movq %rdx, %rax");
	};
	if (asgn_compound_off_emit != 0) {
		x86_emit_ins_pre_i_suf(&g.em, "movq %rax, -", asgn_compound_off_emit, "(%rbp)");
	} else {
		emit_s(&g.em, "\tmovq %rax, ");
		if (compound_static_id != 0) { x86_emit_label_ref(&g.em, compound_static_id); }
		else { e_prefixed_id(g, asgn_target_emit.ref); };
		emit_s(&g.em, "(%rip)");
		e_nl(&g.em);
	};
};

fn x86_emit_abort_stmt(ctx: *x86_ctx, n: *tnode) void = {
	x86_emit_abort_fixed_ref(ctx, n.ref);
};

fn x86_emit_assert_stmt(ctx: *x86_ctx, n: *tnode) void = {
	let g = ctx.g;
	let assert_cond = t_first_nn(n);
	x86_eval(ctx, assert_cond, false);
	x86_emit_ins(&g.em, "cmpq $0, %rax");
	let ok_label = x86_new_label(ctx);
	x86_emit_jmp(&g.em, "jne", ok_label);
	x86_emit_abort_fixed_ref(ctx, n.ref);
	x86_emit_label(&g.em, ok_label);
};

// ============================================================================
// Statement emission (iterative state machine)
// ============================================================================

fn x86_stmt(ctx: *x86_ctx, root: *tnode) void = {
	let g = ctx.g;
	let stack: [256]x86_stmt_frame = [x86_stmt_frame {
		node = null,
		state = 0,
		label1 = 0,
		label2 = 0,
		label3 = 0,
		node1 = null,
		node2 = null,
		node3 = null,
		case_count = 0,
		case_index = 0,
		case_nodes = [0...],
		case_labels = [0...],
		default_label = 0,
		match_is_nullable = false,
		match_is_tagged = false,
		match_tagged_ty = null,
		match_bind_active = false,
		match_bind_ref = bref_empty(),
		match_bind_saved = 0,
	}...];
	let sp: size = 0;
	let stack_ptr = (&stack[0]): *[*]x86_stmt_frame;
	x86_stmt_push(stack_ptr, &sp, root);
	for (sp > 0) {
		let idx = sp - 1;
		let fr: *x86_stmt_frame = &stack[idx];
		let stmt_node_opt = fr.node;
		if (stmt_node_opt == null) { abort("x86_stmt null node"); };
		let n: *tnode = unwrap(stmt_node_opt);
		let k = n.kind;
		if (fr.state == 99) {
			x86_eval(ctx, n, false);
			sp -= 1;
			continue;
		};
		if (k == N_BLOCK) {
			sp -= 1;
			let blk_nodes: [256]uintptr = [0...];
			let blk_count: size = 0;
			let blk_child = t_first(n);
			for (blk_child != null) {
				if (blk_count < len(blk_nodes)) {
					blk_nodes[blk_count] = blk_child: uintptr;
					blk_count += 1;
				};
				blk_child = unwrap(blk_child).next;
			};
			let blk_i = blk_count;
			for (blk_i > 0) {
				blk_i -= 1;
