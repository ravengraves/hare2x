									x86_emit_ins(&g.em, "xorl %eax, %eax");
									last_is_float = false;
									sp -= 1;
									continue;
								};
							case null => void;
							};
						};
					};
					err_bref(n.ref, g.t.src, g.t.src_len, "unknown identifier in x86_64 backend");
				};
				if (k == N_UN) {
					let un_op_eval = n.ival: u16;
					let un_inner_eval = t_first_nn(n);
					fr.state = 1;
					if (un_op_eval == TK_AMP) {
