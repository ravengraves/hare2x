							x86_eval_push(stack_ptr, &sp, len_expr, false);
							continue;
						};
						if (len_ty.kind == N_T_PTR) {
							let inner_opt = t_first(len_ty);
							if (inner_opt != null) {
								let inner_ty: *tnode = unwrap(inner_opt);
								let inner_res = resolve_alias_type(g, inner_ty);
								if (inner_res != null) { inner_ty = unwrap(inner_res); };
								if (inner_ty.kind == N_T_SLICE || type_is_str(inner_ty, g.t.src)) {
