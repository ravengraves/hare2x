								err_bref(call_fn_eval.ref, g.t.src, g.t.src_len, "too many call args for x86_64 scratch slots");
							};
							let call_arg_node_eval2: *tnode = unwrap(call_arg_iter_eval);
							fr.arg_nodes[fr.arg_count: size] = call_arg_node_eval2: uintptr;
							let param_ty_ptr2: uintptr = 0;
							if (param_iter != null && unwrap(param_iter).kind == N_PARAM) {
								let pty2 = t_first(unwrap(param_iter));
								if (pty2 != null) { param_ty_ptr2 = unwrap(pty2): uintptr; };
								param_iter = unwrap(param_iter).next;
							};
							fr.arg_expected[fr.arg_count: size] = param_ty_ptr2;
							fr.arg_count += 1;
							call_arg_iter_eval = call_arg_node_eval2.next;
						};
					};
					fr.scratch_next = 0;
					let arg_i: size = 0;
					for (arg_i < fr.arg_count: size) {
						let arg_node_eval3: *tnode = fr.arg_nodes[arg_i]: *tnode;
						let kind: u8 = X86_ARG_INT;
						let expected_ptr = fr.arg_expected[arg_i];
						if (expected_ptr != 0) {
