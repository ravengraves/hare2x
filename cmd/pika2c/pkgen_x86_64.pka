							err_bref(call_fn_eval.ref, g.t.src, g.t.src_len, "call args exceed scratch space");
						};
						arg_i += 1;
					};
					fr.call_scratch_base = ctx.call_scratch_base + (ctx.call_scratch_depth * ctx.call_scratch_stride);
					ctx.call_scratch_depth += 1;
					if (ctx.call_scratch_depth > ctx.call_scratch_slots) {
