					};
					continue;
				};
				if (k == N_CAST) {
					let cast_inner_eval = t_first_nn(n);
					let cast_ty_eval = t_next_nn(cast_inner_eval);
					if (x86_type_is_tagged(g, cast_ty_eval)) {
						last_is_float = x86_emit_tagged_wrap(ctx, cast_ty_eval, cast_inner_eval);
						sp -= 1;
						continue;
					};
					fr.cast_from_tagged = false;
					fr.cast_payload_ty = null;
					let cast_src_ty_opt = get_expr_type(g, cast_inner_eval);
					if (cast_src_ty_opt != null && x86_type_is_tagged(g, unwrap(cast_src_ty_opt))) {
						fr.cast_from_tagged = true;
						fr.cast_payload_ty = cast_ty_eval;
						fr.state = 1;
						x86_eval_push(stack_ptr, &sp, cast_inner_eval, false);
						continue;
					};
					fr.target_is_float = x86_is_float_ty(g, cast_ty_eval);
					fr.state = 1;
					x86_eval_push(stack_ptr, &sp, cast_inner_eval, false);
					continue;
				};
				if (k == N_BIN) {
					let bin_lhs_eval = t_first_nn(n);
					let bin_rhs_eval = t_next_nn(bin_lhs_eval);
					fr.use_float = x86_expr_is_float(g, bin_lhs_eval) || x86_expr_is_float(g, bin_rhs_eval);
					fr.float_is_f32 = false;
					if (fr.use_float) {
						let lhs_ty_opt_f32 = get_expr_type(g, bin_lhs_eval);
						if (lhs_ty_opt_f32 != null) {
							let lhs_ty = unwrap(lhs_ty_opt_f32);
							if (x86_is_float_ty(g, lhs_ty) && x86_type_prim_size(g, lhs_ty) == 4) { fr.float_is_f32 = true; };
						};
						let rhs_ty_opt_f32 = get_expr_type(g, bin_rhs_eval);
						if (rhs_ty_opt_f32 != null) {
							let rhs_ty = unwrap(rhs_ty_opt_f32);
							if (x86_is_float_ty(g, rhs_ty) && x86_type_prim_size(g, rhs_ty) == 4) { fr.float_is_f32 = true; };
						};
					};
					fr.state = 1;
					x86_eval_push(stack_ptr, &sp, bin_lhs_eval, false);
					continue;
				};
				if (k == N_IDX) {
					x86_idx_setup(g, fr, n);
					fr.state = 1;
					let idx_base_eval = t_first_nn(n);
					x86_eval_push(stack_ptr, &sp, idx_base_eval, false);
					continue;
				};
				if (k == N_SLICE) {
					let slice_arr = t_first_nn(n);
					let slice_start = slice_arr.next;
					let slice_end_opt: nullable *tnode = null;
					if (slice_start != null) { slice_end_opt = unwrap(slice_start).next; };
					let arr_ty_opt = get_expr_type(g, slice_arr);
					if (arr_ty_opt == null) { err_bref(n.ref, g.t.src, g.t.src_len, "cannot slice unknown type"); };
					let arr_ty: *tnode = unwrap(arr_ty_opt);
					let arr_res = resolve_alias_type(g, arr_ty);
					if (arr_res != null) { arr_ty = unwrap(arr_res); };
					let is_ptr = false;
					if (arr_ty.kind == N_T_PTR) {
						is_ptr = true;
						arr_ty = t_first_nn(arr_ty);
						let arr_inner_res = resolve_alias_type(g, arr_ty);
						if (arr_inner_res != null) { arr_ty = unwrap(arr_inner_res); };
					};
					if (arr_ty.kind == N_T_SLICE) {
						fr.slice_kind = X86_SLICE_SLICE;
					} else if (arr_ty.kind == N_T_UARR) {
						fr.slice_kind = X86_SLICE_UARR;
					} else if (arr_ty.kind == N_T_ARR) {
						fr.slice_kind = X86_SLICE_ARRAY;
						let base_len: i64 = 0;
						if (!arr_size_literal(arr_ty, g.t.src, &base_len)) {
							err_bref(n.ref, g.t.src, g.t.src_len, "invalid array size in slice");
						};
						fr.slice_base_len = base_len;
					} else {
						err_bref(n.ref, g.t.src, g.t.src_len, "invalid slice base");
					};
					if (fr.slice_kind == X86_SLICE_UARR && (!is_ptr)) {
						err_bref(n.ref, g.t.src, g.t.src_len, "unbounded slice requires pointer base");
					};
					if (fr.slice_kind == X86_SLICE_UARR && slice_end_opt == null) {
