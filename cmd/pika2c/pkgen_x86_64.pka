			};
			if (fr.state == 2) {
				if (fr.match_bind_active) {
					if (fr.match_bind_saved == 0) { dict_remove_bref(&g.vars, fr.match_bind_ref); }
					else { dict_set_bref(&g.vars, fr.match_bind_ref, fr.match_bind_saved); };
					fr.match_bind_active = false;
				};
				x86_emit_jmp(&g.em, "jmp", fr.label1);
				fr.state = 1;
				continue;
			};
		};
		if (k == N_BREAK) {
			if (ctx.loop_depth == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "break outside loop"); };
			let break_lbl_eval = ctx.break_labels[ctx.loop_depth - 1];
			x86_emit_jmp(&g.em, "jmp", break_lbl_eval);
			sp -= 1;
			continue;
		};
		if (k == N_CONTINUE) {
			if (ctx.loop_depth == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "continue outside loop"); };
			let cont_lbl_eval = ctx.continue_labels[ctx.loop_depth - 1];
			x86_emit_jmp(&g.em, "jmp", cont_lbl_eval);
			sp -= 1;
			continue;
		};
		if (k == N_ABORT) {
			x86_emit_abort_stmt(ctx, n);
			sp -= 1;
			continue;
		};
		if (k == N_ASSERT) {
			x86_emit_assert_stmt(ctx, n);
			sp -= 1;
			continue;
		};
		err_bref(n.ref, g.t.src, g.t.src_len, "unsupported statement in x86_64 backend");
	};
};

// ============================================================================
// Function emission
// ============================================================================

fn x86_fn_name(g: *codegen, n: *tnode) void = {
	if ((n.flags & F_SYMBOL) != 0) {
		let sym: *tnode = t_first_nn(n);
		let r: bref = sym.ref;
		if (r.length > 2) {
			let inner = bref { pos = r.pos + 1, length = r.length - 2 };
			e_bref(&g.em, inner);
			return;
		};
	};
	if (is_pika_main(g, n)) {
		emit_s(&g.em, "_main");
		return;
	};
	e_prefixed_id(g, n.ref);
};

fn x86_emit_fn(ctx: *x86_ctx, n: *tnode) void = {
	if ((n.flags & F_EXTERN) != 0) { return; };
	let g = ctx.g;
	g.cur_fn = n.ref;
	vars_clear(g);
	dict_clear(&g.static_vars);
	ctx.temp_depth = 0;
	ctx.loop_depth = 0;
	ctx.ret_label = x86_new_label(ctx);
	ctx.call_scratch_depth = 0;
	let save_rbx_off: i64 = 0;
	let save_r12_off: i64 = 0;
	let save_r13_off: i64 = 0;
	let save_r14_off: i64 = 0;
	let save_r15_off: i64 = 0;

	// Assign stack slots for params + locals
	let next_off: i64 = 0;
	// Reserve callee-saved register slots (rbx, r12-r15)
	save_rbx_off = x86_alloc_temp(&next_off, 8);
	save_r12_off = x86_alloc_temp(&next_off, 8);
	save_r13_off = x86_alloc_temp(&next_off, 8);
	save_r14_off = x86_alloc_temp(&next_off, 8);
	save_r15_off = x86_alloc_temp(&next_off, 8);
	let param = g_skip_symbol(n);
	for (param != null && unwrap(param).kind == N_PARAM) {
		let param_node_init: *tnode = unwrap(param);
		let param_type_init: *tnode = t_first_nn(param_node_init);
		vars_register(g, param_node_init.ref, param_type_init: uintptr: u64);
		let param_size_init = x86_type_slot_size(g, param_type_init);
		x86_alloc_local(g, param_node_init.ref, param_size_init, &next_off);
		param = param_node_init.next;
	};
	let ret_type = g_skip_to_ret(n);
	ctx.ret_ty = null;
	if (ret_type != null) { ctx.ret_ty = unwrap(ret_type); };
	let body: *tnode = t_new(g.t, N_BLOCK);
	if (ret_type != null) { body = t_next_nn(unwrap(ret_type)); };
	// Pre-scan locals
	x86_collect_locals_stmt(g, body, &next_off);
	// Reserve sret pointer slot if needed (slice return)
	let ret_is_slice = false;
	let ret_is_tagged = false;
	if (ret_type != null && x86_type_is_slice(g, unwrap(ret_type))) { ret_is_slice = true; };
	if (ret_type != null && x86_type_is_tagged(g, unwrap(ret_type))) { ret_is_tagged = true; };
	ctx.sret_off = 0;
	if (ret_is_slice || ret_is_tagged) {
		ctx.sret_off = x86_alloc_temp(&next_off, 8);
	};
	// Reserve scratch slots for call args and struct temps (rbp-relative)
	ctx.call_scratch_base = next_off + 8;
	ctx.call_scratch_stride = 32 * 8;
	ctx.call_scratch_slots = 8;
	ctx.call_scratch_depth = 0;
	ctx.struct_scratch_base = ctx.call_scratch_base + (ctx.call_scratch_stride * ctx.call_scratch_slots);
	ctx.struct_scratch_slots = 32;
	ctx.struct_scratch_stride = 24;
	ctx.struct_scratch_next = 0;
	ctx.stack_size = ctx.struct_scratch_base + (32 * 24);
	// Decide whether to emit via IR and reserve spill slots if needed.
	let use_ir = false;
	let ir_func_ptr: nullable *ir_func = null;
	if (ctx.ir != null) {
		x86_set_sched_by_name(ctx, n.ref);
		let f_ir_ptr: *ir_func = &ctx.ir.funcs[ctx.fn_index];
		ir_func_ptr = f_ir_ptr;
		if (x86_ir_supported_func(ctx, f_ir_ptr)) {
			use_ir = true;
		};
	};
	if (use_ir) {
		match (ir_func_ptr) {
		case let f_emit: *ir_func => x86_ir_setup_spills(ctx, f_emit);
		case null => void;
		};
	};
	// Align stack size so (%rsp) stays 16-byte aligned after push %rbp.
	let rem_align = ctx.stack_size & 15;
	if (rem_align != 0) { ctx.stack_size += 16 - rem_align; };

	// Emit function label
	if ((n.flags & F_EXPORTED) != 0) {
		emit_s(&g.em, ".globl ");
		x86_fn_name(g, n);
		e_nl(&g.em);
	};
	emit_s(&g.em, ".type ");
	x86_fn_name(g, n);
	emit_s(&g.em, ", @function");
	e_nl(&g.em);
	x86_fn_name(g, n);
	e_c(&g.em, ':');
	e_nl(&g.em);
	if (X86_SCHED_DEBUG != 0) {
		if (use_ir) {
			emit_s(&g.em, "# ir=1\n");
		} else {
			emit_s(&g.em, "# ir=0");
			if (ir_func_ptr != null) {
				match (ir_func_ptr) {
				case let f_dbg: *ir_func =>
					emit_s(&g.em, " supported=");
					if (f_dbg.supported) { e_i(&g.em, 1); }
					else { e_i(&g.em, 0); };
				case null => void;
				};
			};
			if (ctx.ir != null) {
				emit_s(&g.em, " ir_unsupported=");
				e_i(&g.em, ctx.ir.unsupported_count: i64);
				emit_s(&g.em, " ir_last_op=");
				e_i(&g.em, ctx.ir.unsupported_op: i64);
				emit_s(&g.em, " ir_reason=");
				e_i(&g.em, ctx.ir.unsupported_reason: i64);
				if (ctx.ir.unsupported_op < ctx.ir.op_count) {
					let dbg_op = ctx.ir.ops[ctx.ir.unsupported_op];
					emit_s(&g.em, " ir_last_kind=");
					e_i(&g.em, dbg_op.kind: i64);
				};
				let bin_count = 0z;
				let op_i = 0z;
				if (ir_func_ptr != null) {
					match (ir_func_ptr) {
					case let f_dbg: *ir_func =>
						for (op_i < f_dbg.ops_len) {
							let op_dbg = ctx.ir.ops[f_dbg.ops_start + op_i];
							if (op_dbg.kind == IR_OP_BIN) { bin_count += 1; };
							op_i += 1;
						};
					case null => void;
					};
				};
				emit_s(&g.em, " ir_bin_count=");
				e_i(&g.em, bin_count: i64);
			};
			emit_s(&g.em, "\n");
		};
	};
	if (X86_VEC_DEBUG != 0) {
		x86_emit_vec_debug(ctx);
	};
	x86_emit_sched_debug_fn(ctx);
	// Prologue
	x86_emit_ins(&g.em, "pushq %rbp");
	x86_emit_ins(&g.em, "movq %rsp, %rbp");
	if (ctx.stack_size > 0) {
		x86_emit_ins_pre_i_suf(&g.em, "subq $", ctx.stack_size, ", %rsp");
	};
	// Save callee-saved registers into stack slots
	x86_emit_ins_pre_i_suf(&g.em, "movq %rbx, -", save_rbx_off, "(%rbp)");
	x86_emit_ins_pre_i_suf(&g.em, "movq %r12, -", save_r12_off, "(%rbp)");
	x86_emit_ins_pre_i_suf(&g.em, "movq %r13, -", save_r13_off, "(%rbp)");
	x86_emit_ins_pre_i_suf(&g.em, "movq %r14, -", save_r14_off, "(%rbp)");
	x86_emit_ins_pre_i_suf(&g.em, "movq %r15, -", save_r15_off, "(%rbp)");

	// Move params into stack slots
	param = g_skip_symbol(n);
	let int_idx: i64 = 0;
	let float_idx: i64 = 0;
	let stack_off: i64 = 16;
	if (ctx.sret_off != 0) {
		x86_emit_ins_pre_i_suf(&g.em, "movq %rdi, -", ctx.sret_off, "(%rbp)");
		int_idx = 1;
	};
	for (param != null && unwrap(param).kind == N_PARAM) {
		let param_node_move: *tnode = unwrap(param);
		let param_type_move: *tnode = t_first_nn(param_node_move);
		let param_off_move = x86_local_offset(g, param_node_move.ref);
		if (x86_type_is_slice(g, param_type_move)) {
			emit_s(&g.em, "\tmovq ");
			e_i(&g.em, stack_off);
			emit_s(&g.em, "(%rbp), %r10");
			e_nl(&g.em);
			x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move, "(%rbp)");
			emit_s(&g.em, "\tmovq ");
			e_i(&g.em, stack_off + 8);
			emit_s(&g.em, "(%rbp), %r10");
			e_nl(&g.em);
			x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move - 8, "(%rbp)");
			emit_s(&g.em, "\tmovq ");
			e_i(&g.em, stack_off + 16);
			emit_s(&g.em, "(%rbp), %r10");
			e_nl(&g.em);
			x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move - 16, "(%rbp)");
			stack_off += 24;
		} else if (x86_type_is_str(g, param_type_move)) {
			if (int_idx <= 4) {
				if (int_idx == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdi, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq %rsi, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdx, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq %rcx, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq %r8, -", param_off_move, "(%rbp)"); };
				if (int_idx == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq %rsi, -", param_off_move - 8, "(%rbp)"); }
				else if (int_idx == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdx, -", param_off_move - 8, "(%rbp)"); }
				else if (int_idx == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq %rcx, -", param_off_move - 8, "(%rbp)"); }
				else if (int_idx == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq %r8, -", param_off_move - 8, "(%rbp)"); }
				else if (int_idx == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq %r9, -", param_off_move - 8, "(%rbp)"); };
				int_idx += 2;
			} else {
				emit_s(&g.em, "\tmovq ");
				e_i(&g.em, stack_off);
				emit_s(&g.em, "(%rbp), %r10");
				e_nl(&g.em);
				x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move, "(%rbp)");
				emit_s(&g.em, "\tmovq ");
				e_i(&g.em, stack_off + 8);
				emit_s(&g.em, "(%rbp), %r10");
				e_nl(&g.em);
				x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move - 8, "(%rbp)");
				stack_off += 16;
			};
		} else if (x86_type_is_tagged(g, param_type_move)) {
			let payload_off = param_off_move - 8;
			if (int_idx <= 4) {
				if (int_idx == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdi, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq %rsi, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdx, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq %rcx, -", param_off_move, "(%rbp)"); }
				else if (int_idx == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq %r8, -", param_off_move, "(%rbp)"); };
				if (int_idx == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq %rsi, -", payload_off, "(%rbp)"); }
				else if (int_idx == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdx, -", payload_off, "(%rbp)"); }
				else if (int_idx == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq %rcx, -", payload_off, "(%rbp)"); }
				else if (int_idx == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq %r8, -", payload_off, "(%rbp)"); }
				else if (int_idx == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq %r9, -", payload_off, "(%rbp)"); };
				int_idx += 2;
			} else {
				emit_s(&g.em, "\tmovq ");
				e_i(&g.em, stack_off);
				emit_s(&g.em, "(%rbp), %r10");
				e_nl(&g.em);
				x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move, "(%rbp)");
				emit_s(&g.em, "\tmovq ");
				e_i(&g.em, stack_off + 8);
				emit_s(&g.em, "(%rbp), %r10");
				e_nl(&g.em);
				x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", payload_off, "(%rbp)");
				stack_off += 16;
			};
		} else if (x86_is_float_ty(g, param_type_move)) {
			if (float_idx == 0) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm0, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 1) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm1, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 2) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm2, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 3) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm3, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 4) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm4, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 5) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm5, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 6) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm6, -", param_off_move, "(%rbp)"); }
			else if (float_idx == 7) { x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm7, -", param_off_move, "(%rbp)"); };
			if (float_idx < 8) { float_idx += 1; }
			else {
				emit_s(&g.em, "\tmovsd ");
				e_i(&g.em, stack_off);
				emit_s(&g.em, "(%rbp), %xmm0");
				e_nl(&g.em);
				x86_emit_ins_pre_i_suf(&g.em, "movsd %xmm0, -", param_off_move, "(%rbp)");
				stack_off += 8;
			};
		} else {
			if (int_idx == 0) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdi, -", param_off_move, "(%rbp)"); }
			else if (int_idx == 1) { x86_emit_ins_pre_i_suf(&g.em, "movq %rsi, -", param_off_move, "(%rbp)"); }
			else if (int_idx == 2) { x86_emit_ins_pre_i_suf(&g.em, "movq %rdx, -", param_off_move, "(%rbp)"); }
			else if (int_idx == 3) { x86_emit_ins_pre_i_suf(&g.em, "movq %rcx, -", param_off_move, "(%rbp)"); }
			else if (int_idx == 4) { x86_emit_ins_pre_i_suf(&g.em, "movq %r8, -", param_off_move, "(%rbp)"); }
			else if (int_idx == 5) { x86_emit_ins_pre_i_suf(&g.em, "movq %r9, -", param_off_move, "(%rbp)"); };
			if (int_idx < 6) {
				int_idx += 1;
			} else {
				emit_s(&g.em, "\tmovq ");
				e_i(&g.em, stack_off);
				emit_s(&g.em, "(%rbp), %r10");
				e_nl(&g.em);
				x86_emit_ins_pre_i_suf(&g.em, "movq %r10, -", param_off_move, "(%rbp)");
				stack_off += 8;
			};
		};
		param = param_node_move.next;
	};

	// Emit body
	if (use_ir) {
		match (ir_func_ptr) {
		case let f_emit: *ir_func => x86_emit_ir_body(ctx, f_emit);
		case null => x86_stmt(ctx, body);
		};
	} else {
		x86_stmt(ctx, body);
	};

	// Epilogue
	x86_emit_label(&g.em, ctx.ret_label);
	// Restore callee-saved registers
	x86_emit_ins_pre_i_suf(&g.em, "movq -", save_r15_off, "(%rbp), %r15");
	x86_emit_ins_pre_i_suf(&g.em, "movq -", save_r14_off, "(%rbp), %r14");
	x86_emit_ins_pre_i_suf(&g.em, "movq -", save_r13_off, "(%rbp), %r13");
	x86_emit_ins_pre_i_suf(&g.em, "movq -", save_r12_off, "(%rbp), %r12");
	x86_emit_ins_pre_i_suf(&g.em, "movq -", save_rbx_off, "(%rbp), %rbx");
	if (ctx.stack_size > 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", ctx.stack_size, ", %rsp"); };
	x86_emit_ins(&g.em, "popq %rbp");
	x86_emit_ins(&g.em, "ret");
	e_nl(&g.em);
};

// ============================================================================
// Top-level generation
// ============================================================================

fn x86_collect_globals(g: *codegen, unit: *tnode) void = {
	let decl = t_first(unit);
	for (decl != null) {
		let d: *tnode = unwrap(decl);
		if (d.kind == N_TYPEDEF) {
			let ty: *tnode = t_first_nn(d);
			dict_set_bref(&g.types, d.ref, ty: uintptr: u64);
			if ((d.flags & F_EXPORTED) != 0) {
				dict_set_bref(&g.exported_types, d.ref, 1);
			};
		} else if (d.kind == N_FN) {
			if (dict_has_bref(&g.globals, d.ref)) {
				err_bref(d.ref, g.t.src, g.t.src_len,
					"duplicate function name (pika does not allow shadowing global names)");
			};
			dict_set_bref(&g.globals, d.ref, d: uintptr: u64);
			if ((d.flags & F_SYMBOL) != 0) {
				let sym = t_first_nn(d);
				dict_set_bref(&g.symbols, d.ref, sym: uintptr: u64);
			};
			let ret_type = g_skip_to_ret(d);
			if (ret_type != null) { dict_set_bref(&g.funcs, d.ref, unwrap(ret_type): uintptr: u64); };
			if ((d.flags & F_EXPORTED) != 0 && (d.flags & F_SYMBOL) == 0 && !is_pika_main(g, d)) {
				dict_set_bref(&g.exported_funcs, d.ref, 1);
			};
		} else if (d.kind == N_DEF) {
			if (dict_has_bref(&g.globals, d.ref)) {
				err_bref(d.ref, g.t.src, g.t.src_len,
					"duplicate define name (pika does not allow shadowing global names)");
			};
			dict_set_bref(&g.globals, d.ref, d: uintptr: u64);
		} else if (d.kind == N_GLOBAL) {
			if (dict_has_bref(&g.globals, d.ref)) {
				err_bref(d.ref, g.t.src, g.t.src_len,
					"duplicate global variable name (pika does not allow shadowing global names)");
			};
			dict_set_bref(&g.globals, d.ref, d: uintptr: u64);
		} else if (d.kind == N_USE) {
			register_use_alias(g, d);
		};
		decl = d.next;
	};
};

fn pkgen_generate_x86_64(g: *codegen) void = {
	let unit = t_first(g.t.root);
	if (unit == null) { return; };
	x86_collect_globals(g, unwrap(unit));
	let ir = ir_build_unit(g, unwrap(unit));
	ir_graph_optimize(ir);
	ir_vectorize(ir);
	ir_optimize_vec_packs(ir);
	ir_reindex_vregs(ir);
	virtreg_pack(ir, &virt_ctx_global);
	let ctx = x86_ctx {
		g = g,
		ir = ir,
		virt = &virt_ctx_global,
		fn_index = 0,
		sched = null,
		label_id = 0,
		stack_size = 0,
		temp_depth = 0,
		loop_depth = 0,
		break_labels = [0...],
		continue_labels = [0...],
		ret_label = 0,
		call_scratch_base = 0,
		call_scratch_stride = 0,
		call_scratch_slots = 0,
		call_scratch_depth = 0,
	struct_scratch_base = 0,
	struct_scratch_next = 0,
	struct_scratch_stride = 0,
	struct_scratch_slots = 0,
	ret_ty = null,
	match_expr_depth = 0,
	match_expr_offs = [0...],
	match_expr_labels = [0...],
	match_expr_tys = [0...],
	spill_offsets = [0...],
	spill_count = 0,
	spill_base = 0,
		sret_off = 0,
		static_count = 0,
		static_names = [bref { pos = 0, length = 0 }...],
		static_owner = [bref { pos = 0, length = 0 }...],
		static_label = [0...],
		static_ty = [0...],
		static_init = [0...],
	};
	// Collect static locals before emitting globals.
	let scan = t_first(unwrap(unit));
	for (scan != null) {
		let s: *tnode = unwrap(scan);
		if (s.kind == N_FN && (s.flags & F_EXTERN) == 0) {
			x86_collect_static_locals(&ctx, s);
		};
		scan = s.next;
	};
	// Emit global/static storage, then switch to text.
	x86_emit_globals(&ctx, unwrap(unit));
	emit_s(&g.em, ".text\n");
	let decl = t_first(unwrap(unit));
	let fn_idx: size = 0;
	for (decl != null) {
		let d: *tnode = unwrap(decl);
		if (d.kind == N_FN && (d.flags & F_EXTERN) == 0) {
			x86_set_sched(&ctx, fn_idx);
			x86_emit_fn(&ctx, d);
			fn_idx += 1;
		};
		decl = d.next;
	};
	emit_s(&g.em, ".section .note.GNU-stack,\"\",@progbits\n");
};

// Phase 1 scaffold: IR -> virtreg -> x86_64 (not yet hooked to emitter).
fn pkgen_generate_x86_64_ir(g: *codegen) void = {
	let unit = t_first(g.t.root);
	if (unit == null) { return; };
	let ir = ir_build_unit(g, unwrap(unit));
	ir_graph_optimize(ir);
	ir_vectorize(ir);
	ir_optimize_vec_packs(ir);
	ir_reindex_vregs(ir);
	virtreg_pack(ir, &virt_ctx_global);
	// TODO: emit from IR + virtreg allocations
};
