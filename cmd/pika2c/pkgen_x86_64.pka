						x86_emit_ins(&g.em, "sete %al");
						x86_emit_ins(&g.em, "movzbq %al, %rax");
						last_is_float = false;
						sp -= 1;
						continue;
					};
					if (un_op_eval2 == TK_TILDE) {
						x86_emit_ins(&g.em, "notq %rax");
						last_is_float = false;
						sp -= 1;
						continue;
					};
				};
				if (k == N_CAST) {
					let cast_inner_eval2 = t_first_nn(n);
					let cast_ty_eval2 = t_next_nn(cast_inner_eval2);
					if (fr.cast_from_tagged && fr.cast_payload_ty != null) {
						let payload_ty = unwrap(fr.cast_payload_ty);
						if (x86_is_float_ty(g, payload_ty)) {
							let psz_float = x86_type_prim_size(g, payload_ty);
							if (psz_float == 4) { x86_emit_ins(&g.em, "movss 8(%rax), %xmm0"); }
							else { x86_emit_ins(&g.em, "movsd 8(%rax), %xmm0"); };
							last_is_float = true;
							sp -= 1;
							continue;
						};
						let psz_int = x86_type_prim_size(g, payload_ty);
