// pkgen_x86_64.pka - Pika x86_64 (AT&T) assembly generation (phase 1)

use rt;

// ============================================================================
// x86_64 helper context
// ============================================================================

type x86_ctx = struct {
	g: *codegen,
	ir: *ir_ctx,
	virt: *virt_ctx,
	fn_index: size,
	sched: nullable *virt_func_sched,
	label_id: i64,
	stack_size: i64,
	temp_depth: i64,
	loop_depth: size,
	break_labels: [64]i64,
	continue_labels: [64]i64,
	ret_label: i64,
	call_scratch_base: i64,
	call_scratch_stride: i64,
	call_scratch_slots: i64,
	call_scratch_depth: i64,
	struct_scratch_base: i64,
	struct_scratch_next: i64,
	struct_scratch_stride: i64,
	struct_scratch_slots: i64,
	ret_ty: nullable *tnode,
	match_expr_depth: size,
	match_expr_offs: [32]i64,
	match_expr_labels: [32]i64,
	match_expr_tys: [32]uintptr,
	spill_offsets: [8192]i64,
	spill_count: size,
	spill_base: i64,
	sret_off: i64,
	static_count: size,
	static_names: [256]bref,
	static_owner: [256]bref,
	static_label: [256]i64,
	static_ty: [256]uintptr,
	static_init: [256]uintptr,
};

type x86_eval_frame = struct {
	node: nullable *tnode,
	state: u8,
	want_addr: bool,
	use_float: bool,
	float_is_f32: bool,
	lhs_is_float: bool,
	rhs_is_float: bool,
	target_is_float: bool,
	cast_from_tagged: bool,
	cast_payload_ty: nullable *tnode,
	base_is_ptr: bool,
	field_deref: u8,
	field_off: i64,
	field_ty: nullable *tnode,
	init_node: nullable *tnode,
	arg_count: u8,
	arg_index: u8,
	arg_nodes: [16]uintptr,
	arg_is_float: [16]bool,
	arg_kind: [16]u8,
	arg_slots: [16]u8,
	arg_scratch: [16]u8,
	arg_expected: [16]uintptr,
	scratch_next: u8,
	call_scratch_base: i64,
	idx_is_slice: bool,
	idx_is_ptr_slice: bool,
	idx_is_ptr_uarr: bool,
	idx_deref: u8,
	idx_elem_size: i64,
	idx_elem_ty: nullable *tnode,
	slice_kind: u8,
	slice_elem_ty: nullable *tnode,
	slice_base_len: i64,
};

type x86_stmt_frame = struct {
	node: nullable *tnode,
	state: u8,
	label1: i64,
	label2: i64,
	label3: i64,
	node1: nullable *tnode,
	node2: nullable *tnode,
	node3: nullable *tnode,
	case_count: u8,
	case_index: u8,
	case_nodes: [128]uintptr,
	case_labels: [128]i64,
	default_label: i64,
	match_is_nullable: bool,
	match_is_tagged: bool,
	match_tagged_ty: nullable *tnode,
	match_bind_active: bool,
	match_bind_ref: bref,
	match_bind_saved: u64,
};

// Register name tables (phase 2 scaffolding; emission mapping in phase 3).
let X86_GPR64_NAMES: [16]str = [
	"rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp",
	"r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
];
let X86_GPR32_NAMES: [16]str = [
	"eax", "ebx", "ecx", "edx", "esi", "edi", "ebp", "esp",
	"r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d",
];
let X86_GPR16_NAMES: [16]str = [
	"ax", "bx", "cx", "dx", "si", "di", "bp", "sp",
	"r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w",
];
let X86_GPR8_NAMES: [16]str = [
	"al", "bl", "cl", "dl", "sil", "dil", "bpl", "spl",
	"r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b",
];
let X86_XMM_NAMES: [16]str = [
	"xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7",
	"xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15",
];

def X86_SCHED_DEBUG: u8 = 0;
def X86_SCRATCH_GPR0: u8 = 10; // r10
def X86_SCRATCH_GPR1: u8 = 11; // r11
def X86_SCRATCH_GPR_DIV: u8 = 0; // rax
def X86_SCRATCH_GPR_DIVHI: u8 = 3; // rdx
def X86_SCRATCH_GPR_CNT: u8 = 2; // rcx
def X86_VEC_DEBUG: u8 = 0;
def X86_SCRATCH_XMM: u8 = 15; // xmm15
def X86_ARG_INT: u8 = 0;
def X86_ARG_FLOAT: u8 = 1;
def X86_ARG_STR: u8 = 2;
def X86_ARG_SLICE: u8 = 3;
def X86_ARG_TAGGED: u8 = 4;
def X86_SLICE_ARRAY: u8 = 1;
def X86_SLICE_SLICE: u8 = 2;
def X86_SLICE_UARR: u8 = 3;

fn x86_gpr_name(idx: u8, bits: u8) str = {
	if (idx >= 16) { return "rax"; };
	if (bits == 8) { return X86_GPR8_NAMES[idx]; };
	if (bits == 16) { return X86_GPR16_NAMES[idx]; };
	if (bits == 32) { return X86_GPR32_NAMES[idx]; };
	return X86_GPR64_NAMES[idx];
};

fn x86_xmm_name(idx: u8) str = {
	if (idx >= 16) { return "xmm0"; };
	return X86_XMM_NAMES[idx];
};

fn x86_set_sched(ctx: *x86_ctx, idx: size) void = {
	ctx.fn_index = idx;
	if (ctx.virt == null) { ctx.sched = null; return; };
	if (idx >= 256) { ctx.sched = null; return; };
	ctx.sched = &ctx.virt.func_sched[idx];
};

fn x86_set_sched_by_name(ctx: *x86_ctx, name: bref) void = {
	if (ctx.ir == null || ctx.virt == null) { ctx.sched = null; return; };
	let i = 0z;
	for (i < ctx.ir.func_count) {
		let f = ctx.ir.funcs[i];
		if (bref_eq(f.name, name, ctx.g.t.src)) {
			ctx.fn_index = i;
			ctx.sched = &ctx.virt.func_sched[i];
			return;
		};
		i += 1;
	};
	ctx.sched = null;
};

fn x86_emit_sched_debug_fn(ctx: *x86_ctx) void = {
	if (X86_SCHED_DEBUG == 0) { return; };
	if (ctx.virt == null || ctx.sched == null) { return; };
	let g = ctx.g;
	match (ctx.sched) {
	case let sched: *virt_func_sched =>
		let w = 0z;
		for (w < sched.window_count) {
			let win = ctx.virt.windows[sched.window_start + w];
			emit_s(&g.em, "# sched f=");
			e_i(&g.em, ctx.fn_index: i64);
			emit_s(&g.em, " win=");
			e_i(&g.em, w: i64);
			emit_s(&g.em, " line=");
			e_i(&g.em, win.op_start: i64);
			emit_s(&g.em, " score=");
			e_i(&g.em, win.score);
			e_nl(&g.em);
			let j = 0z;
			emit_s(&g.em, "# order");
			for (j < win.op_count) {
				let ord_idx = ctx.virt.order[win.op_start + j];
				let op = ctx.virt.ops[ord_idx: size];
				emit_s(&g.em, " ");
				e_i(&g.em, op.op_index: i64);
				emit_s(&g.em, ":");
				e_i(&g.em, op.kind: i64);
				j += 1;
			};
			e_nl(&g.em);
			w += 1;
		};
	case null => void;
	};
};

fn x86_ir_find_alloc(ctx: *x86_ctx, vreg_id: u32) phys_reg = {
	if (ctx.virt == null || ctx.sched == null) {
		return phys_reg { class = 0, index = 0, lane = 0 };
	};
	match (ctx.sched) {
	case let sched: *virt_func_sched =>
		let start = sched.alloc_start;
		let count = sched.alloc_count;
		let i = 0z;
		for (i < count) {
			let a = ctx.virt.allocs[start + i];
			if (a.vreg_id == vreg_id) { return a.phys; };
			i += 1;
		};
	case null => void;
	};
	return phys_reg { class = 0, index = 0, lane = 0 };
};

fn x86_ir_reg_name(phys: phys_reg) str = {
	if (phys.class == REG_XMM_SCALAR_F32 || phys.class == REG_XMM_SCALAR_F64
		|| phys.class == REG_XMM_VEC4_I32 || phys.class == REG_XMM_VEC2_I64
		|| phys.class == REG_XMM_VEC4_F32 || phys.class == REG_XMM_VEC2_F64) {
		return x86_xmm_name(phys.index);
	};
	return x86_gpr_name(phys.index, 64);
};

fn x86_ir_label_id(ctx: *x86_ctx, label_map: *[*]i64, label_cap: size, ir_id: u32) i64 = {
	let idx = ir_id: size;
	if (idx >= label_cap) { return x86_new_label(ctx); };
	if (label_map[idx] == 0) { label_map[idx] = x86_new_label(ctx); };
	return label_map[idx];
};

fn x86_ir_same_reg(a: phys_reg, b: phys_reg) bool = {
	return a.class == b.class && a.index == b.index && a.lane == b.lane;
};

fn x86_ir_emit_cmp_zero(em: *emitter, reg: str) void = {
	emit_s(em, "\tcmpq $0, %");
	emit_s(em, reg);
	e_nl(em);
};

fn x86_emit_vec_debug(ctx: *x86_ctx) void = {
	let fn_idx = ctx.fn_index;
	let ir_ptr = ctx.ir;
	if (fn_idx >= len(ir_ptr.vec_pack_reuse)) { return; };
	emit_s(&ctx.g.em, "# vec_pack_reuse=");
	e_i(&ctx.g.em, ir_ptr.vec_pack_reuse[fn_idx]: i64);
	emit_s(&ctx.g.em, " vec_unpack_drop=");
	e_i(&ctx.g.em, ir_ptr.vec_unpack_drop[fn_idx]: i64);
	e_nl(&ctx.g.em);
};

fn x86_ir_spill_offset(ctx: *x86_ctx, vreg_id: u32) i64 = {
	if (vreg_id: size >= len(ctx.spill_offsets)) { return 0; };
	return ctx.spill_offsets[vreg_id: size];
};

fn x86_ir_gpr_is_caller_saved(idx: u8) bool = {
	if (idx == 0) { return true; }; // rax
	if (idx == 2) { return true; }; // rcx
	if (idx == 3) { return true; }; // rdx
	if (idx == 4) { return true; }; // rsi
	if (idx == 5) { return true; }; // rdi
	if (idx == 8) { return true; }; // r8
	if (idx == 9) { return true; }; // r9
	if (idx == 10) { return true; }; // r10
	if (idx == 11) { return true; }; // r11
	return false;
};

fn x86_ir_phys_call_clobbered(phys: phys_reg) bool = {
	if (phys.class == REG_SPILL) { return false; };
	if (phys.class == REG_GPR64 || phys.class == REG_GPR32 || phys.class == REG_GPR16 || phys.class == REG_GPR8) {
		return x86_ir_gpr_is_caller_saved(phys.index);
	};
	// All XMM registers are caller-saved.
	return phys.class == REG_XMM || phys.class == REG_XMM_SCALAR_F32 || phys.class == REG_XMM_SCALAR_F64
		|| phys.class == REG_XMM_VEC4_I32 || phys.class == REG_XMM_VEC2_I64
		|| phys.class == REG_XMM_VEC4_F32 || phys.class == REG_XMM_VEC2_F64;
};

fn x86_ir_spill_store_phys(ctx: *x86_ctx, v: ir_vreg, phys: phys_reg) void = {
	let off = x86_ir_spill_offset(ctx, v.id);
	if (off == 0) { return; };
	if (x86_ir_use_xmm(v.ty, v.width)) {
		let op = x86_ir_xmm_move_op(v.ty, v.width);
		let xmm_reg = x86_xmm_name(phys.index);
		x86_emit_reg_to_mem(&ctx.g.em, op, xmm_reg, off);
		return;
	};
	let store_op = x86_ir_gpr_store_op(v.ty);
	let bits = x86_ir_gpr_bits(v.ty);
	let gpr_reg = x86_gpr_name(phys.index, bits);
	x86_emit_reg_to_mem(&ctx.g.em, store_op, gpr_reg, off);
};

fn x86_ir_spill_load_phys(ctx: *x86_ctx, v: ir_vreg, phys: phys_reg) void = {
	let off = x86_ir_spill_offset(ctx, v.id);
	if (off == 0) { return; };
	if (x86_ir_use_xmm(v.ty, v.width)) {
		let op = x86_ir_xmm_move_op(v.ty, v.width);
		let xmm_reg = x86_xmm_name(phys.index);
		x86_emit_mem_to_reg(&ctx.g.em, op, off, xmm_reg);
		return;
	};
	let load_op = x86_ir_gpr_load_op(v.ty);
	let bits = x86_ir_gpr_bits(v.ty);
	let reg_bits: u8 = 64;
	if (bits == 32 && load_op == "movl") { reg_bits = 32; };
	let gpr_reg = x86_gpr_name(phys.index, reg_bits);
	x86_emit_mem_to_reg(&ctx.g.em, load_op, off, gpr_reg);
};

fn x86_ir_load_gpr_phys(ctx: *x86_ctx, v: ir_vreg, scratch_idx: u8) phys_reg = {
	let phys = x86_ir_find_alloc(ctx, v.id);
	if (phys.class == REG_SPILL) {
		let off = x86_ir_spill_offset(ctx, v.id);
		let reg = x86_gpr_name(scratch_idx, 64);
		x86_emit_mem_to_reg(&ctx.g.em, "movq", off, reg);
		return phys_reg { class = REG_GPR64, index = scratch_idx, lane = 0 };
	};
	return phys;
};

fn x86_ir_store_gpr_phys(ctx: *x86_ctx, v: ir_vreg, src: phys_reg) void = {
	let dst_phys = x86_ir_find_alloc(ctx, v.id);
	let src_reg = x86_gpr_name(src.index, 64);
	if (dst_phys.class == REG_SPILL) {
		let off = x86_ir_spill_offset(ctx, v.id);
		x86_emit_reg_to_mem(&ctx.g.em, "movq", src_reg, off);
		return;
	};
	if (!x86_ir_same_reg(dst_phys, src)) {
		let dst_reg = x86_gpr_name(dst_phys.index, 64);
		x86_emit_reg_reg(&ctx.g.em, "movq", src_reg, dst_reg);
	};
};

fn x86_ir_xmm_move_op(ty: u16, width: u8) str = {
	if (width > 1) {
		if (ty == IR_T_F32) { return "movups"; };
		if (ty == IR_T_F64) { return "movupd"; };
		return "movdqu";
	};
	if (ty == IR_T_F32) { return "movss"; };
	return "movsd";
};

fn x86_ir_vec_class(ty: u16, width: u8) u16 = {
	if (width > 1) {
		if (ty == IR_T_F32) { return REG_XMM_VEC4_F32; };
		if (ty == IR_T_F64) { return REG_XMM_VEC2_F64; };
		if (ty == IR_T_I32 || ty == IR_T_U32) { return REG_XMM_VEC4_I32; };
		if (ty == IR_T_I64 || ty == IR_T_U64 || ty == IR_T_PTR) { return REG_XMM_VEC2_I64; };
		return REG_XMM;
	};
	if (ty == IR_T_F32) { return REG_XMM_SCALAR_F32; };
	if (ty == IR_T_F64) { return REG_XMM_SCALAR_F64; };
	return REG_XMM;
};

fn x86_ir_use_xmm(ty: u16, width: u8) bool = {
	if (width > 1) { return true; };
	return ty == IR_T_F32 || ty == IR_T_F64;
};

fn x86_ir_gpr_bits(ty: u16) u8 = {
	if (ty == IR_T_I8 || ty == IR_T_U8) { return 8; };
	if (ty == IR_T_I16 || ty == IR_T_U16) { return 16; };
	if (ty == IR_T_I32 || ty == IR_T_U32) { return 32; };
	return 64;
};

fn x86_ir_elem_size(ty: u16) i64 = {
	if (ty == IR_T_I8 || ty == IR_T_U8) { return 1; };
	if (ty == IR_T_I16 || ty == IR_T_U16) { return 2; };
	if (ty == IR_T_I32 || ty == IR_T_U32 || ty == IR_T_F32) { return 4; };
	return 8;
};

fn x86_ir_pack_insert_gpr(em: *emitter, lane: u8, reg: str, dst_xmm: str, elem_size: i64) void = {
	emit_s(em, "\t");
	if (elem_size == 4) { emit_s(em, "pinsrd $"); }
	else { emit_s(em, "pinsrq $"); };
	e_i(em, lane: i64);
	emit_s(em, ", %");
	emit_s(em, reg);
	emit_s(em, ", %");
	emit_s(em, dst_xmm);
	e_nl(em);
};

fn x86_ir_emit_pack_reg(ctx: *x86_ctx, op: ir_op) bool = {
	let g = ctx.g;
	let width = op.dst.width: size;
	if (width <= 1 || op.arg_count < width) { return false; };
	let ty = op.dst.ty;
	if (!(ty == IR_T_F32 || ty == IR_T_F64 || ty == IR_T_I32 || ty == IR_T_U32
		|| ty == IR_T_I64 || ty == IR_T_U64 || ty == IR_T_PTR)) { return false; };
	let elem_size = x86_ir_elem_size(ty);
	let dst_phys = x86_ir_find_alloc(ctx, op.dst.id);
	let build_idx: u8 = X86_SCRATCH_XMM;
	if (dst_phys.class != REG_SPILL) { build_idx = dst_phys.index; };
	let build_reg = x86_xmm_name(build_idx);
	emit_s(&g.em, "\tpxor %");
	emit_s(&g.em, build_reg);
	emit_s(&g.em, ", %");
	emit_s(&g.em, build_reg);
	e_nl(&g.em);
	let lane = 0z;
	for (lane < width) {
		let src = ctx.ir.args[op.arg_start + lane];
		let src_phys = x86_ir_find_alloc(ctx, src.id);
		let tmp_gpr_idx: u8 = X86_SCRATCH_GPR0;
		let tmp_reg_bits: u8 = 64;
		if (elem_size == 4) { tmp_reg_bits = 32; };
		let tmp_reg = x86_gpr_name(tmp_gpr_idx, tmp_reg_bits);
		if (src_phys.class == REG_SPILL) {
			let off = x86_ir_spill_offset(ctx, src.id);
			let load_op = "movq";
			if (elem_size == 4) { load_op = "movl"; };
			x86_emit_mem_to_reg(&g.em, load_op, off, tmp_reg);
		} else if (x86_ir_use_xmm(src.ty, src.width)) {
			let src_xmm_reg = x86_xmm_name(src_phys.index);
			emit_s(&g.em, "\t");
			if (elem_size == 4) { emit_s(&g.em, "movd %"); }
			else { emit_s(&g.em, "movq %"); };
			emit_s(&g.em, src_xmm_reg);
			emit_s(&g.em, ", %");
			emit_s(&g.em, tmp_reg);
			e_nl(&g.em);
		} else {
			let src_gpr_reg = x86_gpr_name(src_phys.index, tmp_reg_bits);
			if (src_phys.index != tmp_gpr_idx) {
				let mov_op = "movq";
				if (elem_size == 4) { mov_op = "movl"; };
				x86_emit_reg_reg(&g.em, mov_op, src_gpr_reg, tmp_reg);
			};
		};
		x86_ir_pack_insert_gpr(&g.em, lane: u8, tmp_reg, build_reg, elem_size);
		lane += 1;
	};
	let build_phys = phys_reg { class = x86_ir_vec_class(ty, op.dst.width), index = build_idx, lane = 0 };
	x86_ir_store_xmm_phys(ctx, op.dst, build_phys);
	return true;
};

fn x86_ir_emit_unpack_fast(ctx: *x86_ctx, op: ir_op) bool = {
	let g = ctx.g;
	let ty = op.dst.ty;
	let elem_size = x86_ir_elem_size(ty);
	let src_phys = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
	let src_reg = x86_xmm_name(src_phys.index);
	if (x86_ir_use_xmm(op.dst.ty, op.dst.width)) {
		let dst_phys = x86_ir_find_alloc(ctx, op.dst.id);
		let dst_use = dst_phys;
		if (dst_phys.class == REG_SPILL) {
			let cls = x86_ir_vec_class(op.dst.ty, op.dst.width);
			dst_use = phys_reg { class = cls, index = X86_SCRATCH_XMM, lane = 0 };
		};
		let dst_xmm_reg = x86_xmm_name(dst_use.index);
		if (ty == IR_T_F32) {
			if (op.imm == 0) {
				x86_emit_reg_reg(&g.em, "movss", src_reg, dst_xmm_reg);
			} else {
				let lane = op.imm: u8;
				let imm = (lane | (lane << 2) | (lane << 4) | (lane << 6)): i64;
				emit_s(&g.em, "\tpshufd $");
				e_i(&g.em, imm);
				emit_s(&g.em, ", %");
				emit_s(&g.em, src_reg);
				emit_s(&g.em, ", %");
				emit_s(&g.em, dst_xmm_reg);
				e_nl(&g.em);
			};
		} else if (ty == IR_T_F64) {
			if (op.imm == 0) {
				x86_emit_reg_reg(&g.em, "movsd", src_reg, dst_xmm_reg);
			} else {
				if (dst_xmm_reg != src_reg) { x86_emit_reg_reg(&g.em, "movapd", src_reg, dst_xmm_reg); };
				emit_s(&g.em, "\tunpckhpd %");
				emit_s(&g.em, dst_xmm_reg);
				emit_s(&g.em, ", %");
				emit_s(&g.em, dst_xmm_reg);
				e_nl(&g.em);
			};
		} else {
			return false;
		};
		if (dst_phys.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, op.dst, dst_use); };
		return true;
	};
	let dst_phys_gpr = x86_ir_find_alloc(ctx, op.dst.id);
	let dst_use_gpr = dst_phys_gpr;
	if (dst_phys_gpr.class == REG_SPILL) { dst_use_gpr = phys_reg { class = REG_GPR64, index = X86_SCRATCH_GPR1, lane = 0 }; };
	let dst_reg_bits: u8 = 64;
	if (elem_size == 4) { dst_reg_bits = 32; };
	let dst_gpr_reg = x86_gpr_name(dst_use_gpr.index, dst_reg_bits);
	emit_s(&g.em, "\t");
	if (elem_size == 4) { emit_s(&g.em, "pextrd $"); }
	else { emit_s(&g.em, "pextrq $"); };
	e_i(&g.em, op.imm);
	emit_s(&g.em, ", %");
	emit_s(&g.em, src_reg);
	emit_s(&g.em, ", %");
	emit_s(&g.em, dst_gpr_reg);
	e_nl(&g.em);
	if (dst_phys_gpr.class == REG_SPILL) { x86_ir_store_gpr_phys(ctx, op.dst, dst_use_gpr); };
	return true;
};

fn x86_ir_gpr_load_op(ty: u16) str = {
	if (ty == IR_T_I8) { return "movsbq"; };
	if (ty == IR_T_U8) { return "movzbq"; };
	if (ty == IR_T_I16) { return "movswq"; };
	if (ty == IR_T_U16) { return "movzwq"; };
	if (ty == IR_T_I32) { return "movslq"; };
	if (ty == IR_T_U32) { return "movl"; };
	return "movq";
};

fn x86_ir_gpr_store_op(ty: u16) str = {
	let bits = x86_ir_gpr_bits(ty);
	if (bits == 8) { return "movb"; };
	if (bits == 16) { return "movw"; };
	if (bits == 32) { return "movl"; };
	return "movq";
};

fn x86_ir_vec_bin_op(ty: u16, aux: u16) str = {
	if (ty == IR_T_F32) {
		if (aux == IR_BIN_ADD) { return "addps"; };
		if (aux == IR_BIN_SUB) { return "subps"; };
		if (aux == IR_BIN_MUL) { return "mulps"; };
		if (aux == IR_BIN_DIV) { return "divps"; };
		return "";
	};
	if (ty == IR_T_F64) {
		if (aux == IR_BIN_ADD) { return "addpd"; };
		if (aux == IR_BIN_SUB) { return "subpd"; };
		if (aux == IR_BIN_MUL) { return "mulpd"; };
		if (aux == IR_BIN_DIV) { return "divpd"; };
		return "";
	};
	if (ty == IR_T_I32 || ty == IR_T_U32) {
		if (aux == IR_BIN_ADD) { return "paddd"; };
		if (aux == IR_BIN_SUB) { return "psubd"; };
		if (aux == IR_BIN_MUL) { return "pmulld"; };
		if (aux == IR_BIN_AND) { return "pand"; };
		if (aux == IR_BIN_OR) { return "por"; };
		if (aux == IR_BIN_XOR) { return "pxor"; };
		return "";
	};
	if (ty == IR_T_I64 || ty == IR_T_U64 || ty == IR_T_PTR) {
		if (aux == IR_BIN_ADD) { return "paddq"; };
		if (aux == IR_BIN_SUB) { return "psubq"; };
		if (aux == IR_BIN_AND) { return "pand"; };
		if (aux == IR_BIN_OR) { return "por"; };
		if (aux == IR_BIN_XOR) { return "pxor"; };
		return "";
	};
	return "";
};

fn x86_ir_load_xmm_phys(ctx: *x86_ctx, v: ir_vreg, scratch_idx: u8) phys_reg = {
	let phys = x86_ir_find_alloc(ctx, v.id);
	if (phys.class == REG_SPILL) {
		let off = x86_ir_spill_offset(ctx, v.id);
		let reg = x86_xmm_name(scratch_idx);
		let op = x86_ir_xmm_move_op(v.ty, v.width);
		x86_emit_mem_to_reg(&ctx.g.em, op, off, reg);
		let cls: u16 = x86_ir_vec_class(v.ty, v.width);
		return phys_reg { class = cls, index = scratch_idx, lane = 0 };
	};
	return phys;
};

fn x86_ir_store_xmm_phys(ctx: *x86_ctx, v: ir_vreg, src: phys_reg) void = {
	let dst_phys = x86_ir_find_alloc(ctx, v.id);
	let src_reg = x86_xmm_name(src.index);
	let op = x86_ir_xmm_move_op(v.ty, v.width);
	if (dst_phys.class == REG_SPILL) {
		let off = x86_ir_spill_offset(ctx, v.id);
		x86_emit_reg_to_mem(&ctx.g.em, op, src_reg, off);
		return;
	};
	if (!x86_ir_same_reg(dst_phys, src)) {
		let dst_reg = x86_xmm_name(dst_phys.index);
		x86_emit_reg_reg(&ctx.g.em, op, src_reg, dst_reg);
	};
};

fn x86_ir_xmm_dst_use(ctx: *x86_ctx, dst: ir_vreg, scratch_idx: u8) phys_reg = {
	let dst_phys = x86_ir_find_alloc(ctx, dst.id);
	if (dst_phys.class == REG_SPILL) {
		let cls = x86_ir_vec_class(dst.ty, dst.width);
		return phys_reg { class = cls, index = scratch_idx, lane = 0 };
	};
	return dst_phys;
};

fn x86_ir_gpr_dst_use(ctx: *x86_ctx, dst: ir_vreg, scratch_idx: u8) phys_reg = {
	let dst_phys = x86_ir_find_alloc(ctx, dst.id);
	if (dst_phys.class == REG_SPILL) {
		return phys_reg { class = REG_GPR64, index = scratch_idx, lane = 0 };
	};
	return dst_phys;
};

fn x86_ir_save_call_clobbered(ctx: *x86_ctx, f: *ir_func, skip: phys_reg) void = {
	let v = 0u32;
	for (v < f.next_vreg) {
		let id = f.vreg_base + v;
		let phys = x86_ir_find_alloc(ctx, id);
		if (!x86_ir_phys_call_clobbered(phys)) { v += 1u32; continue; };
		if (x86_ir_same_reg(phys, skip)) { v += 1u32; continue; };
		let ty = ctx.ir.vreg_types[id: size];
		let width = ctx.ir.vreg_widths[id: size];
		let vreg = ir_vreg { id = id, ty = ty, width = width };
		x86_ir_spill_store_phys(ctx, vreg, phys);
		v += 1u32;
	};
};

fn x86_ir_restore_call_clobbered(ctx: *x86_ctx, f: *ir_func, skip: phys_reg) void = {
	let v = 0u32;
	for (v < f.next_vreg) {
		let id = f.vreg_base + v;
		let phys = x86_ir_find_alloc(ctx, id);
		if (!x86_ir_phys_call_clobbered(phys)) { v += 1u32; continue; };
		if (x86_ir_same_reg(phys, skip)) { v += 1u32; continue; };
		let ty = ctx.ir.vreg_types[id: size];
		let width = ctx.ir.vreg_widths[id: size];
		let vreg = ir_vreg { id = id, ty = ty, width = width };
		x86_ir_spill_load_phys(ctx, vreg, phys);
		v += 1u32;
	};
};

fn x86_ir_emit_cast(ctx: *x86_ctx, op: ir_op) void = {
	let src_ty = op.a.ty;
	let dst_ty = op.dst.ty;
	let src_is_float = src_ty == IR_T_F32 || src_ty == IR_T_F64;
	let dst_is_float = dst_ty == IR_T_F32 || dst_ty == IR_T_F64;
	if (src_ty == dst_ty) {
		if (x86_ir_use_xmm(dst_ty, op.dst.width)) {
			let src_phys_xmm = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
			x86_ir_store_xmm_phys(ctx, op.dst, src_phys_xmm);
		} else {
			let src_phys_gpr = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR1);
			x86_ir_store_gpr_phys(ctx, op.dst, src_phys_gpr);
		};
		return;
	};
	if (src_is_float && dst_is_float) {
		let dst_phys_ff = x86_ir_find_alloc(ctx, op.dst.id);
		let dst_use_ff = dst_phys_ff;
		if (dst_phys_ff.class == REG_SPILL) {
			let cls_ff = x86_ir_vec_class(dst_ty, op.dst.width);
			dst_use_ff = phys_reg { class = cls_ff, index = X86_SCRATCH_XMM, lane = 0 };
		};
		let dst_reg_ff = x86_xmm_name(dst_use_ff.index);
		let src_phys_ff = x86_ir_load_xmm_phys(ctx, op.a, dst_use_ff.index);
		let src_reg_ff = x86_xmm_name(src_phys_ff.index);
		if (src_ty == IR_T_F32 && dst_ty == IR_T_F64) { x86_emit_reg_reg(&ctx.g.em, "cvtss2sd", src_reg_ff, dst_reg_ff); }
		else if (src_ty == IR_T_F64 && dst_ty == IR_T_F32) { x86_emit_reg_reg(&ctx.g.em, "cvtsd2ss", src_reg_ff, dst_reg_ff); }
		else { x86_emit_reg_reg(&ctx.g.em, x86_ir_xmm_move_op(dst_ty, op.dst.width), src_reg_ff, dst_reg_ff); };
		if (dst_phys_ff.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, op.dst, dst_use_ff); };
		return;
	};
	if (!src_is_float && dst_is_float) {
		let dst_phys_if = x86_ir_find_alloc(ctx, op.dst.id);
		let dst_use_if = dst_phys_if;
		if (dst_phys_if.class == REG_SPILL) {
			let cls_if = x86_ir_vec_class(dst_ty, op.dst.width);
			dst_use_if = phys_reg { class = cls_if, index = X86_SCRATCH_XMM, lane = 0 };
		};
		let dst_reg_if = x86_xmm_name(dst_use_if.index);
		let src_phys_if = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR1);
		let src_reg_if = x86_gpr_name(src_phys_if.index, 64);
		if (dst_ty == IR_T_F32) { x86_emit_reg_reg(&ctx.g.em, "cvtsi2ss", src_reg_if, dst_reg_if); }
		else { x86_emit_reg_reg(&ctx.g.em, "cvtsi2sd", src_reg_if, dst_reg_if); };
		if (dst_phys_if.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, op.dst, dst_use_if); };
		return;
	};
	if (src_is_float && !dst_is_float) {
		let dst_phys_fi = x86_ir_find_alloc(ctx, op.dst.id);
		let dst_use_fi = dst_phys_fi;
		if (dst_phys_fi.class == REG_SPILL) { dst_use_fi = phys_reg { class = REG_GPR64, index = X86_SCRATCH_GPR1, lane = 0 }; };
		let dst_reg_fi = x86_gpr_name(dst_use_fi.index, 64);
		let src_phys_fi = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
		let src_reg_fi = x86_xmm_name(src_phys_fi.index);
		if (src_ty == IR_T_F32) { x86_emit_reg_reg(&ctx.g.em, "cvttss2si", src_reg_fi, dst_reg_fi); }
		else { x86_emit_reg_reg(&ctx.g.em, "cvttsd2si", src_reg_fi, dst_reg_fi); };
		if (dst_phys_fi.class == REG_SPILL) { x86_ir_store_gpr_phys(ctx, op.dst, dst_use_fi); };
		return;
	};
	let src_phys_int = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR1);
	x86_ir_store_gpr_phys(ctx, op.dst, src_phys_int);
};

fn x86_ir_emit_pack(ctx: *x86_ctx, op: ir_op) void = {
	let g = ctx.g;
	if (x86_ir_emit_pack_reg(ctx, op)) { return; };
	let width = op.dst.width: size;
	if (width == 0) { return; };
	let elem_size = x86_ir_elem_size(op.dst.ty);
	let scratch = ctx.call_scratch_base;
	let width_i: i64 = width: i64;
	let base_off = scratch + (width_i - 1) * elem_size;
	let zero_idx: u8 = X86_SCRATCH_GPR1;
	x86_emit_zero_gpr(&g.em, zero_idx);
	let zero_reg = x86_gpr_name(zero_idx, 64);
	x86_emit_reg_to_mem(&g.em, "movq", zero_reg, scratch);
	x86_emit_reg_to_mem(&g.em, "movq", zero_reg, scratch + 8);
	let lane = 0z;
	for (lane < width && lane < op.arg_count) {
		let src = ctx.ir.args[op.arg_start + lane];
		let lane_off = base_off - (lane: i64) * elem_size;
		if (x86_ir_use_xmm(src.ty, src.width)) {
			let src_phys_xmm = x86_ir_load_xmm_phys(ctx, src, X86_SCRATCH_XMM);
			let src_reg_xmm = x86_xmm_name(src_phys_xmm.index);
			let store_op_xmm = "movsd";
			if (src.ty == IR_T_F32) { store_op_xmm = "movss"; };
			x86_emit_reg_to_mem(&g.em, store_op_xmm, src_reg_xmm, lane_off);
		} else {
			let src_phys_gpr = x86_ir_load_gpr_phys(ctx, src, X86_SCRATCH_GPR1);
			let store_op_gpr = "movq";
			let store_bits: u8 = 64;
			if (elem_size == 4) { store_op_gpr = "movl"; store_bits = 32; };
			let src_reg = x86_gpr_name(src_phys_gpr.index, store_bits);
			x86_emit_reg_to_mem(&g.em, store_op_gpr, src_reg, lane_off);
		};
		lane += 1;
	};
	let dst_phys = x86_ir_find_alloc(ctx, op.dst.id);
	let dst_use = dst_phys;
	if (dst_phys.class == REG_SPILL) {
		let cls = x86_ir_vec_class(op.dst.ty, op.dst.width);
		dst_use = phys_reg { class = cls, index = X86_SCRATCH_XMM, lane = 0 };
	};
	let dst_reg = x86_xmm_name(dst_use.index);
	let mov_op = x86_ir_xmm_move_op(op.dst.ty, op.dst.width);
	x86_emit_mem_to_reg(&g.em, mov_op, base_off, dst_reg);
	if (dst_phys.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, op.dst, dst_use); };
};

fn x86_ir_emit_unpack(ctx: *x86_ctx, op: ir_op) void = {
	let g = ctx.g;
	if (x86_ir_emit_unpack_fast(ctx, op)) { return; };
	let elem_size = x86_ir_elem_size(op.dst.ty);
	let scratch = ctx.call_scratch_base;
	let width_i: i64 = op.a.width: i64;
	if (width_i == 0) { width_i = 1; };
	let base_off = scratch + (width_i - 1) * elem_size;
	let src_phys = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
	let src_reg = x86_xmm_name(src_phys.index);
	let mov_op = x86_ir_xmm_move_op(op.a.ty, op.a.width);
	x86_emit_reg_to_mem(&g.em, mov_op, src_reg, base_off);
	let lane_off = base_off - op.imm * elem_size;
	if (x86_ir_use_xmm(op.dst.ty, op.dst.width)) {
		let dst_phys_xmm = x86_ir_find_alloc(ctx, op.dst.id);
		let dst_use_xmm = dst_phys_xmm;
		if (dst_phys_xmm.class == REG_SPILL) {
			let cls = x86_ir_vec_class(op.dst.ty, op.dst.width);
			dst_use_xmm = phys_reg { class = cls, index = X86_SCRATCH_XMM, lane = 0 };
		};
		let dst_reg_xmm = x86_xmm_name(dst_use_xmm.index);
		let load_op_xmm = "movsd";
		if (op.dst.ty == IR_T_F32) { load_op_xmm = "movss"; };
		x86_emit_mem_to_reg(&g.em, load_op_xmm, lane_off, dst_reg_xmm);
		if (dst_phys_xmm.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, op.dst, dst_use_xmm); };
	} else {
		let dst_phys_gpr = x86_ir_find_alloc(ctx, op.dst.id);
		let dst_use_gpr = dst_phys_gpr;
		if (dst_phys_gpr.class == REG_SPILL) { dst_use_gpr = phys_reg { class = REG_GPR64, index = X86_SCRATCH_GPR1, lane = 0 }; };
		let load_op_gpr = x86_ir_gpr_load_op(op.dst.ty);
		let load_bits = x86_ir_gpr_bits(op.dst.ty);
		let load_reg_bits: u8 = 64;
		if (load_bits == 32 && load_op_gpr == "movl") { load_reg_bits = 32; };
		let dst_reg_gpr = x86_gpr_name(dst_use_gpr.index, load_reg_bits);
		x86_emit_mem_to_reg(&g.em, load_op_gpr, lane_off, dst_reg_gpr);
		if (dst_phys_gpr.class == REG_SPILL) { x86_ir_store_gpr_phys(ctx, op.dst, dst_use_gpr); };
	};
};

fn x86_ir_supported_func(ctx: *x86_ctx, f: *ir_func) bool = {
	if (!f.supported) { return false; };
	if (ctx.virt == null || ctx.sched == null) { return false; };
	let param_int: size = 0;
	let param_float: size = 0;
	let pi = 0z;
	for (pi < f.params_len) {
		let pv = ctx.ir.params[f.params_start + pi];
		if (pv.ty == IR_T_F32 || pv.ty == IR_T_F64) { param_float += 1; }
		else { param_int += 1; };
		pi += 1;
	};
	if (param_int > 6 || param_float > 8) { return false; };
	let v = 0u32;
	for (v < f.next_vreg) {
		let id = f.vreg_base + v;
		let phys = x86_ir_find_alloc(ctx, id);
		if (phys.class == 0) { return false; };
		let ty = ctx.ir.vreg_types[id: size];
		let width = ctx.ir.vreg_widths[id: size];
		if (ty == IR_T_F32 || ty == IR_T_F64) {
			// ok with XMM or spill
			void;
		} else if (width > 1) {
			if (!(phys.class == REG_XMM_VEC4_I32 || phys.class == REG_XMM_VEC2_I64
				|| phys.class == REG_XMM || phys.class == REG_SPILL)) { return false; };
		} else {
			if (!(phys.class == REG_GPR64 || phys.class == REG_SPILL)) { return false; };
		};
		v += 1u32;
	};
	let j = 0z;
	for (j < f.ops_len) {
		let op = ctx.ir.ops[f.ops_start + j];
		if (op.kind == IR_OP_CAST) {
			let small_src = op.a.ty == IR_T_I8 || op.a.ty == IR_T_I16 || op.a.ty == IR_T_U8 || op.a.ty == IR_T_U16;
			let small_dst = op.dst.ty == IR_T_I8 || op.dst.ty == IR_T_I16 || op.dst.ty == IR_T_U8 || op.dst.ty == IR_T_U16;
			if (small_src || small_dst) { return false; };
		};
		let is_vec = op.dst.width > 1 || op.a.width > 1 || op.b.width > 1;
		if (is_vec && !x86_ir_vec_op_supported(op)) { return false; };
		if (op.kind == IR_OP_CALL && op.aux != IR_CALL_ABORT_FIXED) {
			let ai = 0z;
			let call_int: size = 0;
			let call_float: size = 0;
			for (ai < op.arg_count) {
				let av = ctx.ir.args[op.arg_start + ai];
				if (av.width > 1) { return false; };
				if (av.ty == IR_T_F32 || av.ty == IR_T_F64) { call_float += 1; }
				else { call_int += 1; };
				ai += 1;
			};
			if (call_int > 6 || call_float > 8) { return false; };
			if (op.dst.width > 1) { return false; };
		};
		j += 1;
	};
	return true;
};

fn x86_ir_vec_op_supported(op: ir_op) bool = {
	let ty = op.dst.ty;
	if (op.kind == IR_OP_BIN) {
		if (ty == IR_T_F32) { return op.aux == IR_BIN_ADD || op.aux == IR_BIN_SUB || op.aux == IR_BIN_MUL || op.aux == IR_BIN_DIV; };
		if (ty == IR_T_F64) { return op.aux == IR_BIN_ADD || op.aux == IR_BIN_SUB || op.aux == IR_BIN_MUL || op.aux == IR_BIN_DIV; };
		if (ty == IR_T_I32 || ty == IR_T_U32) {
			return op.aux == IR_BIN_ADD || op.aux == IR_BIN_SUB || op.aux == IR_BIN_MUL
				|| op.aux == IR_BIN_AND || op.aux == IR_BIN_OR || op.aux == IR_BIN_XOR;
		};
		if (ty == IR_T_I64 || ty == IR_T_U64 || ty == IR_T_PTR) {
			return op.aux == IR_BIN_ADD || op.aux == IR_BIN_SUB
				|| op.aux == IR_BIN_AND || op.aux == IR_BIN_OR || op.aux == IR_BIN_XOR;
		};
		return false;
	};
	if (op.kind == IR_OP_UN) {
		if (ty == IR_T_F32 || ty == IR_T_F64) { return op.aux == IR_UN_NEG; };
		return false;
	};
	if (op.kind == IR_OP_CAST) {
		return op.dst.width <= 1 && op.a.width <= 1;
	};
	if (op.kind == IR_OP_LOAD || op.kind == IR_OP_STORE || op.kind == IR_OP_COPY
		|| op.kind == IR_OP_ADDR || op.kind == IR_OP_PACK || op.kind == IR_OP_UNPACK) { return true; };
	return false;
};

fn x86_ir_setup_spills(ctx: *x86_ctx, f: *ir_func) void = {
	if ((ctx.stack_size & 15) != 0) { ctx.stack_size += 16 - (ctx.stack_size & 15); };
	ctx.spill_count = 0;
	let v = 0u32;
	for (v < f.next_vreg) {
		let id = f.vreg_base + v;
		if (id: size < len(ctx.spill_offsets)) { ctx.spill_offsets[id: size] = 0; };
		v += 1u32;
	};
	let spill_total: i64 = 0;
	v = 0u32;
	for (v < f.next_vreg) {
		let id2 = f.vreg_base + v;
		let phys = x86_ir_find_alloc(ctx, id2);
		if (phys.class == REG_SPILL || x86_ir_phys_call_clobbered(phys)) {
			let ty = ctx.ir.vreg_types[id2: size];
			let width = ctx.ir.vreg_widths[id2: size];
			let slot_size: i64 = 8;
			if (ty == IR_T_F32 || ty == IR_T_F64 || width > 1) { slot_size = 16; };
			if ((slot_size == 16) && ((spill_total & 15) != 0)) { spill_total += 16 - (spill_total & 15); };
			spill_total += slot_size;
			if (id2: size < len(ctx.spill_offsets)) { ctx.spill_offsets[id2: size] = ctx.stack_size + spill_total; };
			ctx.spill_count += 1;
		};
		v += 1u32;
	};
	ctx.spill_base = ctx.stack_size;
	ctx.stack_size += spill_total;
	if ((ctx.stack_size & 15) != 0) { ctx.stack_size += 16 - (ctx.stack_size & 15); };
};

fn x86_ir_bind_params(ctx: *x86_ctx, f: *ir_func) void = {
	let g = ctx.g;
	let int_regs: [6]str = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"];
	let float_regs: [8]str = ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7"];
	let int_idx: size = 0;
	let float_idx: size = 0;
	let int_move_src: [6]str = [""...];
	let int_move_dst: [6]str = [""...];
	let int_move_done: [6]u8 = [0...];
	let int_move_count: size = 0;
	let float_move_src: [8]str = [""...];
	let float_move_dst: [8]str = [""...];
	let float_move_op: [8]str = [""...];
	let float_move_done: [8]u8 = [0...];
	let float_move_count: size = 0;
	let i = 0z;
	for (i < f.params_len) {
		let v = ctx.ir.params[f.params_start + i];
		if (v.ty == IR_T_F32 || v.ty == IR_T_F64) {
			if (float_idx >= len(float_regs)) { return; };
			let phys_float = x86_ir_find_alloc(ctx, v.id);
			let src_float = float_regs[float_idx];
			let mov_op = x86_ir_xmm_move_op(v.ty, 1);
			if (phys_float.class == REG_SPILL) {
				let off_float = x86_ir_spill_offset(ctx, v.id);
				x86_emit_reg_to_mem(&g.em, mov_op, src_float, off_float);
			} else {
				let dst_float = x86_ir_reg_name(phys_float);
				if (dst_float != src_float) {
					if (float_move_count < len(float_move_src)) {
						float_move_src[float_move_count] = src_float;
						float_move_dst[float_move_count] = dst_float;
						float_move_op[float_move_count] = mov_op;
						float_move_count += 1;
					};
				};
			};
			float_idx += 1;
		} else {
			if (int_idx >= len(int_regs)) { return; };
			let phys_int = x86_ir_find_alloc(ctx, v.id);
			let src_int = int_regs[int_idx];
			if (phys_int.class == REG_SPILL) {
				let off_int = x86_ir_spill_offset(ctx, v.id);
				x86_emit_reg_to_mem(&g.em, "movq", src_int, off_int);
			} else {
				let dst_int = x86_ir_reg_name(phys_int);
				if (dst_int != src_int) {
					if (int_move_count < len(int_move_src)) {
						int_move_src[int_move_count] = src_int;
						int_move_dst[int_move_count] = dst_int;
						int_move_count += 1;
					};
				};
			};
			int_idx += 1;
		};
		i += 1;
	};

	// Resolve integer register moves without clobbering sources.
	let int_remaining = int_move_count;
	for (int_remaining > 0) {
		let progressed = false;
		let mi = 0z;
		for (mi < int_move_count) {
			if (int_move_done[mi] != 0u8) { mi += 1; continue; };
			let dst = int_move_dst[mi];
			let dst_is_src = false;
			let mj = 0z;
			for (mj < int_move_count) {
				if (int_move_done[mj] != 0u8) { mj += 1; continue; };
				if (int_move_src[mj] == dst) { dst_is_src = true; break; };
				mj += 1;
			};
			if (!dst_is_src) {
				x86_emit_reg_reg(&g.em, "movq", int_move_src[mi], int_move_dst[mi]);
				int_move_done[mi] = 1u8;
				int_remaining -= 1;
				progressed = true;
			};
			mi += 1;
		};
		if (progressed) { continue; };
		// Cycle: spill one source into scratch and retry.
		let pick = 0z;
		let found = false;
		for (pick < int_move_count) {
			if (int_move_done[pick] == 0u8) { found = true; break; };
			pick += 1;
		};
		if (!found) { break; };
		x86_emit_reg_reg(&g.em, "movq", int_move_src[pick], x86_gpr_name(X86_SCRATCH_GPR0, 64));
		int_move_src[pick] = x86_gpr_name(X86_SCRATCH_GPR0, 64);
	};

	// Resolve float register moves without clobbering sources.
	let float_remaining = float_move_count;
	for (float_remaining > 0) {
		let progressed_f = false;
		let fi = 0z;
		for (fi < float_move_count) {
			if (float_move_done[fi] != 0u8) { fi += 1; continue; };
			let dstf = float_move_dst[fi];
			let dst_is_src_f = false;
			let fj = 0z;
			for (fj < float_move_count) {
				if (float_move_done[fj] != 0u8) { fj += 1; continue; };
				if (float_move_src[fj] == dstf) { dst_is_src_f = true; break; };
				fj += 1;
			};
			if (!dst_is_src_f) {
				x86_emit_reg_reg(&g.em, float_move_op[fi], float_move_src[fi], float_move_dst[fi]);
				float_move_done[fi] = 1u8;
				float_remaining -= 1;
				progressed_f = true;
			};
			fi += 1;
		};
		if (progressed_f) { continue; };
		// Cycle: spill one source into scratch XMM and retry.
		let pickf = 0z;
		let foundf = false;
		for (pickf < float_move_count) {
			if (float_move_done[pickf] == 0u8) { foundf = true; break; };
			pickf += 1;
		};
		if (!foundf) { break; };
		x86_emit_reg_reg(&g.em, float_move_op[pickf], float_move_src[pickf], x86_xmm_name(X86_SCRATCH_XMM));
		float_move_src[pickf] = x86_xmm_name(X86_SCRATCH_XMM);
	};
};

fn x86_ir_emit_call_abort_fixed(ctx: *x86_ctx, op: ir_op) void = {
	let g = ctx.g;
	let args_start = op.arg_start;
	let args_count = op.arg_count;
	if (args_count < 4) { return; };
	let v0 = ctx.ir.args[args_start + 0];
	let v1 = ctx.ir.args[args_start + 1];
	let v2 = ctx.ir.args[args_start + 2];
	let v3 = ctx.ir.args[args_start + 3];
	let p0 = x86_ir_load_gpr_phys(ctx, v0, X86_SCRATCH_GPR0);
	let p1 = x86_ir_load_gpr_phys(ctx, v1, X86_SCRATCH_GPR0);
	let p2 = x86_ir_load_gpr_phys(ctx, v2, X86_SCRATCH_GPR0);
	let p3 = x86_ir_load_gpr_phys(ctx, v3, X86_SCRATCH_GPR0);
	let rdi = x86_gpr_name(p0.index, 64);
	let rsi = x86_gpr_name(p1.index, 64);
	let rdx = x86_gpr_name(p2.index, 64);
	let rcx = x86_gpr_name(p3.index, 64);
	if (rdi != "rdi") { x86_emit_reg_reg(&g.em, "movq", rdi, "rdi"); };
	if (rsi != "rsi") { x86_emit_reg_reg(&g.em, "movq", rsi, "rsi"); };
	if (rdx != "rdx") { x86_emit_reg_reg(&g.em, "movq", rdx, "rdx"); };
	if (rcx != "rcx") { x86_emit_reg_reg(&g.em, "movq", rcx, "rcx"); };
	let did_pad = x86_align_for_call(ctx);
	x86_emit_ins(&g.em, "call rt_abort_fixed");
	x86_unalign_after_call(ctx, did_pad);
};

fn x86_ir_emit_call_target(ctx: *x86_ctx, op: ir_op) void = {
	let g = ctx.g;
	if (op.aux == IR_CALL_QUAL) {
		emit_s(&g.em, "\tcall ");
		emit_path_mangled(g, op.sym);
		e_c(&g.em, '_');
		e_bref(&g.em, op.sym2);
		e_nl(&g.em);
		return;
	};
	let glob_ptr = dict_get_bref(&g.globals, op.sym);
	if (glob_ptr != 0) {
		let fn_node: *tnode = glob_ptr: uintptr: *tnode;
		if (fn_node.kind == N_FN && (fn_node.flags & F_SYMBOL) != 0) {
			let sym_node: *tnode = t_first_nn(fn_node);
			let sym_ref = sym_node.ref;
			if (sym_ref.length > 2) {
				let inner = bref { pos = sym_ref.pos + 1, length = sym_ref.length - 2 };
				emit_s(&g.em, "\tcall ");
				e_bref(&g.em, inner);
				e_nl(&g.em);
				return;
			};
		};
	};
	emit_s(&g.em, "\tcall ");
	e_prefixed_id(g, op.sym);
	e_nl(&g.em);
};

fn x86_ir_emit_call_arg_float(ctx: *x86_ctx, arg: ir_vreg, dst_idx: u8) void = {
	let g = ctx.g;
	let src_phys = x86_ir_load_xmm_phys(ctx, arg, X86_SCRATCH_XMM);
	let src_reg = x86_xmm_name(src_phys.index);
	let dst_reg = x86_xmm_name(dst_idx);
	let mov_op = x86_ir_xmm_move_op(arg.ty, arg.width);
	if (src_reg != dst_reg) { x86_emit_reg_reg(&g.em, mov_op, src_reg, dst_reg); };
};

fn x86_ir_emit_call_arg_int(ctx: *x86_ctx, arg: ir_vreg, dst_idx: u8) void = {
	let g = ctx.g;
	let src_phys = x86_ir_load_gpr_phys(ctx, arg, X86_SCRATCH_GPR0);
	let load_op = x86_ir_gpr_load_op(arg.ty);
	let src_bits = x86_ir_gpr_bits(arg.ty);
	let src_reg = x86_gpr_name(src_phys.index, src_bits);
	let dst_bits: u8 = 64;
	if (load_op == "movl") { dst_bits = 32; };
	let dst_reg = x86_gpr_name(dst_idx, dst_bits);
	if (!(src_phys.index == dst_idx && load_op == "movq")) {
		x86_emit_reg_reg(&g.em, load_op, src_reg, dst_reg);
	};
};

fn x86_ir_emit_call_ret_float(ctx: *x86_ctx, dst: ir_vreg) void = {
	let dst_phys = x86_ir_find_alloc(ctx, dst.id);
	let mov_op = x86_ir_xmm_move_op(dst.ty, dst.width);
	if (dst_phys.class == REG_SPILL) {
		let off = x86_ir_spill_offset(ctx, dst.id);
		x86_emit_reg_to_mem(&ctx.g.em, mov_op, "xmm0", off);
		return;
	};
	let dst_reg = x86_xmm_name(dst_phys.index);
	if (dst_reg != "xmm0") { x86_emit_reg_reg(&ctx.g.em, mov_op, "xmm0", dst_reg); };
};

fn x86_ir_emit_call_ret_int(ctx: *x86_ctx, dst: ir_vreg) void = {
	let g = ctx.g;
	let dst_phys = x86_ir_find_alloc(ctx, dst.id);
	if (dst_phys.class == REG_SPILL) {
		let store_op = x86_ir_gpr_store_op(dst.ty);
		let bits = x86_ir_gpr_bits(dst.ty);
		let src_reg_spill = x86_gpr_name(0, bits);
		let off = x86_ir_spill_offset(ctx, dst.id);
		x86_emit_reg_to_mem(&g.em, store_op, src_reg_spill, off);
		return;
	};
	let load_op = x86_ir_gpr_load_op(dst.ty);
	let src_bits = x86_ir_gpr_bits(dst.ty);
	let src_reg_ret = x86_gpr_name(0, src_bits);
	let dst_bits: u8 = 64;
	if (load_op == "movl") { dst_bits = 32; };
	let dst_reg = x86_gpr_name(dst_phys.index, dst_bits);
	if (!(dst_phys.index == 0 && load_op == "movq")) {
		x86_emit_reg_reg(&g.em, load_op, src_reg_ret, dst_reg);
	};
};

fn x86_ir_emit_load_from_addr(ctx: *x86_ctx, dst: ir_vreg, addr_reg: str) void = {
	let g = ctx.g;
	if (x86_ir_use_xmm(dst.ty, dst.width)) {
		let dst_phys = x86_ir_find_alloc(ctx, dst.id);
		let dst_use = dst_phys;
		if (dst_phys.class == REG_SPILL) {
			let cls = x86_ir_vec_class(dst.ty, dst.width);
			dst_use = phys_reg { class = cls, index = X86_SCRATCH_XMM, lane = 0 };
		};
		let dst_reg = x86_xmm_name(dst_use.index);
		let mov_op = x86_ir_xmm_move_op(dst.ty, dst.width);
		x86_emit_mem_addr_to_reg(&g.em, mov_op, addr_reg, dst_reg);
		if (dst_phys.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, dst, dst_use); };
		return;
	};
	let dst_phys_gpr = x86_ir_find_alloc(ctx, dst.id);
	let dst_use_gpr = dst_phys_gpr;
	if (dst_phys_gpr.class == REG_SPILL) {
		dst_use_gpr = phys_reg { class = REG_GPR64, index = X86_SCRATCH_GPR1, lane = 0 };
	};
	let load_op = x86_ir_gpr_load_op(dst.ty);
	let bits = x86_ir_gpr_bits(dst.ty);
	let reg_bits: u8 = 64;
	if (bits == 32 && load_op == "movl") { reg_bits = 32; };
	let dst_reg_gpr = x86_gpr_name(dst_use_gpr.index, reg_bits);
	x86_emit_mem_addr_to_reg(&g.em, load_op, addr_reg, dst_reg_gpr);
	if (dst_phys_gpr.class == REG_SPILL) { x86_ir_store_gpr_phys(ctx, dst, dst_use_gpr); };
};

fn x86_ir_emit_store_to_addr(ctx: *x86_ctx, src: ir_vreg, addr_reg: str) void = {
	let g = ctx.g;
	if (x86_ir_use_xmm(src.ty, src.width)) {
		let src_phys = x86_ir_load_xmm_phys(ctx, src, X86_SCRATCH_XMM);
		let src_reg = x86_xmm_name(src_phys.index);
		let mov_op = x86_ir_xmm_move_op(src.ty, src.width);
		x86_emit_reg_to_mem_addr(&g.em, mov_op, src_reg, addr_reg);
		return;
	};
	let src_phys_gpr = x86_ir_load_gpr_phys(ctx, src, X86_SCRATCH_GPR1);
	let store_op = x86_ir_gpr_store_op(src.ty);
	let bits = x86_ir_gpr_bits(src.ty);
	let src_reg_gpr = x86_gpr_name(src_phys_gpr.index, bits);
	x86_emit_reg_to_mem_addr(&g.em, store_op, src_reg_gpr, addr_reg);
};

fn x86_ir_float_bin_op(is_f32: bool, aux: u16) str = {
	if (aux == IR_BIN_ADD) {
		if (is_f32) { return "addss"; };
		return "addsd";
	};
	if (aux == IR_BIN_SUB) {
		if (is_f32) { return "subss"; };
		return "subsd";
	};
	if (aux == IR_BIN_MUL) {
		if (is_f32) { return "mulss"; };
		return "mulsd";
	};
	if (aux == IR_BIN_DIV) {
		if (is_f32) { return "divss"; };
		return "divsd";
	};
	return "";
};

fn x86_ir_int_bin_op(aux: u16) str = {
	if (aux == IR_BIN_ADD) { return "addq"; };
	if (aux == IR_BIN_SUB) { return "subq"; };
	if (aux == IR_BIN_MUL) { return "imulq"; };
	if (aux == IR_BIN_AND) { return "andq"; };
	if (aux == IR_BIN_OR) { return "orq"; };
	if (aux == IR_BIN_XOR) { return "xorq"; };
	return "";
};

fn x86_ir_emit_call(ctx: *x86_ctx, op: ir_op) void = {
	let g = ctx.g;
	let f_call: *ir_func = &ctx.ir.funcs[ctx.fn_index];
	let skip_phys_call = phys_reg { class = 0, index = 0, lane = 0 };
	if (op.dst.ty != IR_T_INVALID) { skip_phys_call = x86_ir_find_alloc(ctx, op.dst.id); };
	x86_ir_save_call_clobbered(ctx, f_call, skip_phys_call);

	let arg_int_regs: [6]u8 = [5, 4, 3, 2, 8, 9]; // rdi, rsi, rdx, rcx, r8, r9
	let arg_float_regs: [8]u8 = [0, 1, 2, 3, 4, 5, 6, 7];
	let arg_int_idx: size = 0;
	let arg_float_idx: size = 0;
	let int_move_src: [6]u8 = [0...];
	let int_move_dst: [6]u8 = [0...];
	let int_move_op: [6]str = [""...];
	let int_move_src_bits: [6]u8 = [0...];
	let int_move_dst_bits: [6]u8 = [0...];
	let int_move_done: [6]u8 = [0...];
	let int_move_count: size = 0;
	let int_spill_off: [6]i64 = [0...];
	let int_spill_dst: [6]u8 = [0...];
	let int_spill_op: [6]str = [""...];
	let int_spill_dst_bits: [6]u8 = [0...];
	let int_spill_count: size = 0;
	let float_move_src: [8]u8 = [0...];
	let float_move_dst: [8]u8 = [0...];
	let float_move_op: [8]str = [""...];
	let float_move_done: [8]u8 = [0...];
	let float_move_count: size = 0;
	let float_spill_off: [8]i64 = [0...];
	let float_spill_dst: [8]u8 = [0...];
	let float_spill_op: [8]str = [""...];
	let float_spill_count: size = 0;
	let arg_i = 0z;
	for (arg_i < op.arg_count) {
		let arg_v = ctx.ir.args[op.arg_start + arg_i];
		let arg_use_xmm = x86_ir_use_xmm(arg_v.ty, arg_v.width);
		if (arg_use_xmm) {
			if (arg_float_idx < len(arg_float_regs)) {
				let dst_idx_f = arg_float_regs[arg_float_idx];
				let src_phys_f = x86_ir_find_alloc(ctx, arg_v.id);
				let mov_op_f = x86_ir_xmm_move_op(arg_v.ty, arg_v.width);
				if (src_phys_f.class == REG_SPILL) {
					if (float_spill_count < len(float_spill_off)) {
						float_spill_off[float_spill_count] = x86_ir_spill_offset(ctx, arg_v.id);
						float_spill_dst[float_spill_count] = dst_idx_f;
						float_spill_op[float_spill_count] = mov_op_f;
						float_spill_count += 1;
					};
				} else if (src_phys_f.index != dst_idx_f) {
					if (float_move_count < len(float_move_src)) {
						float_move_src[float_move_count] = src_phys_f.index;
						float_move_dst[float_move_count] = dst_idx_f;
						float_move_op[float_move_count] = mov_op_f;
						float_move_count += 1;
					};
				};
			};
			arg_float_idx += 1;
		} else {
			if (arg_int_idx < len(arg_int_regs)) {
				let dst_idx_i = arg_int_regs[arg_int_idx];
				let src_phys_i = x86_ir_find_alloc(ctx, arg_v.id);
				let load_op_i = x86_ir_gpr_load_op(arg_v.ty);
				let src_bits_i = x86_ir_gpr_bits(arg_v.ty);
				let dst_bits_i: u8 = 64;
				if (load_op_i == "movl") { dst_bits_i = 32; };
				if (src_phys_i.class == REG_SPILL) {
					if (int_spill_count < len(int_spill_off)) {
						int_spill_off[int_spill_count] = x86_ir_spill_offset(ctx, arg_v.id);
						int_spill_dst[int_spill_count] = dst_idx_i;
						int_spill_op[int_spill_count] = load_op_i;
						int_spill_dst_bits[int_spill_count] = dst_bits_i;
						int_spill_count += 1;
					};
				} else if (!(src_phys_i.index == dst_idx_i && load_op_i == "movq")) {
					if (int_move_count < len(int_move_src)) {
						int_move_src[int_move_count] = src_phys_i.index;
						int_move_dst[int_move_count] = dst_idx_i;
						int_move_op[int_move_count] = load_op_i;
						int_move_src_bits[int_move_count] = src_bits_i;
						int_move_dst_bits[int_move_count] = dst_bits_i;
						int_move_count += 1;
					};
				};
			};
			arg_int_idx += 1;
		};
		arg_i += 1;
	};

	// Resolve integer register moves without clobbering sources.
	let int_remaining = int_move_count;
	for (int_remaining > 0) {
		let progressed = false;
		let mi = 0z;
		for (mi < int_move_count) {
			if (int_move_done[mi] != 0u8) { mi += 1; continue; };
			let dst = int_move_dst[mi];
			let dst_is_src = false;
			let mj = 0z;
			for (mj < int_move_count) {
				if (int_move_done[mj] != 0u8) { mj += 1; continue; };
				if (int_move_src[mj] == dst) { dst_is_src = true; break; };
				mj += 1;
			};
			if (!dst_is_src) {
				let src_reg_move = x86_gpr_name(int_move_src[mi], int_move_src_bits[mi]);
				let dst_reg_move = x86_gpr_name(int_move_dst[mi], int_move_dst_bits[mi]);
				x86_emit_reg_reg(&g.em, int_move_op[mi], src_reg_move, dst_reg_move);
				int_move_done[mi] = 1u8;
				int_remaining -= 1;
				progressed = true;
			};
			mi += 1;
		};
		if (progressed) { continue; };
		// Cycle: spill one source into scratch and retry.
		let pick = 0z;
		let found = false;
		for (pick < int_move_count) {
			if (int_move_done[pick] == 0u8) { found = true; break; };
			pick += 1;
		};
		if (!found) { break; };
		let scratch_idx = X86_SCRATCH_GPR0;
		let src_reg_cycle = x86_gpr_name(int_move_src[pick], int_move_src_bits[pick]);
		let scratch_bits: u8 = 64;
		if (int_move_op[pick] == "movl") { scratch_bits = 32; };
		let scratch_reg_cycle = x86_gpr_name(scratch_idx, scratch_bits);
		x86_emit_reg_reg(&g.em, int_move_op[pick], src_reg_cycle, scratch_reg_cycle);
		int_move_src[pick] = scratch_idx;
	};

	// Resolve float register moves without clobbering sources.
	let float_remaining = float_move_count;
	for (float_remaining > 0) {
		let progressed_f = false;
		let fi = 0z;
		for (fi < float_move_count) {
			if (float_move_done[fi] != 0u8) { fi += 1; continue; };
			let dstf = float_move_dst[fi];
			let dst_is_src_f = false;
			let fj = 0z;
			for (fj < float_move_count) {
				if (float_move_done[fj] != 0u8) { fj += 1; continue; };
				if (float_move_src[fj] == dstf) { dst_is_src_f = true; break; };
				fj += 1;
			};
			if (!dst_is_src_f) {
				let src_reg_f_move = x86_xmm_name(float_move_src[fi]);
				let dst_reg_f_move = x86_xmm_name(float_move_dst[fi]);
				x86_emit_reg_reg(&g.em, float_move_op[fi], src_reg_f_move, dst_reg_f_move);
				float_move_done[fi] = 1u8;
				float_remaining -= 1;
				progressed_f = true;
			};
			fi += 1;
		};
		if (progressed_f) { continue; };
		// Cycle: spill one source into scratch XMM and retry.
		let pickf = 0z;
		let foundf = false;
		for (pickf < float_move_count) {
			if (float_move_done[pickf] == 0u8) { foundf = true; break; };
			pickf += 1;
		};
		if (!foundf) { break; };
		let src_reg_f_cycle = x86_xmm_name(float_move_src[pickf]);
		let scratch_reg_f_cycle = x86_xmm_name(X86_SCRATCH_XMM);
		x86_emit_reg_reg(&g.em, float_move_op[pickf], src_reg_f_cycle, scratch_reg_f_cycle);
		float_move_src[pickf] = X86_SCRATCH_XMM;
	};

	// Load spilled arguments after register shuffles to avoid clobbering sources.
	let si = 0z;
	for (si < int_spill_count) {
		let spill_dst_reg = x86_gpr_name(int_spill_dst[si], int_spill_dst_bits[si]);
		x86_emit_mem_to_reg(&g.em, int_spill_op[si], int_spill_off[si], spill_dst_reg);
		si += 1;
	};
	let sf = 0z;
	for (sf < float_spill_count) {
		let spill_dst_reg_f = x86_xmm_name(float_spill_dst[sf]);
		x86_emit_mem_to_reg(&g.em, float_spill_op[sf], float_spill_off[sf], spill_dst_reg_f);
		sf += 1;
	};

	let did_pad_call = x86_align_for_call(ctx);
	x86_ir_emit_call_target(ctx, op);
	x86_unalign_after_call(ctx, did_pad_call);

	if (op.dst.ty != IR_T_INVALID) {
		if (x86_ir_use_xmm(op.dst.ty, op.dst.width)) {
			x86_ir_emit_call_ret_float(ctx, op.dst);
		} else {
			x86_ir_emit_call_ret_int(ctx, op.dst);
		};
	};

	x86_ir_restore_call_clobbered(ctx, f_call, skip_phys_call);
};

fn x86_ir_emit_op(ctx: *x86_ctx, op: ir_op, label_map: *[*]i64, label_cap: size) void = {
	let g = ctx.g;
	if (op.kind == IR_OP_CONST) {
		if (op.dst.ty == IR_T_INVALID) { return; };
		if (op.dst.ty == IR_T_F32 || op.dst.ty == IR_T_F64) {
			let const_dst_phys = x86_ir_find_alloc(ctx, op.dst.id);
			let const_dst_use = const_dst_phys;
			if (const_dst_phys.class == REG_SPILL) {
				let const_cls: u16 = REG_XMM_SCALAR_F64;
				if (op.dst.ty == IR_T_F32) { const_cls = REG_XMM_SCALAR_F32; };
				if (op.dst.width > 1) { const_cls = x86_ir_vec_class(op.dst.ty, op.dst.width); };
				const_dst_use = phys_reg { class = const_cls, index = X86_SCRATCH_XMM, lane = 0 };
			};
			let const_dst_reg = x86_xmm_name(const_dst_use.index);
			x86_emit_float_literal_to(ctx, op.sym, op.dst.ty == IR_T_F32, const_dst_reg);
			if (const_dst_phys.class == REG_SPILL) { x86_ir_store_xmm_phys(ctx, op.dst, const_dst_use); };
		} else {
			let const_phys = x86_ir_find_alloc(ctx, op.dst.id);
			if (const_phys.class == REG_SPILL) {
				let const_spill = phys_reg { class = REG_GPR64, index = X86_SCRATCH_GPR1, lane = 0 };
				if (op.imm == 0) {
					x86_emit_zero_gpr(&g.em, const_spill.index);
				} else {
					let const_reg_imm = x86_gpr_name(const_spill.index, 64);
					x86_emit_mov_imm(&g.em, const_reg_imm, op.imm);
				};
				x86_ir_store_gpr_phys(ctx, op.dst, const_spill);
			} else {
				let const_reg = x86_ir_reg_name(const_phys);
				if (op.imm == 0) {
					x86_emit_zero_gpr(&g.em, const_phys.index);
				} else {
					x86_emit_mov_imm(&g.em, const_reg, op.imm);
				};
			};
		};
		return;
	};
	if (op.kind == IR_OP_CAST) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID) { return; };
		x86_ir_emit_cast(ctx, op);
		return;
	};
	if (op.kind == IR_OP_COPY) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID) { return; };
		if (X86_VEC_DEBUG != 0 && op.aux != 0) {
			emit_s(&g.em, "# vec_pack_reuse=");
			e_i(&g.em, op.aux: i64);
			emit_s(&g.em, " dst=");
			e_i(&g.em, op.dst.id: i64);
			emit_s(&g.em, " src=");
			e_i(&g.em, op.a.id: i64);
			e_nl(&g.em);
		};
		if (x86_ir_use_xmm(op.dst.ty, op.dst.width)) {
			let copy_src_phys_float = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
			x86_ir_store_xmm_phys(ctx, op.dst, copy_src_phys_float);
		} else {
			let copy_src_phys_int = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR1);
			x86_ir_store_gpr_phys(ctx, op.dst, copy_src_phys_int);
		};
		return;
	};
	if (op.kind == IR_OP_PACK) {
		if (op.dst.ty == IR_T_INVALID) { return; };
		x86_ir_emit_pack(ctx, op);
		return;
	};
	if (op.kind == IR_OP_UNPACK) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID) { return; };
		x86_ir_emit_unpack(ctx, op);
		return;
	};
	if (op.kind == IR_OP_ADDR) {
		let addr_dst_phys = x86_ir_find_alloc(ctx, op.dst.id);
		let addr_dst_use = addr_dst_phys;
		if (addr_dst_phys.class == REG_SPILL) { addr_dst_use = phys_reg { class = REG_GPR64, index = X86_SCRATCH_GPR1, lane = 0 }; };
		let addr_dst_reg = x86_gpr_name(addr_dst_use.index, 64);
		let addr_off = x86_local_offset(g, op.sym);
		if (addr_off != 0) {
			emit_s(&g.em, "\tleaq -");
			e_i(&g.em, addr_off);
			emit_s(&g.em, "(%rbp), %");
			emit_s(&g.em, addr_dst_reg);
			e_nl(&g.em);
		} else if (dict_get_bref(&g.globals, op.sym) != 0) {
			emit_s(&g.em, "\tleaq ");
			emit_s(&g.em, bref_to_str(op.sym, g.t.src));
			emit_s(&g.em, "(%rip), %");
			emit_s(&g.em, addr_dst_reg);
			e_nl(&g.em);
		} else {
			err_bref(op.sym, g.t.src, g.t.src_len, "unknown address in x86_64 backend");
		};
		if (addr_dst_phys.class == REG_SPILL) { x86_ir_store_gpr_phys(ctx, op.dst, addr_dst_use); };
		return;
	};
	if (op.kind == IR_OP_LOAD) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID) { return; };
		let load_base_phys = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR0);
		let load_addr_reg = x86_gpr_name(load_base_phys.index, 64);
		if (op.imm != 0) {
			emit_s(&g.em, "\taddq $");
			e_i(&g.em, op.imm);
			emit_s(&g.em, ", %");
			emit_s(&g.em, load_addr_reg);
			e_nl(&g.em);
		};
		x86_ir_emit_load_from_addr(ctx, op.dst, load_addr_reg);
		return;
	};
	if (op.kind == IR_OP_STORE) {
		if (op.a.ty == IR_T_INVALID || op.b.ty == IR_T_INVALID) { return; };
		let store_base_phys = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR0);
		let store_addr_reg = x86_gpr_name(store_base_phys.index, 64);
		if (op.imm != 0) {
			emit_s(&g.em, "\taddq $");
			e_i(&g.em, op.imm);
			emit_s(&g.em, ", %");
			emit_s(&g.em, store_addr_reg);
			e_nl(&g.em);
		};
		x86_ir_emit_store_to_addr(ctx, op.b, store_addr_reg);
		return;
	};
	if (op.kind == IR_OP_UN) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID) { return; };
		if (op.dst.ty == IR_T_F32 || op.dst.ty == IR_T_F64) {
			let un_dst_use = x86_ir_xmm_dst_use(ctx, op.dst, X86_SCRATCH_XMM);
			let un_src_phys = x86_ir_load_xmm_phys(ctx, op.a, un_dst_use.index);
			if (!x86_ir_same_reg(un_dst_use, un_src_phys)) {
				let un_dst_reg = x86_xmm_name(un_dst_use.index);
				let un_src_reg = x86_xmm_name(un_src_phys.index);
				x86_emit_reg_reg(&g.em, x86_ir_xmm_move_op(op.dst.ty, op.dst.width), un_src_reg, un_dst_reg);
			};
			if (op.aux == IR_UN_NEG) {
				let un_mask_id = x86_emit_sign_mask(ctx, op.dst.ty == IR_T_F32);
				let un_dst_reg2 = x86_xmm_name(un_dst_use.index);
				emit_s(&g.em, "\t");
				if (op.dst.ty == IR_T_F32) {
					emit_s(&g.em, "xorps .L");
				} else {
					emit_s(&g.em, "xorpd .L");
				};
				e_i(&g.em, un_mask_id);
				emit_s(&g.em, "(%rip), %");
				emit_s(&g.em, un_dst_reg2);
				e_nl(&g.em);
			};
			x86_ir_store_xmm_phys(ctx, op.dst, un_dst_use);
		} else {
			let un_i_dst_use = x86_ir_gpr_dst_use(ctx, op.dst, X86_SCRATCH_GPR1);
			let un_i_src_phys = x86_ir_load_gpr_phys(ctx, op.a, un_i_dst_use.index);
			let un_i_dst = x86_gpr_name(un_i_dst_use.index, 64);
			let un_i_src = x86_gpr_name(un_i_src_phys.index, 64);
			if (!x86_ir_same_reg(un_i_dst_use, un_i_src_phys)) { x86_emit_reg_reg(&g.em, "movq", un_i_src, un_i_dst); };
			if (op.aux == IR_UN_NEG) { x86_emit_reg(&g.em, "negq", un_i_dst); }
			else if (op.aux == IR_UN_NOT) {
				x86_ir_emit_cmp_zero(&g.em, un_i_dst);
				let un_i_dst8 = x86_gpr_name(un_i_dst_use.index, 8);
				emit_s(&g.em, "\tsete %");
				emit_s(&g.em, un_i_dst8);
				e_nl(&g.em);
				emit_s(&g.em, "\tmovzbq %");
				emit_s(&g.em, un_i_dst8);
				emit_s(&g.em, ", %");
				emit_s(&g.em, un_i_dst);
				e_nl(&g.em);
			} else if (op.aux == IR_UN_BITNOT) {
				x86_emit_reg(&g.em, "notq", un_i_dst);
			};
			x86_ir_store_gpr_phys(ctx, op.dst, un_i_dst_use);
		};
		return;
	};
	if (op.kind == IR_OP_BIN) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID || op.b.ty == IR_T_INVALID) { return; };
		let bin_is_float = op.a.ty == IR_T_F32 || op.a.ty == IR_T_F64;
		if (bin_is_float) {
			let bin_is_f32 = op.a.ty == IR_T_F32;
			let bin_is_vec = op.dst.width > 1;
			let bin_dst_use = x86_ir_xmm_dst_use(ctx, op.dst, X86_SCRATCH_XMM);
			let bin_lhs_phys = x86_ir_load_xmm_phys(ctx, op.a, bin_dst_use.index);
			if (!x86_ir_same_reg(bin_dst_use, bin_lhs_phys)) {
				let bin_op_move = x86_ir_xmm_move_op(op.a.ty, op.a.width);
				x86_emit_reg_reg(&g.em, bin_op_move, x86_xmm_name(bin_lhs_phys.index), x86_xmm_name(bin_dst_use.index));
			};
			let bin_rhs_phys = x86_ir_find_alloc(ctx, op.b.id);
			if (bin_rhs_phys.class == REG_SPILL) {
				let bin_off = x86_ir_spill_offset(ctx, op.b.id);
				let bin_op_name_spill = "";
				if (bin_is_vec) { bin_op_name_spill = x86_ir_vec_bin_op(op.a.ty, op.aux); }
				else { bin_op_name_spill = x86_ir_float_bin_op(bin_is_f32, op.aux); };
				if (bin_op_name_spill == "") { return; };
				x86_emit_mem_to_reg(&g.em, bin_op_name_spill, bin_off, x86_xmm_name(bin_dst_use.index));
			} else {
				let bin_rhs_use = bin_rhs_phys;
				if (x86_ir_same_reg(bin_rhs_use, bin_dst_use) && op.a.id != op.b.id) {
					let rhs_mov_op = x86_ir_xmm_move_op(op.b.ty, op.b.width);
					x86_emit_reg_reg(&g.em, rhs_mov_op, x86_xmm_name(bin_rhs_phys.index), x86_xmm_name(X86_SCRATCH_XMM));
					bin_rhs_use = phys_reg { class = bin_rhs_phys.class, index = X86_SCRATCH_XMM, lane = 0 };
				};
				let bin_rhs_reg = x86_xmm_name(bin_rhs_use.index);
				let bin_dst_reg = x86_xmm_name(bin_dst_use.index);
				if (bin_is_vec) {
					let bin_vec_op = x86_ir_vec_bin_op(op.a.ty, op.aux);
					if (bin_vec_op != "") { x86_emit_reg_reg(&g.em, bin_vec_op, bin_rhs_reg, bin_dst_reg); };
				} else {
					let bin_op_name_reg = x86_ir_float_bin_op(bin_is_f32, op.aux);
					if (bin_op_name_reg == "") { return; };
					x86_emit_reg_reg(&g.em, bin_op_name_reg, bin_rhs_reg, bin_dst_reg);
				};
			};
			x86_ir_store_xmm_phys(ctx, op.dst, bin_dst_use);
		} else {
			if (op.dst.width > 1) {
				let vec_op = x86_ir_vec_bin_op(op.dst.ty, op.aux);
				if (vec_op == "") { return; };
				let vec_dst_use = x86_ir_xmm_dst_use(ctx, op.dst, X86_SCRATCH_XMM);
				let vec_lhs_phys = x86_ir_load_xmm_phys(ctx, op.a, vec_dst_use.index);
				if (!x86_ir_same_reg(vec_dst_use, vec_lhs_phys)) {
					let vec_mov = x86_ir_xmm_move_op(op.a.ty, op.a.width);
					x86_emit_reg_reg(&g.em, vec_mov, x86_xmm_name(vec_lhs_phys.index), x86_xmm_name(vec_dst_use.index));
				};
				let vec_rhs_phys = x86_ir_find_alloc(ctx, op.b.id);
				if (vec_rhs_phys.class == REG_SPILL) {
					let vec_off = x86_ir_spill_offset(ctx, op.b.id);
					x86_emit_mem_to_reg(&g.em, vec_op, vec_off, x86_xmm_name(vec_dst_use.index));
				} else {
					let vec_rhs_use = vec_rhs_phys;
					if (x86_ir_same_reg(vec_rhs_use, vec_dst_use) && op.a.id != op.b.id) {
						let vec_rhs_mov_op = x86_ir_xmm_move_op(op.b.ty, op.b.width);
						x86_emit_reg_reg(&g.em, vec_rhs_mov_op, x86_xmm_name(vec_rhs_phys.index), x86_xmm_name(X86_SCRATCH_XMM));
						vec_rhs_use = phys_reg { class = vec_rhs_phys.class, index = X86_SCRATCH_XMM, lane = 0 };
					};
					let vec_rhs_reg = x86_xmm_name(vec_rhs_use.index);
					let vec_dst_reg = x86_xmm_name(vec_dst_use.index);
					x86_emit_reg_reg(&g.em, vec_op, vec_rhs_reg, vec_dst_reg);
				};
				x86_ir_store_xmm_phys(ctx, op.dst, vec_dst_use);
				return;
			};
			if (op.aux == IR_BIN_DIV || op.aux == IR_BIN_MOD) {
				let div_lhs_phys = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR_DIV);
				if (div_lhs_phys.index != X86_SCRATCH_GPR_DIV) {
					x86_emit_reg_reg(&g.em, "movq", x86_gpr_name(div_lhs_phys.index, 64), x86_gpr_name(X86_SCRATCH_GPR_DIV, 64));
				};
				let div_rhs_phys = x86_ir_load_gpr_phys(ctx, op.b, X86_SCRATCH_GPR0);
				let div_rhs_reg = x86_gpr_name(div_rhs_phys.index, 64);
				x86_emit_ins(&g.em, "cqo");
				x86_emit_reg(&g.em, "idivq", div_rhs_reg);
				let div_res_idx: u8 = X86_SCRATCH_GPR_DIV;
				if (op.aux == IR_BIN_MOD) { div_res_idx = X86_SCRATCH_GPR_DIVHI; };
				let div_res_phys = phys_reg { class = REG_GPR64, index = div_res_idx, lane = 0 };
				x86_ir_store_gpr_phys(ctx, op.dst, div_res_phys);
				return;
			};
			if (op.aux == IR_BIN_SHL || op.aux == IR_BIN_SHR) {
				let shift_dst_use = x86_ir_gpr_dst_use(ctx, op.dst, X86_SCRATCH_GPR1);
				let shift_lhs_phys = x86_ir_load_gpr_phys(ctx, op.a, shift_dst_use.index);
				let shift_dst_reg = x86_gpr_name(shift_dst_use.index, 64);
				let shift_lhs_reg = x86_gpr_name(shift_lhs_phys.index, 64);
				if (!x86_ir_same_reg(shift_dst_use, shift_lhs_phys)) { x86_emit_reg_reg(&g.em, "movq", shift_lhs_reg, shift_dst_reg); };
				let shift_rhs_phys = x86_ir_load_gpr_phys(ctx, op.b, X86_SCRATCH_GPR0);
				let shift_rhs_reg = x86_gpr_name(shift_rhs_phys.index, 64);
				if (shift_rhs_phys.index != X86_SCRATCH_GPR_CNT) {
					x86_emit_reg_reg(&g.em, "movq", shift_rhs_reg, x86_gpr_name(X86_SCRATCH_GPR_CNT, 64));
				};
				emit_s(&g.em, "\t");
				if (op.aux == IR_BIN_SHL) { emit_s(&g.em, "shlq %cl, %"); }
				else { emit_s(&g.em, "shrq %cl, %"); };
				emit_s(&g.em, shift_dst_reg);
				e_nl(&g.em);
				x86_ir_store_gpr_phys(ctx, op.dst, shift_dst_use);
				return;
			};
			let bin_i_dst_use = x86_ir_gpr_dst_use(ctx, op.dst, X86_SCRATCH_GPR1);
			let bin_i_lhs_phys = x86_ir_load_gpr_phys(ctx, op.a, bin_i_dst_use.index);
			let bin_i_rhs_phys = x86_ir_load_gpr_phys(ctx, op.b, X86_SCRATCH_GPR0);
			let bin_i_dst_reg = x86_gpr_name(bin_i_dst_use.index, 64);
			let bin_i_lhs_reg = x86_gpr_name(bin_i_lhs_phys.index, 64);
			let bin_i_rhs_reg = x86_gpr_name(bin_i_rhs_phys.index, 64);
			if (!x86_ir_same_reg(bin_i_dst_use, bin_i_lhs_phys)) { x86_emit_reg_reg(&g.em, "movq", bin_i_lhs_reg, bin_i_dst_reg); };
			let bin_op_i = x86_ir_int_bin_op(op.aux);
			if (bin_op_i == "") { return; };
			x86_emit_reg_reg(&g.em, bin_op_i, bin_i_rhs_reg, bin_i_dst_reg);
			x86_ir_store_gpr_phys(ctx, op.dst, bin_i_dst_use);
		};
		return;
	};
	if (op.kind == IR_OP_CMP) {
		if (op.dst.ty == IR_T_INVALID || op.a.ty == IR_T_INVALID || op.b.ty == IR_T_INVALID) { return; };
		let cmp_is_float = op.a.ty == IR_T_F32 || op.a.ty == IR_T_F64;
		if (cmp_is_float) {
			let cmp_lhs_phys = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
			let cmp_lhs_reg = x86_xmm_name(cmp_lhs_phys.index);
			let cmp_rhs_phys = x86_ir_find_alloc(ctx, op.b.id);
			if (cmp_rhs_phys.class == REG_SPILL) {
				let cmp_off = x86_ir_spill_offset(ctx, op.b.id);
				if (op.a.ty == IR_T_F32) { x86_emit_mem_to_reg(&g.em, "ucomiss", cmp_off, cmp_lhs_reg); }
				else { x86_emit_mem_to_reg(&g.em, "ucomisd", cmp_off, cmp_lhs_reg); };
			} else {
				let cmp_rhs_reg = x86_xmm_name(cmp_rhs_phys.index);
				if (op.a.ty == IR_T_F32) { x86_emit_reg_reg(&g.em, "ucomiss", cmp_rhs_reg, cmp_lhs_reg); }
				else { x86_emit_reg_reg(&g.em, "ucomisd", cmp_rhs_reg, cmp_lhs_reg); };
			};
		} else {
			let cmp_lhs_phys_int = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR1);
			let cmp_rhs_phys_int = x86_ir_load_gpr_phys(ctx, op.b, X86_SCRATCH_GPR0);
			let cmp_lhs_reg_int = x86_gpr_name(cmp_lhs_phys_int.index, 64);
			let cmp_rhs_reg_int = x86_gpr_name(cmp_rhs_phys_int.index, 64);
			x86_emit_reg_reg(&g.em, "cmpq", cmp_rhs_reg_int, cmp_lhs_reg_int);
		};
		let cmp_dst_phys = x86_ir_find_alloc(ctx, op.dst.id);
		let cmp_dst_idx: u8 = cmp_dst_phys.index;
		if (cmp_dst_phys.class == REG_SPILL) { cmp_dst_idx = X86_SCRATCH_GPR1; };
		let cmp_dst8 = x86_gpr_name(cmp_dst_idx, 8);
		let cmp_dst64 = x86_gpr_name(cmp_dst_idx, 64);
		if (op.aux == IR_CMP_EQ) { emit_s(&g.em, "\tsete %"); }
		else if (op.aux == IR_CMP_NE) { emit_s(&g.em, "\tsetne %"); }
		else if (op.aux == IR_CMP_LT) {
			if (cmp_is_float) { emit_s(&g.em, "\tsetb %"); }
			else { emit_s(&g.em, "\tsetl %"); };
		}
		else if (op.aux == IR_CMP_LE) {
			if (cmp_is_float) { emit_s(&g.em, "\tsetbe %"); }
			else { emit_s(&g.em, "\tsetle %"); };
		}
		else if (op.aux == IR_CMP_GT) {
			if (cmp_is_float) { emit_s(&g.em, "\tseta %"); }
			else { emit_s(&g.em, "\tsetg %"); };
		}
		else if (op.aux == IR_CMP_GE) {
			if (cmp_is_float) { emit_s(&g.em, "\tsetae %"); }
			else { emit_s(&g.em, "\tsetge %"); };
		};
		emit_s(&g.em, cmp_dst8);
		e_nl(&g.em);
		emit_s(&g.em, "\tmovzbq %");
		emit_s(&g.em, cmp_dst8);
		emit_s(&g.em, ", %");
		emit_s(&g.em, cmp_dst64);
		e_nl(&g.em);
		if (cmp_dst_phys.class == REG_SPILL) {
			let cmp_dst_use = phys_reg { class = REG_GPR64, index = cmp_dst_idx, lane = 0 };
			x86_ir_store_gpr_phys(ctx, op.dst, cmp_dst_use);
		};
		return;
	};
	if (op.kind == IR_OP_LABEL) {
		let label_id_label = x86_ir_label_id(ctx, label_map, label_cap, op.target);
		x86_emit_label(&g.em, label_id_label);
		return;
	};
	if (op.kind == IR_OP_JUMP) {
		let label_id_jump = x86_ir_label_id(ctx, label_map, label_cap, op.target);
		x86_emit_jmp(&g.em, "jmp", label_id_jump);
		return;
	};
	if (op.kind == IR_OP_BRANCH) {
		let cond_phys_br = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR1);
		let cond_br = x86_gpr_name(cond_phys_br.index, 64);
		x86_ir_emit_cmp_zero(&g.em, cond_br);
		let t_label_br = x86_ir_label_id(ctx, label_map, label_cap, op.target);
		let f_label_br = x86_ir_label_id(ctx, label_map, label_cap, op.target2);
		x86_emit_jmp(&g.em, "jne", t_label_br);
		x86_emit_jmp(&g.em, "jmp", f_label_br);
		return;
	};
	if (op.kind == IR_OP_CALL) {
		if (op.aux == IR_CALL_ABORT_FIXED) { x86_ir_emit_call_abort_fixed(ctx, op); }
		else { x86_ir_emit_call(ctx, op); };
		return;
	};
	if (op.kind == IR_OP_RET) {
		if (op.a.ty != IR_T_INVALID) {
				if (x86_ir_use_xmm(op.a.ty, op.a.width)) {
					let ret_src_phys_xmm = x86_ir_load_xmm_phys(ctx, op.a, X86_SCRATCH_XMM);
					let ret_src_xmm = x86_xmm_name(ret_src_phys_xmm.index);
					if (ret_src_xmm != "xmm0") {
						let ret_mov_op = x86_ir_xmm_move_op(op.a.ty, op.a.width);
						x86_emit_reg_reg(&g.em, ret_mov_op, ret_src_xmm, "xmm0");
					};
				} else {
					let ret_src_phys_gpr = x86_ir_load_gpr_phys(ctx, op.a, X86_SCRATCH_GPR_DIV);
					let ret_src_gpr = x86_gpr_name(ret_src_phys_gpr.index, 64);
					if (ret_src_gpr != "rax") { x86_emit_reg_reg(&g.em, "movq", ret_src_gpr, "rax"); };
				};
		};
		x86_emit_jmp(&g.em, "jmp", ctx.ret_label);
		return;
	};
};

fn x86_emit_ir_body(ctx: *x86_ctx, f: *ir_func) void = {
	if (ctx.ir == null || ctx.virt == null) { return; };
	let label_map: [256]i64 = [0...];
	let label_cap = len(label_map);
	x86_ir_bind_params(ctx, f);
	match (ctx.sched) {
	case let sched: *virt_func_sched =>
		let i = 0z;
		for (i < sched.op_count) {
			let ord_idx = ctx.virt.order[sched.op_start + i];
			let vop = ctx.virt.ops[ord_idx: size];
			let op_sched = ctx.ir.ops[vop.op_index: size];
			x86_ir_emit_op(ctx, op_sched, (&label_map[0]): *[*]i64, label_cap);
			i += 1;
		};
	case null =>
		let j = 0z;
		for (j < f.ops_len) {
			let op_seq = ctx.ir.ops[f.ops_start + j];
			x86_ir_emit_op(ctx, op_seq, (&label_map[0]): *[*]i64, label_cap);
			j += 1;
		};
	};
};

fn x86_new_label(ctx: *x86_ctx) i64 = {
	ctx.label_id += 1;
	return ctx.label_id;
};

fn x86_eval_push(stack: *[*]x86_eval_frame, sp: *size, node: *tnode, want_addr: bool) void = {
	if (*sp >= 512: size) { abort("x86_eval stack overflow"); };
	stack[*sp] = x86_eval_frame {
		node = node,
		state = 0,
		want_addr = want_addr,
		use_float = false,
		float_is_f32 = false,
		lhs_is_float = false,
		rhs_is_float = false,
		target_is_float = false,
		cast_from_tagged = false,
		cast_payload_ty = null,
		base_is_ptr = false,
		field_deref = 0,
		field_off = 0,
		field_ty = null,
		init_node = null,
		arg_count = 0,
		arg_index = 0,
		arg_nodes = [0...],
		arg_is_float = [false...],
		arg_kind = [0...],
		arg_slots = [0...],
		arg_scratch = [0...],
		arg_expected = [0...],
		scratch_next = 0,
		call_scratch_base = 0,
		idx_is_slice = false,
		idx_is_ptr_slice = false,
		idx_is_ptr_uarr = false,
		idx_deref = 0,
		idx_elem_size = 0,
		idx_elem_ty = null,
		slice_kind = 0,
		slice_elem_ty = null,
		slice_base_len = 0,
	};
	*sp += 1;
};

fn x86_stmt_push(stack: *[*]x86_stmt_frame, sp: *size, node: *tnode) void = {
	if (*sp >= 256: size) { abort("x86_stmt stack overflow"); };
	stack[*sp] = x86_stmt_frame {
		node = node,
		state = 0,
		label1 = 0,
		label2 = 0,
		label3 = 0,
		node1 = null,
		node2 = null,
		node3 = null,
		case_count = 0,
		case_index = 0,
		case_nodes = [0...],
		case_labels = [0...],
		default_label = 0,
		match_is_nullable = false,
		match_is_tagged = false,
		match_tagged_ty = null,
		match_bind_active = false,
		match_bind_ref = bref_empty(),
		match_bind_saved = 0,
	};
	*sp += 1;
};


fn x86_global_parts(n: *tnode, out_ty: *nullable *tnode, out_init: *nullable *tnode) void = {
	let child = t_first(n);
	*out_ty = null;
	*out_init = null;
	match (child) {
	case let c: *tnode =>
		if (is_type_kind(c.kind)) {
			*out_ty = c;
			*out_init = c.next;
		} else {
			*out_init = c;
		};
	case null => void;
	};
};

fn x86_global_struct_type(g: *codegen, name: bref) nullable *tnode = {
	let glob_ptr = dict_get_bref(&g.globals, name);
	let gnode: nullable *tnode = null;
	if (glob_ptr != 0) {
		gnode = glob_ptr: uintptr: *tnode;
	} else {
		let unit = t_first(g.t.root);
		let decl = unit;
		for (decl != null) {
			let d: *tnode = unwrap(decl);
			if ((d.kind == N_GLOBAL || d.kind == N_DEF) && bref_eq(d.ref, name, g.t.src)) {
				gnode = d;
				break;
			};
			decl = d.next;
		};
	};
	if (gnode == null) { return null; };
	let gnode_val: *tnode = unwrap(gnode);
	if (gnode_val.kind != N_GLOBAL && gnode_val.kind != N_DEF) { return null; };
	let gty: nullable *tnode = null;
	let ginit: nullable *tnode = null;
	x86_global_parts(gnode_val, &gty, &ginit);
	if (gty != null) {
		let gty_res = resolve_alias_type(g, unwrap(gty));
		if (gty_res != null && unwrap(gty_res).kind == N_T_STRUCT) { return gty_res; };
	};
	if (ginit != null && unwrap(ginit).kind == N_STRUCT_LIT) {
		let type_ptr = dict_get_bref(&g.types, unwrap(ginit).ref);
		if (type_ptr != 0) { return type_ptr: uintptr: *tnode; };
	};
	return null;
};

fn x86_static_add(ctx: *x86_ctx, owner: bref, n: *tnode) void = {
	if (ctx.static_count >= 256: size) { return; };
	let ty: nullable *tnode = null;
	let init: nullable *tnode = null;
	x86_global_parts(n, &ty, &init);
	let resolved_ty: nullable *tnode = ty;
	if (resolved_ty == null && init != null) {
		let inferred = get_expr_type(ctx.g, unwrap(init));
		if (inferred != null) { resolved_ty = unwrap(inferred); };
	};
	ctx.static_names[ctx.static_count] = n.ref;
	ctx.static_owner[ctx.static_count] = owner;
	ctx.static_label[ctx.static_count] = x86_new_label(ctx);
	ctx.static_ty[ctx.static_count] = resolved_ty: uintptr;
	ctx.static_init[ctx.static_count] = init: uintptr;
	ctx.static_count += 1;
};

fn x86_static_find(ctx: *x86_ctx, name: bref, owner: bref) i64 = {
	let i = 0z;
	for (i < ctx.static_count) {
		if (bref_eq(ctx.static_names[i], name, ctx.g.t.src) && bref_eq(ctx.static_owner[i], owner, ctx.g.t.src)) {
			return ctx.static_label[i];
		};
		i += 1;
	};
	return 0;
};

fn x86_static_ty(ctx: *x86_ctx, name: bref, owner: bref) nullable *tnode = {
	let i = 0z;
	for (i < ctx.static_count) {
		if (bref_eq(ctx.static_names[i], name, ctx.g.t.src) && bref_eq(ctx.static_owner[i], owner, ctx.g.t.src)) {
			return ctx.static_ty[i]: uintptr: *tnode;
		};
		i += 1;
	};
	return null;
};


fn x86_is_float_ty(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	let r: *tnode = unwrap(resolved);
	if (r.kind != N_T_PRIM) { return false; };
	if (r.ival == TK_F32: i64 || r.ival == TK_F64: i64) { return true; };
	return bref_match(r.ref, "f32", g.t.src) || bref_match(r.ref, "f64", g.t.src);
};

fn x86_type_is_struct(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	return unwrap(resolved).kind == N_T_STRUCT;
};

fn x86_type_is_tagged(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	return unwrap(resolved).kind == N_T_TAGGED;
};

fn x86_type_is_enum(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	return unwrap(resolved).kind == N_T_ENUM;
};

fn x86_type_is_array(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	return unwrap(resolved).kind == N_T_ARR;
};

fn x86_type_is_slice(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	return unwrap(resolved).kind == N_T_SLICE;
};

fn x86_type_is_str(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return false; };
	return type_is_str(unwrap(resolved), g.t.src);
};

fn x86_arg_kind_from_expr(g: *codegen, n: *tnode) u8 = {
	let ty_opt = get_expr_type(g, n);
	if (ty_opt == null) { return X86_ARG_INT; };
	let ty: *tnode = unwrap(ty_opt);
	let resolved = resolve_alias_type(g, ty);
	if (resolved != null) { ty = unwrap(resolved); };
	if (ty.kind == N_T_TAGGED) { return X86_ARG_TAGGED; };
	if (ty.kind == N_T_SLICE) { return X86_ARG_SLICE; };
	if (type_is_str(ty, g.t.src)) { return X86_ARG_STR; };
	if (x86_is_float_ty(g, ty)) { return X86_ARG_FLOAT; };
	return X86_ARG_INT;
};

fn x86_arg_kind_from_type(g: *codegen, ty_in: *tnode) u8 = {
	let ty: *tnode = ty_in;
	let resolved = resolve_alias_type(g, ty);
	if (resolved != null) { ty = unwrap(resolved); };
	if (ty.kind == N_T_TAGGED) { return X86_ARG_TAGGED; };
	if (ty.kind == N_T_SLICE) { return X86_ARG_SLICE; };
	if (type_is_str(ty, g.t.src)) { return X86_ARG_STR; };
	if (x86_is_float_ty(g, ty)) { return X86_ARG_FLOAT; };
	return X86_ARG_INT;
};

fn x86_array_len_from_base(g: *codegen, base_expr: *tnode, out_len: *i64) bool = {
	let base_ty_opt = get_expr_type(g, base_expr);
	if (base_ty_opt == null) { return false; };
	let base_ty: *tnode = unwrap(base_ty_opt);
	let resolved0 = resolve_alias_type(g, base_ty);
	if (resolved0 != null) { base_ty = unwrap(resolved0); };
	if (base_ty.kind == N_T_ARR) {
		return arr_size_literal(base_ty, g.t.src, out_len);
	};
	if (base_ty.kind == N_T_PTR) {
		let walk_ty: *tnode = base_ty;
		for (walk_ty.kind == N_T_PTR) {
			let inner_opt = t_first(walk_ty);
			if (inner_opt == null) { return false; };
			let inner_ty: *tnode = unwrap(inner_opt);
			let resolved1 = resolve_alias_type(g, inner_ty);
			if (resolved1 != null) { inner_ty = unwrap(resolved1); };
			if (inner_ty.kind == N_T_ARR) {
				return arr_size_literal(inner_ty, g.t.src, out_len);
			};
			walk_ty = inner_ty;
		};
	};
	return false;
};

fn x86_emit_bounds_check(ctx: *x86_ctx, base_expr: *tnode, ref: bref) void = {
	let g = ctx.g;
	let bound_len: i64 = 0;
	let ok = x86_array_len_from_base(g, base_expr, &bound_len);
	if (!ok || bound_len <= 0) { return; };
	x86_emit_bounds_check_core(ctx, "", bound_len, false, ref);
};

fn x86_emit_bounds_check_dyn(ctx: *x86_ctx, len_reg: str, ref: bref) void = {
	x86_emit_bounds_check_core(ctx, len_reg, 0, true, ref);
};

fn x86_emit_abort_fixed_at(ctx: *x86_ctx, line: i64, col: i64) void = {
	let g = ctx.g;
	x86_emit_ins(&g.em, "movq $0, %rdi");
	x86_emit_ins_pre_i_suf(&g.em, "movq $", line, ", %rsi");
	x86_emit_ins_pre_i_suf(&g.em, "movq $", col, ", %rdx");
	x86_emit_ins(&g.em, "movq $6, %rcx");
	let did_pad = x86_align_for_call(ctx);
	x86_emit_ins(&g.em, "call rt_abort_fixed");
	x86_unalign_after_call(ctx, did_pad);
};

fn x86_emit_abort_fixed_ref(ctx: *x86_ctx, ref: bref) void = {
	let g = ctx.g;
	let lc = pos_to_line_col(ref.pos, g.t.src, g.t.src_len);
	x86_emit_abort_fixed_at(ctx, lc.line: i64, lc.col: i64);
};

fn x86_emit_bounds_check_core(ctx: *x86_ctx, len_reg: str, bound_len: i64, use_reg: bool, ref: bref) void = {
	let g = ctx.g;
	let oob_label = x86_new_label(ctx);
	let ok_label = x86_new_label(ctx);
	x86_emit_ins(&g.em, "cmpq $0, %rcx");
	x86_emit_jmp(&g.em, "jl", oob_label);
	if (use_reg) {
		emit_s(&g.em, "\tcmpq %");
		emit_s(&g.em, len_reg);
		emit_s(&g.em, ", %rcx");
		e_nl(&g.em);
	} else {
		x86_emit_ins_pre_i_suf(&g.em, "cmpq $", bound_len, ", %rcx");
	};
	x86_emit_jmp(&g.em, "jae", oob_label);
	x86_emit_jmp(&g.em, "jmp", ok_label);
	x86_emit_label(&g.em, oob_label);
	x86_emit_abort_fixed_ref(ctx, ref);
	x86_emit_label(&g.em, ok_label);
};

fn x86_struct_scratch_alloc(ctx: *x86_ctx) i64 = {
	let idx = ctx.struct_scratch_next;
	if (idx >= ctx.struct_scratch_slots) { abort("x86 struct scratch overflow"); };
	ctx.struct_scratch_next += 1;
	return ctx.struct_scratch_base + (idx * ctx.struct_scratch_stride);
};

fn x86_copy_struct_addr(ctx: *x86_ctx, dst_reg: str, src_reg: str, nbytes: i64) void = {
	let g = ctx.g;
	let off: i64 = 0;
	for (off < nbytes) {
		emit_s(&g.em, "\tmovq ");
		e_i(&g.em, off);
		emit_s(&g.em, "(%");
		emit_s(&g.em, src_reg);
		emit_s(&g.em, "), %r10");
		e_nl(&g.em);
		emit_s(&g.em, "\tmovq %r10, ");
		e_i(&g.em, off);
		emit_s(&g.em, "(%");
		emit_s(&g.em, dst_reg);
		emit_s(&g.em, ")");
		e_nl(&g.em);
		off += 8;
	};
};

fn x86_zero_struct_addr(ctx: *x86_ctx, addr_reg: str, nbytes: i64) void = {
	let g = ctx.g;
	let off: i64 = 0;
	x86_emit_ins(&g.em, "xorq %r10, %r10");
	for (off < nbytes) {
		emit_s(&g.em, "\tmovq %r10, ");
		e_i(&g.em, off);
		emit_s(&g.em, "(%");
		emit_s(&g.em, addr_reg);
		emit_s(&g.em, ")");
		e_nl(&g.em);
		off += 8;
	};
};

fn x86_idx_setup(g: *codegen, fr: *x86_eval_frame, n: *tnode) void = {
	fr.idx_is_slice = false;
	fr.idx_is_ptr_slice = false;
	fr.idx_is_ptr_uarr = false;
	fr.idx_deref = 0;
	fr.idx_elem_ty = null;
	fr.idx_elem_size = 8;
	let base = t_first(n);
	if (base == null) { return; };
	let base_ty_opt = get_expr_type(g, unwrap(base));
	if (base_ty_opt == null) { return; };
	let base_ty: *tnode = unwrap(base_ty_opt);
	let base_res = resolve_alias_type(g, base_ty);
	if (base_res != null) { base_ty = unwrap(base_res); };
	let is_ptr = false;
	let ptr_elem_ty: nullable *tnode = null;
	let idx_ptr_depth: u8 = 0;
	let final_ty: *tnode = base_ty;
	if (base_ty.kind == N_T_PTR) {
		is_ptr = true;
		let walk_ty: *tnode = base_ty;
		for (walk_ty.kind == N_T_PTR) {
			idx_ptr_depth += 1;
			let inner_opt = t_first(walk_ty);
			if (inner_opt == null) { break; };
			let inner_ty: *tnode = unwrap(inner_opt);
			let inner_res = resolve_alias_type(g, inner_ty);
			if (inner_res != null) { inner_ty = unwrap(inner_res); };
			if (ptr_elem_ty == null) { ptr_elem_ty = inner_ty; };
			walk_ty = inner_ty;
		};
		final_ty = walk_ty;
		if (final_ty.kind == N_T_SLICE) {
			fr.idx_is_slice = true;
			fr.idx_is_ptr_slice = true;
		};
		if (final_ty.kind == N_T_UARR) { fr.idx_is_ptr_uarr = true; };
		if (final_ty.kind == N_T_ARR || final_ty.kind == N_T_UARR || final_ty.kind == N_T_SLICE) {
			if (idx_ptr_depth > 0) { fr.idx_deref = idx_ptr_depth - 1; };
		};
	};
	if (!is_ptr && base_ty.kind == N_T_SLICE) { fr.idx_is_slice = true; };
	if (!is_ptr && base_ty.kind == N_T_UARR) { fr.idx_is_ptr_uarr = true; };
	let elem_opt: nullable *tnode = null;
	if (final_ty.kind == N_T_SLICE || final_ty.kind == N_T_ARR || final_ty.kind == N_T_UARR) {
		elem_opt = t_first(final_ty);
		if (elem_opt != null) {
			fr.idx_elem_ty = unwrap(elem_opt);
			let elem_ty = unwrap(elem_opt);
			let elem_res = resolve_alias_type(g, elem_ty);
			if (elem_res != null) { elem_ty = unwrap(elem_res); };
			if (elem_ty.kind == N_T_PRIM) {
				fr.idx_elem_size = x86_type_prim_size(g, elem_ty);
			} else if (elem_ty.kind == N_T_ALIAS) {
				fr.idx_elem_size = x86_alias_prim_size(g, elem_ty.ref);
			} else {
				fr.idx_elem_size = x86_type_elem_slot_size(g, elem_ty);
			};
		};
	} else if (is_ptr && ptr_elem_ty != null) {
		fr.idx_elem_ty = unwrap(ptr_elem_ty);
		let elem_ty2 = unwrap(ptr_elem_ty);
		let elem_res2 = resolve_alias_type(g, elem_ty2);
		if (elem_res2 != null) { elem_ty2 = unwrap(elem_res2); };
		if (elem_ty2.kind == N_T_PRIM) {
			fr.idx_elem_size = x86_type_prim_size(g, elem_ty2);
		} else if (elem_ty2.kind == N_T_ALIAS) {
			fr.idx_elem_size = x86_alias_prim_size(g, elem_ty2.ref);
		} else {
			fr.idx_elem_size = x86_type_elem_slot_size(g, elem_ty2);
		};
	};
};

fn x86_field_setup(g: *codegen, fr: *x86_eval_frame, n: *tnode, base_expr: *tnode) void = {
	let fld_base_ty_opt = get_expr_type(g, base_expr);
	if (fld_base_ty_opt == null && base_expr.kind == N_ID) {
		let gstruct = x86_global_struct_type(g, base_expr.ref);
		if (gstruct != null) { fld_base_ty_opt = gstruct; };
	};
	if (fld_base_ty_opt == null && base_expr.kind == N_FLD) {
		let refs: [16]bref = [bref { pos = 0, length = 0 }...];
		let ref_count: size = 0;
		let cur: *tnode = base_expr;
		for (cur.kind == N_FLD) {
			if (ref_count < len(refs)) {
				refs[ref_count] = cur.ref;
				ref_count += 1;
			};
			let inner = t_first(cur);
			if (inner == null) { break; };
			cur = unwrap(inner);
		};
		let base_ty_opt = get_expr_type(g, cur);
		if (cur.kind == N_ID) {
			let gstruct_chain = x86_global_struct_type(g, cur.ref);
			if (gstruct_chain != null) { base_ty_opt = gstruct_chain; };
		};
		if (base_ty_opt != null && ref_count > 0) {
			let base_ty: *tnode = unwrap(base_ty_opt);
			let base_res = resolve_alias_type(g, base_ty);
			if (base_res != null) { base_ty = unwrap(base_res); };
			let i = ref_count;
			for (i > 0) {
				i -= 1;
				if (!x86_type_is_struct(g, base_ty)) { break; };
				let fty = x86_struct_field_type(g, base_ty, refs[i]);
				if (fty == null) { break; };
				base_ty = unwrap(fty);
				let next_res = resolve_alias_type(g, base_ty);
				if (next_res != null) { base_ty = unwrap(next_res); };
			};
			fld_base_ty_opt = base_ty;
		};
	};
	if (fld_base_ty_opt == null) { err_bref(n.ref, g.t.src, g.t.src_len, "field base type unknown"); };
	let fld_base_ty: *tnode = unwrap(fld_base_ty_opt);
	let fld_res = resolve_alias_type(g, fld_base_ty);
	if (fld_res != null) { fld_base_ty = unwrap(fld_res); };
	let deref_count: u8 = 0;
	for (fld_base_ty.kind == N_T_PTR) {
		deref_count += 1;
		let inner_opt = t_first(fld_base_ty);
		if (inner_opt == null) { break; };
		let inner_ty: *tnode = unwrap(inner_opt);
		let inner_res = resolve_alias_type(g, inner_ty);
		if (inner_res != null) { inner_ty = unwrap(inner_res); };
		fld_base_ty = inner_ty;
	};
	if (!x86_type_is_struct(g, fld_base_ty) && base_expr.kind == N_ID) {
		let glob_ptr2 = dict_get_bref(&g.globals, base_expr.ref);
		if (glob_ptr2 != 0) {
			let gnode2: *tnode = glob_ptr2: uintptr: *tnode;
			if (gnode2.kind == N_GLOBAL || gnode2.kind == N_DEF) {
				let gty2: nullable *tnode = null;
				let ginit2: nullable *tnode = null;
				x86_global_parts(gnode2, &gty2, &ginit2);
				if (gty2 != null) {
					let gty_res = resolve_alias_type(g, unwrap(gty2));
					if (gty_res != null) { fld_base_ty = unwrap(gty_res); };
				} else if (ginit2 != null && unwrap(ginit2).kind == N_STRUCT_LIT) {
					let type_ptr2 = dict_get_bref(&g.types, unwrap(ginit2).ref);
					if (type_ptr2 != 0) { fld_base_ty = type_ptr2: uintptr: *tnode; };
				};
			};
		};
	};
	if (!x86_type_is_struct(g, fld_base_ty)) {
		err_bref(n.ref, g.t.src, g.t.src_len, "field base type unknown");
	};
	fr.base_is_ptr = deref_count > 0;
	if (deref_count > 0) { fr.field_deref = deref_count - 1; }
	else { fr.field_deref = 0; };
	fr.field_off = x86_struct_field_offset(g, fld_base_ty, n.ref);
	let fld_ty_opt = x86_struct_field_type(g, fld_base_ty, n.ref);
	if (fld_ty_opt != null) { fr.field_ty = unwrap(fld_ty_opt); }
	else { fr.field_ty = fld_base_ty; };
};

fn x86_alias_prim_size(g: *codegen, ref: bref) i64 = {
	if (bref_match(ref, "i8", g.t.src) || bref_match(ref, "u8", g.t.src) || bref_match(ref, "bool", g.t.src)) { return 1; };
	if (bref_match(ref, "i16", g.t.src) || bref_match(ref, "u16", g.t.src)) { return 2; };
	if (bref_match(ref, "i32", g.t.src) || bref_match(ref, "u32", g.t.src) || bref_match(ref, "f32", g.t.src)) { return 4; };
	if (bref_match(ref, "i64", g.t.src) || bref_match(ref, "u64", g.t.src) || bref_match(ref, "f64", g.t.src)) { return 8; };
	if (bref_match(ref, "size", g.t.src) || bref_match(ref, "uintptr", g.t.src)) { return 8; };
	return 8;
};

fn x86_alias_is_signed(g: *codegen, ref: bref) bool = {
	return bref_match(ref, "i8", g.t.src) || bref_match(ref, "i16", g.t.src)
		|| bref_match(ref, "i32", g.t.src) || bref_match(ref, "i64", g.t.src);
};

fn x86_type_prim_size(g: *codegen, ty: *tnode) i64 = {
	let t0: *tnode = ty;
	let qual_depth: i64 = 0;
	for (qual_depth < 8 && t0.kind == N_T_QUAL) {
		let inner0 = t_first(t0);
		if (inner0 == null) { return 8; };
		t0 = unwrap(inner0);
		qual_depth += 1;
	};
	if (t0.kind == N_T_PRIM && type_is_str(t0, g.t.src)) { return 16; };
	let resolved0 = resolve_alias_type(g, t0);
	if (resolved0 == null) {
		if (t0.kind == N_T_ALIAS) {
			if (bref_match(t0.ref, "str", g.t.src)) { return 16; };
			return x86_alias_prim_size(g, t0.ref);
		};
		if (t0.kind == N_T_PRIM) {
			let tok0 = t0.ival: u16;
			if (tok0 == TK_I8 || tok0 == TK_U8 || tok0 == TK_PRIM_BOOL) { return 1; };
			if (tok0 == TK_I16 || tok0 == TK_U16) { return 2; };
			if (tok0 == TK_I32 || tok0 == TK_U32 || tok0 == TK_F32) { return 4; };
			if (tok0 == TK_I64 || tok0 == TK_U64 || tok0 == TK_F64) { return 8; };
			if (tok0 == TK_SIZE || tok0 == TK_UINTPTR) { return 8; };
			if (tok0 == TK_STR) { return 16; };
			if (t0.ref.length > 0) { return x86_alias_prim_size(g, t0.ref); };
		};
		return 8;
	};
	let r0: *tnode = unwrap(resolved0);
	if (r0.kind == N_T_PTR) { return 8; };
	if (r0.kind == N_T_ALIAS) { return x86_alias_prim_size(g, r0.ref); };
	if (r0.kind != N_T_PRIM) { return 8; };
	let tok = r0.ival: u16;
	if (tok == TK_I8 || tok == TK_U8 || tok == TK_PRIM_BOOL) { return 1; };
	if (tok == TK_I16 || tok == TK_U16) { return 2; };
	if (tok == TK_I32 || tok == TK_U32 || tok == TK_F32) { return 4; };
	if (tok == TK_I64 || tok == TK_U64 || tok == TK_F64) { return 8; };
	if (tok == TK_SIZE || tok == TK_UINTPTR) { return 8; };
	if (tok == TK_STR) { return 16; };
	if (r0.ref.length > 0) { return x86_alias_prim_size(g, r0.ref); };
	return 8;
};

fn x86_type_elem_slot_size(g: *codegen, ty: *tnode) i64 = {
	let t0: *tnode = ty;
	let qual_depth: i64 = 0;
	for (qual_depth < 8 && t0.kind == N_T_QUAL) {
		let inner0 = t_first(t0);
		if (inner0 == null) { return 8; };
		t0 = unwrap(inner0);
		qual_depth += 1;
	};
	if (t0.kind == N_T_PRIM) {
		if (type_is_str(t0, g.t.src)) { return 16; };
		return x86_type_prim_size(g, t0);
	};
	let resolved0 = resolve_alias_type(g, t0);
	if (resolved0 == null) {
		if (t0.kind == N_T_ALIAS) {
			if (bref_match(t0.ref, "str", g.t.src)) { return 16; };
			return x86_alias_prim_size(g, t0.ref);
		};
		return x86_type_slot_size(g, t0);
	};
	let r0: *tnode = unwrap(resolved0);
	if (r0.kind == N_T_PRIM) {
		if (type_is_str(r0, g.t.src)) { return 16; };
		return x86_type_prim_size(g, r0);
	};
	if (r0.kind == N_T_ALIAS) {
		if (bref_match(r0.ref, "str", g.t.src)) { return 16; };
		return x86_alias_prim_size(g, r0.ref);
	};
	return x86_type_slot_size(g, r0);
};

fn x86_array_slot_size(g: *codegen, ty: *tnode) i64 = {
	let elem_opt = t_first(ty);
	if (elem_opt == null) { return 8; };
	let elem_ty: *tnode = unwrap(elem_opt);
	let elem_sz = x86_type_elem_slot_size(g, elem_ty);
	let count: i64 = 0;
	let ok = arr_size_literal(ty, g.t.src, &count);
	if (!ok || count <= 0) { return 8; };
	let total = elem_sz * count;
	let rem = total % 8;
	if (rem != 0) { total += (8 - rem); };
	return total;
};

fn x86_type_is_signed(g: *codegen, ty: *tnode) bool = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) {
		if (ty.kind == N_T_ALIAS) { return x86_alias_is_signed(g, ty.ref); };
		if (ty.kind == N_T_PRIM && ty.ref.length > 0) { return x86_alias_is_signed(g, ty.ref); };
		return false;
	};
	let r: *tnode = unwrap(resolved);
	if (r.kind == N_T_ALIAS) { return x86_alias_is_signed(g, r.ref); };
	if (r.kind != N_T_PRIM) { return false; };
	let tok = r.ival: u16;
	if (tok == TK_I8 || tok == TK_I16 || tok == TK_I32 || tok == TK_I64) { return true; };
	if (r.ref.length > 0) { return x86_alias_is_signed(g, r.ref); };
	return false;
};

fn x86_struct_field_index(g: *codegen, ty: *tnode, field: bref) i64 = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return -1; };
	let r: *tnode = unwrap(resolved);
	if (r.kind != N_T_STRUCT) { return -1; };
	let idx: i64 = 0;
	let f = t_first(r);
	for (f != null) {
		let field_n: *tnode = unwrap(f);
		if (bref_eq(field_n.ref, field, g.t.src)) { return idx; };
		idx += 1;
		f = field_n.next;
	};
	return -1;
};

fn x86_struct_field_offset(g: *codegen, ty: *tnode, field: bref) i64 = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return 0; };
	let r: *tnode = unwrap(resolved);
	if (r.kind != N_T_STRUCT) { return 0; };
	let off: i64 = 0;
	let f = t_first(r);
	for (f != null) {
		let field_n: *tnode = unwrap(f);
		if (bref_eq(field_n.ref, field, g.t.src)) { return off; };
		let fty_opt = t_first(field_n);
		if (fty_opt != null) { off += x86_type_slot_size(g, unwrap(fty_opt)); }
		else { off += 8; };
		f = field_n.next;
	};
	return off;
};

fn x86_struct_field_type(g: *codegen, ty: *tnode, field: bref) nullable *tnode = {
	let resolved = resolve_alias_type(g, ty);
	if (resolved == null) { return null; };
	let r: *tnode = unwrap(resolved);
	if (r.kind != N_T_STRUCT) { return null; };
	let f = t_first(r);
	for (f != null) {
		let field_n: *tnode = unwrap(f);
		if (bref_eq(field_n.ref, field, g.t.src)) {
			return t_first(field_n);
		};
		f = field_n.next;
	};
	return null;
};

fn x86_enum_member_value(g: *codegen, enum_ty: *tnode, member_ref: bref) i64 = {
	let member = t_first(enum_ty);
	if (member != null && unwrap(member).kind != N_ENUM_MEM) {
		member = unwrap(member).next;
	};
	let first = true;
	let current: i64 = 0;
	for (member != null) {
		let m: *tnode = unwrap(member);
		if (m.kind == N_ENUM_MEM) {
			if (m.ival != 0 || first) { current = m.ival; }
			else { current += 1; };
			if (bref_eq(m.ref, member_ref, g.t.src)) { return current; };
			first = false;
		};
		member = m.next;
	};
	return 0;
};

fn x86_struct_slot_size(g: *codegen, lit: *tnode) i64 = {
	let type_ptr = dict_get_bref(&g.types, lit.ref);
	if (type_ptr == 0) { return 8; };
	let ty: *tnode = type_ptr: uintptr: *tnode;
	return x86_type_slot_size(g, ty);
};

fn x86_type_size_eval(g: *codegen, ty: *tnode, elem_mode: bool) i64 = {
	let type_stack: [64]uintptr = [0...];
	let mode_stack: [64]u8 = [0...];
	let prim_mode_stack: [64]u8 = [0...];
	let acc_stack: [64]i64 = [0...];
	let mult_stack: [64]i64 = [0...];
	let count_stack: [64]i64 = [0...];
	let field_stack: [64]uintptr = [0...];
	let sp: size = 0;
	type_stack[sp] = ty: uintptr;
	mode_stack[sp] = 0;
	prim_mode_stack[sp] = 0;
	if (elem_mode) { prim_mode_stack[sp] = 1; };
	acc_stack[sp] = 0;
	mult_stack[sp] = 1;
	count_stack[sp] = 0;
	field_stack[sp] = 0;
	sp += 1;
	for (sp > 0) {
		let idx = sp - 1;
		let mode = mode_stack[idx];
		if (mode == 1) {
			let arr_count_mode = count_stack[idx];
			let sz_arr = acc_stack[idx] * arr_count_mode;
			let rem = sz_arr % 8;
			if (rem != 0) { sz_arr += (8 - rem); };
			sp -= 1;
			if (sp > 0) {
				let acc0 = acc_stack[sp - 1];
				acc0 += sz_arr * mult_stack[idx];
				acc_stack[sp - 1] = acc0;
			} else { return sz_arr * mult_stack[idx]; };
			continue;
		} else if (mode == 2) {
			let field_opt: nullable *tnode = field_stack[idx]: uintptr: *tnode;
			if (field_opt != null) {
				let field_n: *tnode = unwrap(field_opt);
				field_stack[idx] = field_n.next: uintptr;
				let fty_opt = t_first(field_n);
				if (fty_opt == null) {
					let acc1 = acc_stack[idx];
					acc1 += 8;
					acc_stack[idx] = acc1;
				}
				else {
					if (sp >= len(type_stack)) { abort("x86 type size stack overflow"); };
					type_stack[sp] = unwrap(fty_opt): uintptr;
					mode_stack[sp] = 0;
					prim_mode_stack[sp] = 0;
					acc_stack[sp] = 0;
					mult_stack[sp] = 1;
					count_stack[sp] = 0;
					field_stack[sp] = 0;
					sp += 1;
				};
				continue;
			};
			let sz_struct = acc_stack[idx];
			if (sz_struct == 0) { sz_struct = 8; };
			sp -= 1;
			if (sp > 0) {
				let acc2 = acc_stack[sp - 1];
				acc2 += sz_struct * mult_stack[idx];
				acc_stack[sp - 1] = acc2;
			} else { return sz_struct * mult_stack[idx]; };
			continue;
		};

		let t0: *tnode = type_stack[idx]: *tnode;
		let prim_mode = prim_mode_stack[idx] != 0;
		let qual_depth: i64 = 0;
		for (qual_depth < 8 && t0.kind == N_T_QUAL) {
			let inner0 = t_first(t0);
			if (inner0 == null) { break; };
			t0 = unwrap(inner0);
			qual_depth += 1;
		};
		let resolved = resolve_alias_type(g, t0);
		let r: *tnode = t0;
		if (resolved != null) { r = unwrap(resolved); };

		if (r.kind == N_T_ALIAS) {
			let sz_alias: i64 = 8;
			if (bref_match(r.ref, "str", g.t.src)) { sz_alias = 16; }
			else if (prim_mode) { sz_alias = x86_alias_prim_size(g, r.ref); };
			sp -= 1;
			if (sp > 0) {
				let acc3 = acc_stack[sp - 1];
				acc3 += sz_alias * mult_stack[idx];
				acc_stack[sp - 1] = acc3;
			} else { return sz_alias * mult_stack[idx]; };
			continue;
		};
		if (r.kind == N_T_PTR) {
			sp -= 1;
			if (sp > 0) {
				let acc4 = acc_stack[sp - 1];
				acc4 += 8 * mult_stack[idx];
				acc_stack[sp - 1] = acc4;
			} else { return 8 * mult_stack[idx]; };
			continue;
		};
		if (r.kind == N_T_PRIM) {
			let sz_prim: i64 = 8;
			if (type_is_str(r, g.t.src)) { sz_prim = 16; }
			else if (prim_mode) { sz_prim = x86_type_prim_size(g, r); };
			sp -= 1;
			if (sp > 0) {
				let acc5 = acc_stack[sp - 1];
				acc5 += sz_prim * mult_stack[idx];
				acc_stack[sp - 1] = acc5;
			} else { return sz_prim * mult_stack[idx]; };
			continue;
		};
		if (r.kind == N_T_TAGGED) {
			sp -= 1;
			if (sp > 0) {
				let acc6 = acc_stack[sp - 1];
				acc6 += 16 * mult_stack[idx];
				acc_stack[sp - 1] = acc6;
			} else { return 16 * mult_stack[idx]; };
			continue;
		};
		if (r.kind == N_T_SLICE) {
			sp -= 1;
			if (sp > 0) {
				let acc7 = acc_stack[sp - 1];
				acc7 += 24 * mult_stack[idx];
				acc_stack[sp - 1] = acc7;
			} else { return 24 * mult_stack[idx]; };
			continue;
		};
		if (r.kind == N_T_ARR) {
			let elem_opt = t_first(r);
			let arr_count: i64 = 0;
			let ok = arr_size_literal(r, g.t.src, &arr_count);
			if (elem_opt == null || !ok || arr_count <= 0) {
				sp -= 1;
				if (sp > 0) {
					let acc8 = acc_stack[sp - 1];
					acc8 += 8 * mult_stack[idx];
					acc_stack[sp - 1] = acc8;
				} else { return 8 * mult_stack[idx]; };
				continue;
			};
			mode_stack[idx] = 1;
			acc_stack[idx] = 0;
			count_stack[idx] = arr_count;
			let elem_ty = unwrap(elem_opt);
			if (sp >= len(type_stack)) { abort("x86 type size stack overflow"); };
			type_stack[sp] = elem_ty: uintptr;
			mode_stack[sp] = 0;
			prim_mode_stack[sp] = 1;
			acc_stack[sp] = 0;
			mult_stack[sp] = 1;
			count_stack[sp] = 0;
			field_stack[sp] = 0;
			sp += 1;
			continue;
		};
		if (r.kind == N_T_STRUCT) {
			let f = t_first(r);
			if (f == null) {
				sp -= 1;
				if (sp > 0) {
					let acc9 = acc_stack[sp - 1];
					acc9 += 8 * mult_stack[idx];
					acc_stack[sp - 1] = acc9;
				} else { return 8 * mult_stack[idx]; };
				continue;
			};
			mode_stack[idx] = 2;
			acc_stack[idx] = 0;
			field_stack[idx] = f: uintptr;
			continue;
		};

		sp -= 1;
		if (sp > 0) {
			let acc10 = acc_stack[sp - 1];
			acc10 += 8 * mult_stack[idx];
			acc_stack[sp - 1] = acc10;
		} else { return 8 * mult_stack[idx]; };
	};
	return 8;
};

fn x86_type_slot_size(g: *codegen, ty: *tnode) i64 = {
	return x86_type_size_eval(g, ty, false);
};

fn x86_expr_is_float(g: *codegen, n: *tnode) bool = {
	let ty_opt = get_expr_type(g, n);
	if (ty_opt != null && x86_is_float_ty(g, unwrap(ty_opt))) { return true; };
	if (n.kind == N_FLOAT) { return true; };
	return false;
};

fn x86_push_result(ctx: *x86_ctx, is_float: bool, is_f32: bool) void = {
	if (is_float) {
		x86_emit_ins(&ctx.g.em, "subq $8, %rsp");
		if (is_f32) { x86_emit_ins(&ctx.g.em, "movss %xmm0, (%rsp)"); }
		else { x86_emit_ins(&ctx.g.em, "movsd %xmm0, (%rsp)"); };
	} else {
		x86_emit_ins(&ctx.g.em, "pushq %rax");
	};
	ctx.temp_depth += 1;
};

fn x86_pop_to(ctx: *x86_ctx, is_float: bool, is_f32: bool, reg: str) void = {
	if (is_float) {
		if (is_f32) { x86_emit_ins(&ctx.g.em, "movss (%rsp), %xmm1"); }
		else { x86_emit_ins(&ctx.g.em, "movsd (%rsp), %xmm1"); };
		x86_emit_ins(&ctx.g.em, "addq $8, %rsp");
	} else {
		x86_emit_ins(&ctx.g.em, reg);
	};
	ctx.temp_depth -= 1;
};

fn x86_align_for_call(ctx: *x86_ctx) bool = {
	// Ensure %rsp is 16-byte aligned before call.
	if ((ctx.temp_depth & 1) != 0) {
		x86_emit_ins(&ctx.g.em, "subq $8, %rsp");
		return true;
	};
	return false;
};

fn x86_unalign_after_call(ctx: *x86_ctx, did_pad: bool) void = {
	if (did_pad) { x86_emit_ins(&ctx.g.em, "addq $8, %rsp"); };
};

fn x86_load_from_addr(ctx: *x86_ctx, ty: *tnode) bool = {
	let g = ctx.g;
	if (x86_type_is_tagged(g, ty)) { return false; };
	if (x86_is_float_ty(g, ty)) {
		if (x86_type_prim_size(g, ty) == 4) { x86_emit_ins(&g.em, "movss (%rax), %xmm0"); }
		else { x86_emit_ins(&g.em, "movsd (%rax), %xmm0"); };
		return true;
	};
	let sz = x86_type_prim_size(g, ty);
	let is_signed = x86_type_is_signed(g, ty);
	if (sz == 1) {
		if (is_signed) { x86_emit_ins(&g.em, "movsbq (%rax), %rax"); }
		else { x86_emit_ins(&g.em, "movzbq (%rax), %rax"); };
	} else if (sz == 2) {
		if (is_signed) { x86_emit_ins(&g.em, "movswq (%rax), %rax"); }
		else { x86_emit_ins(&g.em, "movzwq (%rax), %rax"); };
	} else if (sz == 4) {
		if (is_signed) { x86_emit_ins(&g.em, "movslq (%rax), %rax"); }
		else { x86_emit_ins(&g.em, "movl (%rax), %eax"); };
	} else {
		x86_emit_ins(&g.em, "movq (%rax), %rax");
	};
	return false;
};

fn x86_store_to_addr(ctx: *x86_ctx, ty: *tnode, addr_reg: str, is_float: bool) void = {
	let g = ctx.g;
	if (x86_type_is_tagged(g, ty)) {
		emit_s(&g.em, "\tmovq ");
		emit_s(&g.em, addr_reg);
		emit_s(&g.em, ", %r11");
		e_nl(&g.em);
		x86_copy_struct_addr(ctx, "r11", "rax", 16);
		return;
	};
	if (x86_type_is_struct(g, ty) || x86_type_is_slice(g, ty) || x86_type_is_str(g, ty)) {
		let nbytes = x86_type_slot_size(g, ty);
		let off: i64 = 0;
		for (off < nbytes) {
			emit_s(&g.em, "\tmovq ");
			e_i(&g.em, off);
			emit_s(&g.em, "(%rax), %r10");
			e_nl(&g.em);
			emit_s(&g.em, "\tmovq %r10, ");
			e_i(&g.em, off);
			emit_s(&g.em, "(");
			emit_s(&g.em, addr_reg);
			emit_s(&g.em, ")");
			e_nl(&g.em);
			off += 8;
		};
		return;
	};
	if (is_float) {
		emit_s(&g.em, "\t");
		if (x86_type_prim_size(g, ty) == 4) { emit_s(&g.em, "movss %xmm0, ("); }
		else { emit_s(&g.em, "movsd %xmm0, ("); };
		emit_s(&g.em, addr_reg);
		emit_s(&g.em, ")");
		e_nl(&g.em);
		return;
	};
	let sz = x86_type_prim_size(g, ty);
	if (sz == 1) {
		emit_s(&g.em, "\tmovb %al, ("); emit_s(&g.em, addr_reg); emit_s(&g.em, ")"); e_nl(&g.em);
	} else if (sz == 2) {
		emit_s(&g.em, "\tmovw %ax, ("); emit_s(&g.em, addr_reg); emit_s(&g.em, ")"); e_nl(&g.em);
	} else if (sz == 4) {
		emit_s(&g.em, "\tmovl %eax, ("); emit_s(&g.em, addr_reg); emit_s(&g.em, ")"); e_nl(&g.em);
	} else {
		emit_s(&g.em, "\tmovq %rax, ("); emit_s(&g.em, addr_reg); emit_s(&g.em, ")"); e_nl(&g.em);
	};
};

fn x86_emit_tagged_wrap(ctx: *x86_ctx, tagged_ty: *tnode, expr: *tnode) bool = {
	let g = ctx.g;
	let resolved = resolve_alias_type(g, tagged_ty);
	if (resolved == null || unwrap(resolved).kind != N_T_TAGGED) {
		return x86_eval(ctx, expr, false);
	};
	if (expr_is_void_literal(expr, g.t.src)) {
		err_bref(expr.ref, g.t.src, g.t.src_len, "void does not match tagged union");
	};
	let expr_ty_opt = get_expr_type(g, expr);
	let tag: i64 = 0;
	if (expr_ty_opt != null) {
		tag = find_variant_idx(g, unwrap(resolved), unwrap(expr_ty_opt));
	};
	if (tag < 0) { tag = 0; };
	let expr_is_float = false;
	let expr_ty_for_float: nullable *tnode = null;
	if (expr_ty_opt != null) { expr_ty_for_float = expr_ty_opt; };
	if (expr.kind == N_FLOAT && expr_ty_for_float != null) {
		let expr_ty_val = unwrap(expr_ty_for_float);
		let expr_res_val = resolve_alias_type(g, expr_ty_val);
		if (expr_res_val != null) { expr_ty_val = unwrap(expr_res_val); };
		if (x86_is_float_ty(g, expr_ty_val) && x86_type_prim_size(g, expr_ty_val) == 4) {
			x86_emit_float_literal(ctx, expr, true);
			expr_is_float = true;
		} else if (x86_is_float_ty(g, expr_ty_val)) {
			x86_emit_float_literal(ctx, expr, false);
			expr_is_float = true;
		} else {
			expr_is_float = x86_eval(ctx, expr, false);
		};
	} else if (expr.kind == N_CAST) {
		let inner = t_first_nn(expr);
		let cast_ty = t_next_nn(inner);
		if (inner.kind == N_FLOAT && x86_is_float_ty(g, cast_ty)) {
			let is_f32 = x86_type_prim_size(g, cast_ty) == 4;
			x86_emit_float_literal(ctx, inner, is_f32);
			expr_is_float = true;
		} else {
			expr_is_float = x86_eval(ctx, expr, false);
		};
	} else {
		expr_is_float = x86_eval(ctx, expr, false);
	};
	let scratch_off = x86_struct_scratch_alloc(ctx);
	x86_emit_ins_pre_i_suf(&g.em, "leaq -", scratch_off, "(%rbp), %r11");
	x86_emit_ins_pre_i_suf(&g.em, "movq $", tag, ", (%r11)");
	if (expr_ty_opt != null) {
		let expr_ty = unwrap(expr_ty_opt);
		let sz = x86_type_prim_size(g, expr_ty);
		if (expr_is_float) {
			if (sz == 4) { x86_emit_ins(&g.em, "movss %xmm0, 8(%r11)"); }
			else { x86_emit_ins(&g.em, "movsd %xmm0, 8(%r11)"); };
		} else {
			if (sz == 1) { x86_emit_ins(&g.em, "movb %al, 8(%r11)"); }
			else if (sz == 2) { x86_emit_ins(&g.em, "movw %ax, 8(%r11)"); }
			else if (sz == 4) { x86_emit_ins(&g.em, "movl %eax, 8(%r11)"); }
			else { x86_emit_ins(&g.em, "movq %rax, 8(%r11)"); };
		};
	} else {
		if (expr_is_float) { x86_emit_ins(&g.em, "movsd %xmm0, 8(%r11)"); }
		else { x86_emit_ins(&g.em, "movq %rax, 8(%r11)"); };
	};
	x86_emit_ins_pre_i_suf(&g.em, "leaq -", scratch_off, "(%rbp), %rax");
	return false;
};

fn x86_eval_with_expected(ctx: *x86_ctx, expr: *tnode, expected: nullable *tnode) bool = {
	let g = ctx.g;
	let prev = g.match_expected;
	if (expected != null) { g.match_expected = expected; };
	let is_float = x86_eval(ctx, expr, false);
	g.match_expected = prev;
	return is_float;
};

fn x86_emit_struct_init(ctx: *x86_ctx, name: bref, struct_ty: *tnode, lit: *tnode) void = {
	let g = ctx.g;
	let base_off = x86_local_offset(g, name);
	if (base_off == 0) { err_bref(name, g.t.src, g.t.src_len, "unknown struct local"); };
	let field = t_first(lit);
	for (field != null) {
		let field_n: *tnode = unwrap(field);
		let fval = t_first(field_n);
		let fty = x86_struct_field_type(g, struct_ty, field_n.ref);
		let is_float = false;
		if (fval != null) { is_float = x86_eval(ctx, unwrap(fval), false); };
		let off = x86_struct_field_offset(g, struct_ty, field_n.ref);
		x86_emit_ins_pre_i_suf(&g.em, "leaq -", base_off, "(%rbp), %rcx");
		if (off != 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", off, ", %rcx"); };
		if (fty != null) { x86_store_to_addr(ctx, unwrap(fty), "%rcx", is_float); }
		else { x86_store_to_addr(ctx, struct_ty, "%rcx", is_float); };
		field = field_n.next;
	};
};

fn x86_emit_struct_lit_to_off(ctx: *x86_ctx, struct_ty: *tnode, lit: *tnode, base_off: i64) void = {
	let g = ctx.g;
	let field = t_first(lit);
	for (field != null) {
		let field_n: *tnode = unwrap(field);
		let fval = t_first(field_n);
		let fty = x86_struct_field_type(g, struct_ty, field_n.ref);
		let is_float = false;
		if (fval != null) { is_float = x86_eval(ctx, unwrap(fval), false); };
		let off = x86_struct_field_offset(g, struct_ty, field_n.ref);
		x86_emit_ins_pre_i_suf(&g.em, "leaq -", base_off, "(%rbp), %rcx");
		if (off != 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", off, ", %rcx"); };
		if (fty != null) { x86_store_to_addr(ctx, unwrap(fty), "%rcx", is_float); }
		else { x86_store_to_addr(ctx, struct_ty, "%rcx", is_float); };
		field = field_n.next;
	};
};

fn x86_emit_array_init(ctx: *x86_ctx, name: bref, arr_ty: *tnode, lit: *tnode) void = {
	let g = ctx.g;
	let base_off = x86_local_offset(g, name);
	if (base_off == 0) { err_bref(name, g.t.src, g.t.src_len, "unknown array local"); };
	let elem_opt = t_first(arr_ty);
	if (elem_opt == null) { return; };
	let elem_ty: *tnode = unwrap(elem_opt);
	let elem_sz = x86_type_elem_slot_size(g, elem_ty);
	let total_count: i64 = 0;
	let ok = arr_size_literal(arr_ty, g.t.src, &total_count);
	let lit_count: i64 = arr_lit_count(lit): i64;
	let is_variadic = (lit.flags & F_VARIADIC) != 0;
	if (!ok || total_count <= 0) { total_count = lit_count; };
	x86_emit_ins_pre_i_suf(&g.em, "leaq -", base_off, "(%rbp), %r11");

	// Zero-fill entire array (safe for variadic literals).
	if (total_count > 0) {
		let elem_is_float = x86_is_float_ty(g, elem_ty);
		let elem_is_agg = x86_type_is_struct(g, elem_ty) || x86_type_is_slice(g, elem_ty) || x86_type_is_str(g, elem_ty);
		if (elem_is_float) { x86_emit_ins(&g.em, "xorpd %xmm0, %xmm0"); }
		else if (!elem_is_agg) { x86_emit_ins(&g.em, "xorl %eax, %eax"); };
		let i = 0i64;
		for (i < total_count) {
			let off_zero = i * elem_sz;
			emit_s(&g.em, "\tmovq %r11, %rcx");
			e_nl(&g.em);
			if (off_zero != 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", off_zero, ", %rcx"); };
			if (elem_is_agg) {
				let elem_bytes = x86_type_slot_size(g, elem_ty);
				x86_zero_struct_addr(ctx, "rcx", elem_bytes);
			} else {
				x86_store_to_addr(ctx, elem_ty, "%rcx", elem_is_float);
			};
			i += 1;
		};
	};

	// Fill explicit elements.
	let elem = t_first(lit);
	let idx: i64 = 0;
	for (elem != null && idx < total_count) {
		let elem_n: *tnode = unwrap(elem);
		let is_float = x86_eval(ctx, elem_n, false);
		let off_fill = idx * elem_sz;
		emit_s(&g.em, "\tmovq %r11, %rcx");
		e_nl(&g.em);
		if (off_fill != 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", off_fill, ", %rcx"); };
		x86_store_to_addr(ctx, elem_ty, "%rcx", is_float);
		idx += 1;
		elem = elem_n.next;
	};

	// Variadic array fill: repeat the last element for the remainder.
	if (is_variadic && idx < total_count) {
		let last_opt = t_last(lit);
		if (last_opt != null) {
			let last_expr: *tnode = unwrap(last_opt);
			for (idx < total_count) {
				let fill_is_float = x86_eval(ctx, last_expr, false);
				let fill_off = idx * elem_sz;
				emit_s(&g.em, "\tmovq %r11, %rcx");
				e_nl(&g.em);
				if (fill_off != 0) { x86_emit_ins_pre_i_suf(&g.em, "addq $", fill_off, ", %rcx"); };
				x86_store_to_addr(ctx, elem_ty, "%rcx", fill_is_float);
				idx += 1;
			};
		};
	};
};

fn x86_emit_str_part_bytes(ctx: *x86_ctx, n: *tnode) size = {
	let g = ctx.g;
	let r = n.ref;
	if (n.kind == N_RAWSTR) {
		let i = 1z;
		let end = r.length - 1;
		let slen = 0z;
		for (i < end) {
			let c = g.t.src[r.pos + i];
			x86_emit_byte(&g.em, c);
			i += 1;
			slen += 1;
		};
		return slen;
	};
	if (n.kind != N_STR) { return 0; };
	let slen2 = 0z;
	let i2 = 1z;
	let end2 = r.length - 1;
	for (i2 < end2) {
		let c2 = g.t.src[r.pos + i2];
		if (c2 == '\\' && i2 + 1 < end2) {
			let next = g.t.src[r.pos + i2 + 1];
			if (next == 'x' && i2 + 4 <= end2) {
				let v: u32 = 0;
				let j_hex = 0z;
				let base_pos_hex = r.pos + i2 + 2;
				for (j_hex < 2) {
					let c3_hex = g.t.src[base_pos_hex + j_hex];
					v <<= 4;
					if (c3_hex >= '0' && c3_hex <= '9') { v |= (c3_hex - '0'): u32; }
					else if (c3_hex >= 'a' && c3_hex <= 'f') { v |= (c3_hex - 'a' + 10): u32; }
					else if (c3_hex >= 'A' && c3_hex <= 'F') { v |= (c3_hex - 'A' + 10): u32; };
					j_hex += 1;
				};
				x86_emit_byte(&g.em, v: u8);
				slen2 += 1;
				i2 += 4;
				continue;
			};
			if (next == 'o' || next == 'O' || next == 'u' || next == 'U') {
				let esc_is_hex = (next == 'u' || next == 'U');
				let count = 4z;
				let step = 6z;
				if (next == 'O' || next == 'U') { count = 8z; step = 10z; };
				if (i2 + step <= end2) {
					let cp: u32 = 0;
					let j_cp = 0z;
					let base_pos_cp = r.pos + i2 + 2;
					for (j_cp < count) {
						let c3_cp = g.t.src[base_pos_cp + j_cp];
						if (esc_is_hex) {
							cp <<= 4;
							if (c3_cp >= '0' && c3_cp <= '9') { cp |= (c3_cp - '0'): u32; }
							else if (c3_cp >= 'a' && c3_cp <= 'f') { cp |= (c3_cp - 'a' + 10): u32; }
							else if (c3_cp >= 'A' && c3_cp <= 'F') { cp |= (c3_cp - 'A' + 10): u32; };
						} else {
							cp <<= 3;
							if (c3_cp >= '0' && c3_cp <= '7') { cp |= (c3_cp - '0'): u32; };
						};
						j_cp += 1;
					};
					// Inline UTF-8 emission for parsed codepoint.
					if (cp < 0x80) {
						x86_emit_byte(&g.em, cp: u8);
						slen2 += 1;
					} else if (cp < 0x800) {
						x86_emit_byte(&g.em, (0xC0 | (cp >> 6)): u8);
						x86_emit_byte(&g.em, (0x80 | (cp & 0x3F)): u8);
						slen2 += 2;
					} else if (cp < 0x10000) {
						x86_emit_byte(&g.em, (0xE0 | (cp >> 12)): u8);
						x86_emit_byte(&g.em, (0x80 | ((cp >> 6) & 0x3F)): u8);
						x86_emit_byte(&g.em, (0x80 | (cp & 0x3F)): u8);
						slen2 += 3;
					} else {
						x86_emit_byte(&g.em, (0xF0 | (cp >> 18)): u8);
						x86_emit_byte(&g.em, (0x80 | ((cp >> 12) & 0x3F)): u8);
						x86_emit_byte(&g.em, (0x80 | ((cp >> 6) & 0x3F)): u8);
						x86_emit_byte(&g.em, (0x80 | (cp & 0x3F)): u8);
						slen2 += 4;
					};
					i2 += step;
					continue;
				};
			};
			if (next == 'n') { x86_emit_byte(&g.em, 10); slen2 += 1; i2 += 2; continue; };
			if (next == 't') { x86_emit_byte(&g.em, 9); slen2 += 1; i2 += 2; continue; };
			if (next == 'r') { x86_emit_byte(&g.em, 13); slen2 += 1; i2 += 2; continue; };
			if (next == '0') { x86_emit_byte(&g.em, 0); slen2 += 1; i2 += 2; continue; };
			x86_emit_byte(&g.em, next);
			slen2 += 1;
			i2 += 2;
			continue;
		};
		x86_emit_byte(&g.em, c2);
		slen2 += 1;
		i2 += 1;
	};
	return slen2;
};

fn x86_emit_str_literal(ctx: *x86_ctx, n: *tnode) i64 = {
	let g = ctx.g;
	let data_id = x86_new_label(ctx);
	emit_s(&g.em, ".section .rodata");
	e_nl(&g.em);
	emit_s(&g.em, ".L");
	e_i(&g.em, data_id);
	e_c(&g.em, ':');
	e_nl(&g.em);
	let slen_bytes = x86_emit_str_part_bytes(ctx, n);
	let child = t_first(n);
	for (child != null) {
		let cn: *tnode = unwrap(child);
		slen_bytes += x86_emit_str_part_bytes(ctx, cn);
		child = cn.next;
	};
	let slen_i64: i64 = slen_bytes: i64;
	emit_s(&g.em, ".text");
	e_nl(&g.em);
	let struct_id = x86_new_label(ctx);
	emit_s(&g.em, ".section .rodata");
	e_nl(&g.em);
	emit_s(&g.em, ".align 8");
	e_nl(&g.em);
	emit_s(&g.em, ".L");
	e_i(&g.em, struct_id);
	e_c(&g.em, ':');
	e_nl(&g.em);
	emit_s(&g.em, "\t.quad .L");
	e_i(&g.em, data_id);
	e_nl(&g.em);
	emit_s(&g.em, "\t.quad ");
	e_i(&g.em, slen_i64);
	e_nl(&g.em);
	emit_s(&g.em, ".text");
	e_nl(&g.em);
	return struct_id;
};

fn x86_emit_float_data(ctx: *x86_ctx, lit: *tnode, is_f32: bool) void = {
	let r = lit.ref;
	let end = r.length;
	if (end >= 3) {
		let b0 = ctx.g.t.src[r.pos + end - 3];
		let b1 = ctx.g.t.src[r.pos + end - 2];
		let b2 = ctx.g.t.src[r.pos + end - 1];
		if (b0 == 'f' && b1 == '3' && b2 == '2') { r.length -= 3; }
		else if (b0 == 'f' && b1 == '6' && b2 == '4') { r.length -= 3; };
	};
	if (is_f32) { emit_s(&ctx.g.em, "\t.float "); }
	else { emit_s(&ctx.g.em, "\t.double "); };
	e_bref_no_underscore(&ctx.g.em, r);
	e_nl(&ctx.g.em);
};

fn x86_emit_scalar_data(ctx: *x86_ctx, ty: nullable *tnode, init: *tnode) void = {
	let g = ctx.g;
	let is_float = false;
	let is_f32 = false;
	if (ty != null) {
		let rty = resolve_alias_type(g, unwrap(ty));
		if (rty != null && unwrap(rty).kind == N_T_PRIM) {
			let tok = unwrap(rty).ival: u16;
			if (tok == TK_F32) { is_float = true; is_f32 = true; }
			else if (tok == TK_F64) { is_float = true; };
		};
	};
	if (init.kind == N_FLOAT) {
		x86_emit_float_data(ctx, init, is_f32);
		return;
	};
	if (is_float) {
		x86_emit_float_data(ctx, init, is_f32);
		return;
	};
	emit_s(&g.em, "\t.quad ");
	if (init.kind == N_INT || init.kind == N_BOOL || init.kind == N_CHAR) {
		e_i(&g.em, init.ival);
	} else {
		err_bref(init.ref, g.t.src, g.t.src_len, "unsupported global initializer (expected literal)");
	};
	e_nl(&g.em);
};

fn x86_emit_array_data(ctx: *x86_ctx, ty: *tnode, init: *tnode) void = {
	let g = ctx.g;
	let elem_opt = t_first(ty);
	if (elem_opt == null) { err_bref(init.ref, g.t.src, g.t.src_len, "array literal missing element type"); };
	let elem_ty = unwrap(elem_opt);
	let elem_stride = x86_type_elem_slot_size(g, elem_ty);
	let elem_val_sz = x86_type_prim_size(g, elem_ty);
	if (x86_type_is_struct(g, elem_ty) || x86_type_is_slice(g, elem_ty) || x86_type_is_str(g, elem_ty)
		|| x86_type_is_tagged(g, elem_ty)) {
		elem_val_sz = x86_type_slot_size(g, elem_ty);
	};
	if (elem_stride < 8 && elem_val_sz <= 8) { elem_stride = 8; };
	let varr = analyze_variadic_array(ty, init, g.t.src);
	let total_count: i64 = 0;
	if (varr.is_variadic && varr.size_is_literal) {
		total_count = varr.size_literal;
	} else {
		let ok = arr_size_literal(ty, g.t.src, &total_count);
		if (!ok) { total_count = arr_lit_count(init): i64; };
	};
	let emitted: i64 = 0;
	let child = t_first(init);
	for (child != null) {
		let c = unwrap(child);
		if (c.kind == N_INT || c.kind == N_BOOL || c.kind == N_CHAR) {
			if (elem_val_sz == 1) { emit_s(&g.em, "\t.byte "); e_i(&g.em, c.ival); e_nl(&g.em); }
			else if (elem_val_sz == 2) { emit_s(&g.em, "\t.word "); e_i(&g.em, c.ival); e_nl(&g.em); }
			else if (elem_val_sz == 4) { emit_s(&g.em, "\t.long "); e_i(&g.em, c.ival); e_nl(&g.em); }
			else { emit_s(&g.em, "\t.quad "); e_i(&g.em, c.ival); e_nl(&g.em); };
		} else if (c.kind == N_FLOAT) {
			if (elem_val_sz == 4) { x86_emit_float_data(ctx, c, true); }
			else { x86_emit_float_data(ctx, c, false); };
		} else {
			err_bref(c.ref, g.t.src, g.t.src_len, "unsupported array element initializer");
		};
		if (elem_stride > elem_val_sz) {
			let pad = elem_stride - elem_val_sz;
			emit_s(&g.em, "\t.zero ");
			e_i(&g.em, pad);
			e_nl(&g.em);
		};
		emitted += 1;
		child = c.next;
	};
	if (total_count > emitted) {
		let rem = total_count - emitted;
		let zero_bytes = rem * elem_stride;
		emit_s(&g.em, "\t.zero ");
		e_i(&g.em, zero_bytes);
		e_nl(&g.em);
	};
};

fn x86_emit_struct_data(ctx: *x86_ctx, struct_ty: *tnode, lit: *tnode) void = {
	let g = ctx.g;
	let resolved = resolve_alias_type(g, struct_ty);
	if (resolved != null) { struct_ty = unwrap(resolved); };
	if (struct_ty.kind != N_T_STRUCT) {
		err_bref(lit.ref, g.t.src, g.t.src_len, "struct literal requires struct type");
	};
	let ty_stack: [32]uintptr = [0...];
	let lit_stack: [32]uintptr = [0...];
	let field_stack: [32]uintptr = [0...];
	let sp: size = 0;
	ty_stack[sp] = struct_ty: uintptr;
	lit_stack[sp] = lit: uintptr;
	field_stack[sp] = t_first(struct_ty): uintptr;
	sp += 1;
	for (sp > 0) {
		let idx = sp - 1;
		let cur_ty: *tnode = ty_stack[idx]: *tnode;
		let cur_lit: *tnode = lit_stack[idx]: *tnode;
		let field_opt: nullable *tnode = field_stack[idx]: uintptr: *tnode;
		if (field_opt == null) {
			sp -= 1;
			continue;
		};
		let field_node: *tnode = unwrap(field_opt);
		field_stack[idx] = field_node.next: uintptr;
		let field_ty_opt = t_first(field_node);
		let field_val_node: nullable *tnode = null;
		let lit_field = t_first(cur_lit);
		for (lit_field != null) {
			let lf: *tnode = unwrap(lit_field);
			if (bref_eq(lf.ref, field_node.ref, g.t.src)) {
				field_val_node = lf;
				break;
			};
			lit_field = lf.next;
		};
		if (field_ty_opt == null) {
			emit_s(&g.em, "\t.quad 0");
			e_nl(&g.em);
			continue;
		};
		let field_ty = unwrap(field_ty_opt);
		if (field_val_node != null) {
			let val_opt = t_first(unwrap(field_val_node));
			if (val_opt != null) {
				let val_node: *tnode = unwrap(val_opt);
				if (x86_type_is_struct(g, field_ty) && val_node.kind == N_STRUCT_LIT) {
					let resolved_field = resolve_alias_type(g, field_ty);
					if (resolved_field != null) { field_ty = unwrap(resolved_field); };
					if (sp >= len(ty_stack)) { abort("x86 struct data stack overflow"); };
					ty_stack[sp] = field_ty: uintptr;
					lit_stack[sp] = val_node: uintptr;
					field_stack[sp] = t_first(field_ty): uintptr;
					sp += 1;
					continue;
				};
				x86_emit_scalar_data(ctx, field_ty, val_node);
				continue;
			};
		};
		let zero_bytes = x86_type_slot_size(g, field_ty);
		emit_s(&g.em, "\t.zero ");
		e_i(&g.em, zero_bytes);
		e_nl(&g.em);
	};
};

fn x86_emit_global_var(ctx: *x86_ctx, n: *tnode) void = {
	let g = ctx.g;
	let ty: nullable *tnode = null;
	let init: nullable *tnode = null;
	x86_global_parts(n, &ty, &init);
	if (init == null) {
		err_bref(n.ref, g.t.src, g.t.src_len, "global requires initializer");
	};
	let is_const = (n.flags & F_MUTABLE) == 0;
	if (is_const) { emit_s(&g.em, ".section .rodata"); }
	else { emit_s(&g.em, ".data"); };
	e_nl(&g.em);
	emit_s(&g.em, ".align 8");
	e_nl(&g.em);
	if ((n.flags & F_EXPORTED) != 0) {
		emit_s(&g.em, ".globl ");
		e_prefixed_id(g, n.ref);
		e_nl(&g.em);
	};
	e_prefixed_id(g, n.ref);
	e_c(&g.em, ':');
	e_nl(&g.em);
	let init_nn: *tnode = unwrap(init);
	if (ty != null && x86_type_is_array(g, unwrap(ty)) && init_nn.kind == N_ARR_LIT) {
		x86_emit_array_data(ctx, unwrap(ty), init_nn);
	} else if (ty != null && x86_type_is_struct(g, unwrap(ty)) && init_nn.kind == N_STRUCT_LIT) {
		x86_emit_struct_data(ctx, unwrap(ty), init_nn);
	} else {
		x86_emit_scalar_data(ctx, ty, init_nn);
	};
};

fn x86_emit_static_var(ctx: *x86_ctx, label_id: i64, ty: nullable *tnode, init: nullable *tnode) void = {
	let g = ctx.g;
	if (init == null) { return; };
	emit_s(&g.em, ".data");
	e_nl(&g.em);
	emit_s(&g.em, ".align 8");
	e_nl(&g.em);
	x86_emit_label(&g.em, label_id);
	let init_nn: *tnode = unwrap(init);
	if (ty != null && x86_type_is_array(g, unwrap(ty)) && init_nn.kind == N_ARR_LIT) {
		x86_emit_array_data(ctx, unwrap(ty), init_nn);
	} else if (ty != null && x86_type_is_struct(g, unwrap(ty)) && init_nn.kind == N_STRUCT_LIT) {
		x86_emit_struct_data(ctx, unwrap(ty), init_nn);
	} else {
		x86_emit_scalar_data(ctx, ty, init_nn);
	};
};

fn x86_emit_globals(ctx: *x86_ctx, unit: *tnode) void = {
	let decl = t_first(unit);
	for (decl != null) {
		let d: *tnode = unwrap(decl);
		if (d.kind == N_GLOBAL) { x86_emit_global_var(ctx, d); };
		decl = d.next;
	};
	let i = 0z;
	for (i < ctx.static_count) {
		let s_label = ctx.static_label[i];
		let s_ty = ctx.static_ty[i]: uintptr: *tnode;
		let s_init = ctx.static_init[i]: uintptr: *tnode;
		x86_emit_static_var(ctx, s_label, s_ty, s_init);
		i += 1;
	};
};

fn x86_emit_arr_lit_rodata(ctx: *x86_ctx, lit: *tnode, elem_ty: *tnode, out_count: *i64) i64 = {
	let g = ctx.g;
	let data_id = x86_new_label(ctx);
	let count = arr_lit_count(lit): i64;
	*out_count = count;
	let elem_sz = x86_type_elem_slot_size(g, elem_ty);
	emit_s(&g.em, ".section .rodata");
	e_nl(&g.em);
	if (x86_type_is_str(g, elem_ty)) {
		let str_labels: [256]i64 = [0...];
		let str_lens: [256]i64 = [0...];
		let str_idx: i64 = 0;
		let elem = t_first(lit);
		for (elem != null) {
			let en: *tnode = unwrap(elem);
			if (!node_is_str(en)) {
				err_bref(en.ref, g.t.src, g.t.src_len, "non-literal str in slice literal");
			};
			if (str_idx >= 256) {
				err_bref(en.ref, g.t.src, g.t.src_len, "too many string literals in slice literal");
			};
			let data_label = x86_new_label(ctx);
			str_labels[str_idx: size] = data_label;
			emit_s(&g.em, ".L");
			e_i(&g.em, data_label);
			e_c(&g.em, ':');
			e_nl(&g.em);
			let slen_bytes = x86_emit_str_part_bytes(ctx, en);
			let child = t_first(en);
			for (child != null) {
				let cn: *tnode = unwrap(child);
				slen_bytes += x86_emit_str_part_bytes(ctx, cn);
				child = cn.next;
			};
			str_lens[str_idx: size] = slen_bytes: i64;
			str_idx += 1;
			elem = en.next;
		};
		emit_s(&g.em, ".L");
		e_i(&g.em, data_id);
		e_c(&g.em, ':');
		e_nl(&g.em);
		let elem2 = t_first(lit);
		let str_idx2: i64 = 0;
		for (elem2 != null) {
			let en2: *tnode = unwrap(elem2);
			emit_s(&g.em, "\t.quad .L");
			e_i(&g.em, str_labels[str_idx2: size]);
			e_nl(&g.em);
			emit_s(&g.em, "\t.quad ");
			e_i(&g.em, str_lens[str_idx2: size]);
			e_nl(&g.em);
			str_idx2 += 1;
			elem2 = en2.next;
		};
		emit_s(&g.em, ".text");
		e_nl(&g.em);
		return data_id;
	};

	emit_s(&g.em, ".L");
	e_i(&g.em, data_id);
	e_c(&g.em, ':');
	e_nl(&g.em);
	let elem3 = t_first(lit);
	for (elem3 != null) {
		let en3: *tnode = unwrap(elem3);
		if (en3.kind == N_FLOAT && x86_is_float_ty(g, elem_ty)) {
			let is_f32 = x86_type_prim_size(g, elem_ty) == 4;
			let lit_ref = en3.ref;
			let end = lit_ref.length;
			if (end >= 3) {
				let b0 = g.t.src[lit_ref.pos + end - 3];
				let b1 = g.t.src[lit_ref.pos + end - 2];
				let b2 = g.t.src[lit_ref.pos + end - 1];
				if (b0 == 'f' && b1 == '3' && b2 == '2') { lit_ref.length -= 3; }
				else if (b0 == 'f' && b1 == '6' && b2 == '4') { lit_ref.length -= 3; };
			};
			if (is_f32) { emit_s(&g.em, "\t.float "); }
			else { emit_s(&g.em, "\t.double "); };
			e_bref_no_underscore(&g.em, lit_ref);
			e_nl(&g.em);
		} else if (en3.kind == N_INT || en3.kind == N_BOOL || en3.kind == N_CHAR) {
			if (elem_sz == 1) { emit_s(&g.em, "\t.byte "); e_i(&g.em, en3.ival); e_nl(&g.em); }
			else if (elem_sz == 2) { emit_s(&g.em, "\t.word "); e_i(&g.em, en3.ival); e_nl(&g.em); }
			else if (elem_sz == 4) { emit_s(&g.em, "\t.long "); e_i(&g.em, en3.ival); e_nl(&g.em); }
			else { emit_s(&g.em, "\t.quad "); e_i(&g.em, en3.ival); e_nl(&g.em); };
		} else if (node_is_str(en3) && x86_type_is_str(g, elem_ty)) {
			void;
		} else {
			err_bref(en3.ref, g.t.src, g.t.src_len, "unsupported literal in slice literal");
		};
		elem3 = en3.next;
	};
	emit_s(&g.em, ".text");
	e_nl(&g.em);
	return data_id;
};

fn x86_emit_slice_from_arr_lit(ctx: *x86_ctx, lit: *tnode, elem_ty: *tnode) i64 = {
	let g = ctx.g;
	let count: i64 = 0;
	let data_id = x86_emit_arr_lit_rodata(ctx, lit, elem_ty, &count);
	let struct_id = x86_new_label(ctx);
	emit_s(&g.em, ".section .rodata");
	e_nl(&g.em);
	emit_s(&g.em, ".align 8");
	e_nl(&g.em);
	emit_s(&g.em, ".L");
	e_i(&g.em, struct_id);
	e_c(&g.em, ':');
	e_nl(&g.em);
	emit_s(&g.em, "\t.quad .L");
	e_i(&g.em, data_id);
	e_nl(&g.em);
	emit_s(&g.em, "\t.quad ");
	e_i(&g.em, count);
	e_nl(&g.em);
	emit_s(&g.em, "\t.quad ");
	e_i(&g.em, count);
	e_nl(&g.em);
	emit_s(&g.em, ".text");
	e_nl(&g.em);
	return struct_id;
};

// ============================================================================
// Local variable allocation
// ============================================================================

fn x86_pack_local(off: i64, sz: i64) u64 = {
	let o: u64 = off: u64;
	let s: u64 = sz: u64;
	return (s << 32) | (o & 0xffffffff);
};

fn x86_local_offset(g: *codegen, name: bref) i64 = {
	let packed = dict_get_bref(&g.static_vars, name);
	if (packed == 0) { return 0; };
	let off = packed & 0xffffffff;
	return off: i64;
};

fn x86_alloc_local(g: *codegen, name: bref, sz_in: i64, next_off: *i64) void = {
	if (dict_has_bref(&g.static_vars, name)) {
		err_bref(name, g.t.src, g.t.src_len,
			"variable shadowing is not allowed in pika (rename the variable)");
	};
	let sz = sz_in;
	if (sz <= 0) { sz = 8; };
	// Align to 8 bytes for simplicity
	let align_bytes: i64 = 8;
	let rem = (*next_off) % align_bytes;
	if (rem != 0) { *next_off += (align_bytes - rem); };
	*next_off += sz;
	let packed = x86_pack_local(*next_off, sz);
	dict_set_bref(&g.static_vars, name, packed);
};

fn x86_alloc_temp(next_off: *i64, sz_in: i64) i64 = {
	let sz = sz_in;
	if (sz <= 0) { sz = 8; };
	let align_bytes: i64 = 8;
	let rem = (*next_off) % align_bytes;
	if (rem != 0) { *next_off += (align_bytes - rem); };
	*next_off += sz;
	return *next_off;
};

fn x86_collect_match_exprs(g: *codegen, expr: *tnode, next_off: *i64) void = {
	let stack_exprs: [1024]uintptr = [0...];
	let top: size = 0;
	stack_exprs[top] = expr: uintptr;
	top += 1;
	for (top > 0) {
		top -= 1;
		let node: *tnode = stack_exprs[top]: *tnode;
		if (node.kind == N_MATCH) {
			let case_iter = case_list_first(node);
			for (case_iter != null) {
				let case_n: *tnode = unwrap(case_iter);
				if (case_has_binding(case_n)) {
					let binding = t_first(case_n);
					if (binding != null) {
						let bind_n: *tnode = unwrap(binding);
						let bind_ty = t_first(bind_n);
						let bind_sz = 8i64;
						if (bind_ty != null) { bind_sz = x86_type_slot_size(g, unwrap(bind_ty)); };
						x86_alloc_local(g, bind_n.ref, bind_sz, next_off);
					};
				};
				let case_body = case_body_node(case_n);
				if (case_body != null) {
					x86_collect_locals_stmt(g, unwrap(case_body), next_off);
				};
				case_iter = case_n.next;
			};
			continue;
		};
		let child = t_first(node);
		for (child != null) {
			let c: *tnode = unwrap(child);
			if (top < len(stack_exprs)) {
				stack_exprs[top] = c: uintptr;
				top += 1;
			};
			child = c.next;
		};
	};
};

fn x86_match_expr_push(ctx: *x86_ctx, ty: *tnode) i64 = {
	let g = ctx.g;
	let sz = x86_type_slot_size(g, ty);
	if (sz > ctx.struct_scratch_stride) {
		err_bref(ty.ref, g.t.src, g.t.src_len, "match expression result too large for scratch");
	};
	if (ctx.match_expr_depth >= 32: size) { abort("x86 match expr stack overflow"); };
	let off = x86_struct_scratch_alloc(ctx);
	let end_lbl = x86_new_label(ctx);
	ctx.match_expr_offs[ctx.match_expr_depth] = off;
	ctx.match_expr_labels[ctx.match_expr_depth] = end_lbl;
	ctx.match_expr_tys[ctx.match_expr_depth] = ty: uintptr;
	ctx.match_expr_depth += 1;
	return off;
};

fn x86_match_expr_pop(ctx: *x86_ctx) void = {
	if (ctx.match_expr_depth == 0) { abort("x86 match expr stack underflow"); };
	ctx.match_expr_depth -= 1;
};

fn x86_collect_locals_stmt(g: *codegen, n: *tnode, next_off: *i64) void = {
	// Non-recursive walk to find local declarations.
	let stack_nodes: [2048]uintptr = [0...];
	let stack_top: size = 0;
	stack_nodes[stack_top] = n: uintptr;
	stack_top += 1;
	for (stack_top > 0) {
		stack_top -= 1;
		let cur_node: *tnode = stack_nodes[stack_top]: *tnode;
		let cur_kind = cur_node.kind;
		if (cur_kind == N_LET) {
			if ((cur_node.flags & F_STATIC) != 0) { continue; };
			let let_child = t_first(cur_node);
			let let_ty: nullable *tnode = null;
			let let_init: nullable *tnode = null;
			match (let_child) {
			case let c: *tnode =>
				if (is_type_kind(c.kind)) {
					let_ty = c;
					let_init = c.next;
				} else {
					let_init = c;
				};
			case null => void;
			};
			let let_sz = 8i64;
			if (let_ty != null) {
				let_sz = x86_type_slot_size(g, unwrap(let_ty));
			} else if (let_init != null) {
				let let_init_kind = unwrap(let_init).kind;
				if (let_init_kind == N_STRUCT_LIT) {
					let_sz = x86_struct_slot_size(g, unwrap(let_init));
				} else if (let_init_kind == N_SLICE) {
					let_sz = 24;
				} else if (let_init_kind == N_STR || let_init_kind == N_RAWSTR) {
					let_sz = 16;
				} else {
					let let_init_ty = get_expr_type(g, unwrap(let_init));
					if (let_init_ty != null) { let_sz = x86_type_slot_size(g, unwrap(let_init_ty)); };
				};
			};
			x86_alloc_local(g, cur_node.ref, let_sz, next_off);
			if (let_init != null) { x86_collect_match_exprs(g, unwrap(let_init), next_off); };
			continue;
		};
		if (cur_kind == N_EXPR_STMT) {
			let expr_child = t_first(cur_node);
			if (expr_child != null) { x86_collect_match_exprs(g, unwrap(expr_child), next_off); };
			continue;
		};
		if (cur_kind == N_ASGN) {
			let asgn_target = t_first(cur_node);
			if (asgn_target != null) {
				let asgn_value = unwrap(asgn_target).next;
				if (asgn_value != null) { x86_collect_match_exprs(g, unwrap(asgn_value), next_off); };
			};
			continue;
		};
		if (cur_kind == N_RET) {
			let ret_child = t_first(cur_node);
			if (ret_child != null) { x86_collect_match_exprs(g, unwrap(ret_child), next_off); };
			continue;
		};
		if (cur_kind == N_YIELD) {
			let yield_child = t_first(cur_node);
			if (yield_child != null) { x86_collect_match_exprs(g, unwrap(yield_child), next_off); };
			continue;
		};
		if (cur_kind == N_BLOCK) {
			let block_child = t_first(cur_node);
			for (block_child != null) {
				if (stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = block_child: uintptr;
					stack_top += 1;
				};
				block_child = unwrap(block_child).next;
			};
			continue;
		};
		if (cur_kind == N_IF) {
			let if_cond = t_first(cur_node);
			if (if_cond != null) {
				x86_collect_match_exprs(g, unwrap(if_cond), next_off);
				let if_then_block = unwrap(if_cond).next;
				if (if_then_block != null && stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = unwrap(if_then_block): uintptr;
					stack_top += 1;
				};
				let if_else_block: nullable *tnode = null;
				if (if_then_block != null) { if_else_block = unwrap(if_then_block).next; };
				if (if_else_block != null && stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = unwrap(if_else_block): uintptr;
					stack_top += 1;
				};
			};
			continue;
		};
		if (cur_kind == N_FOR) {
			let for_child = t_first(cur_node);
			let for_has_init = (cur_node.ival & 1) != 0;
			let for_has_cond = (cur_node.ival & 2) != 0;
			let for_has_after = (cur_node.ival & 4) != 0;
			let for_is_while = (!for_has_init && !for_has_cond && !for_has_after) && ((cur_node.flags & F_NULLABLE) != 0);
			if (for_is_while) {
				if (for_child != null) {
					x86_collect_match_exprs(g, unwrap(for_child), next_off);
					let for_body = unwrap(for_child).next;
					if (for_body != null && stack_top < len(stack_nodes)) {
						stack_nodes[stack_top] = unwrap(for_body): uintptr;
						stack_top += 1;
					};
				};
				continue;
			};
			if (for_has_init && for_child != null && stack_top < len(stack_nodes)) {
				let init_node = unwrap(for_child);
				if (init_node.kind != N_ASGN && init_node.kind != N_LET && init_node.kind != N_BLOCK) {
					x86_collect_match_exprs(g, init_node, next_off);
				};
				stack_nodes[stack_top] = unwrap(for_child): uintptr;
				stack_top += 1;
				for_child = unwrap(for_child).next;
			};
			if (for_has_cond && for_child != null) {
				x86_collect_match_exprs(g, unwrap(for_child), next_off);
				for_child = unwrap(for_child).next;
			};
			if (for_has_after && for_child != null) {
				x86_collect_match_exprs(g, unwrap(for_child), next_off);
				for_child = unwrap(for_child).next;
			};
			if (for_child != null && stack_top < len(stack_nodes)) {
				stack_nodes[stack_top] = unwrap(for_child): uintptr;
				stack_top += 1;
			};
			continue;
		};
		if (cur_kind == N_SWITCH || cur_kind == N_MATCH) {
			let case_iter = case_list_first(cur_node);
			for (case_iter != null) {
				let case_n: *tnode = unwrap(case_iter);
				if (case_has_binding(case_n)) {
					let binding = t_first(case_n);
					if (binding != null) {
						let bind_n: *tnode = unwrap(binding);
						let bind_ty = t_first(bind_n);
						let bind_sz = 8i64;
						if (bind_ty != null) { bind_sz = x86_type_slot_size(g, unwrap(bind_ty)); };
						x86_alloc_local(g, bind_n.ref, bind_sz, next_off);
					};
				};
				let case_body = case_body_node(case_n);
				if (case_body != null && stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = unwrap(case_body): uintptr;
					stack_top += 1;
				};
				case_iter = case_n.next;
			};
			continue;
		};
	};
};

fn x86_collect_static_locals(ctx: *x86_ctx, fn_node: *tnode) void = {
	let g = ctx.g;
	let ret_type = g_skip_to_ret(fn_node);
	let body: *tnode = t_new(g.t, N_BLOCK);
	if (ret_type != null) { body = t_next_nn(unwrap(ret_type)); };
	let stack_nodes: [2048]uintptr = [0...];
	let stack_top: size = 0;
	stack_nodes[stack_top] = body: uintptr;
	stack_top += 1;
	for (stack_top > 0) {
		stack_top -= 1;
		let cur_node: *tnode = stack_nodes[stack_top]: *tnode;
		let cur_kind = cur_node.kind;
		if (cur_kind == N_LET && (cur_node.flags & F_STATIC) != 0) {
			x86_static_add(ctx, fn_node.ref, cur_node);
			continue;
		};
		if (cur_kind == N_BLOCK) {
			let block_child = t_first(cur_node);
			for (block_child != null) {
				if (stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = block_child: uintptr;
					stack_top += 1;
				};
				block_child = unwrap(block_child).next;
			};
			continue;
		};
		if (cur_kind == N_IF) {
			let if_cond = t_first(cur_node);
			if (if_cond != null) {
				let if_then_block = unwrap(if_cond).next;
				if (if_then_block != null && stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = unwrap(if_then_block): uintptr;
					stack_top += 1;
				};
				let if_else_block: nullable *tnode = null;
				if (if_then_block != null) { if_else_block = unwrap(if_then_block).next; };
				if (if_else_block != null && stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = unwrap(if_else_block): uintptr;
					stack_top += 1;
				};
			};
			continue;
		};
		if (cur_kind == N_FOR) {
			let for_child = t_first(cur_node);
			let for_has_init = (cur_node.ival & 1) != 0;
			let for_has_cond = (cur_node.ival & 2) != 0;
			let for_has_after = (cur_node.ival & 4) != 0;
			let for_is_while = (!for_has_init && !for_has_cond && !for_has_after) && ((cur_node.flags & F_NULLABLE) != 0);
			if (for_is_while) {
				if (for_child != null) {
					let for_body = unwrap(for_child).next;
					if (for_body != null && stack_top < len(stack_nodes)) {
						stack_nodes[stack_top] = unwrap(for_body): uintptr;
						stack_top += 1;
					};
				};
				continue;
			};
			if (for_has_init && for_child != null && stack_top < len(stack_nodes)) {
				stack_nodes[stack_top] = unwrap(for_child): uintptr;
				stack_top += 1;
				for_child = unwrap(for_child).next;
			};
			if (for_has_cond && for_child != null) { for_child = unwrap(for_child).next; };
			if (for_has_after && for_child != null) { for_child = unwrap(for_child).next; };
			if (for_child != null && stack_top < len(stack_nodes)) {
				stack_nodes[stack_top] = unwrap(for_child): uintptr;
				stack_top += 1;
			};
			continue;
		};
		if (cur_kind == N_SWITCH || cur_kind == N_MATCH) {
			let case_iter = case_list_first(cur_node);
			for (case_iter != null) {
				let case_n: *tnode = unwrap(case_iter);
				let case_body = case_body_node(case_n);
				if (case_body != null && stack_top < len(stack_nodes)) {
					stack_nodes[stack_top] = unwrap(case_body): uintptr;
					stack_top += 1;
				};
				case_iter = case_n.next;
			};
			continue;
		};
	};
};

// ============================================================================
// Expression emission (result in %rax or %xmm0)
// ============================================================================

fn x86_emit_float_literal(ctx: *x86_ctx, lit: *tnode, is_f32: bool) void = {
	let id = x86_new_label(ctx);
	emit_s(&ctx.g.em, ".section .rodata");
	e_nl(&ctx.g.em);
	let r = lit.ref;
	let end = r.length;
	if (end >= 3) {
		let b0 = ctx.g.t.src[r.pos + end - 3];
		let b1 = ctx.g.t.src[r.pos + end - 2];
		let b2 = ctx.g.t.src[r.pos + end - 1];
		if (b0 == 'f' && b1 == '3' && b2 == '2') { r.length -= 3; }
		else if (b0 == 'f' && b1 == '6' && b2 == '4') { r.length -= 3; };
	};
	emit_s(&ctx.g.em, ".L");
	e_i(&ctx.g.em, id);
	e_c(&ctx.g.em, ':');
	e_nl(&ctx.g.em);
	if (is_f32) {
		emit_s(&ctx.g.em, "\t.float ");
		e_bref_no_underscore(&ctx.g.em, r);
		e_nl(&ctx.g.em);
	} else {
		emit_s(&ctx.g.em, "\t.double ");
		e_bref_no_underscore(&ctx.g.em, r);
		e_nl(&ctx.g.em);
	};
	emit_s(&ctx.g.em, ".text");
	e_nl(&ctx.g.em);
	if (is_f32) { emit_s(&ctx.g.em, "\tmovss .L"); }
	else { emit_s(&ctx.g.em, "\tmovsd .L"); };
	e_i(&ctx.g.em, id);
	emit_s(&ctx.g.em, "(%rip), %xmm0");
	e_nl(&ctx.g.em);
};

fn x86_emit_float_literal_to(ctx: *x86_ctx, r: bref, is_f32: bool, dst: str) void = {
	let id = x86_new_label(ctx);
	let lit = r;
	let end = lit.length;
	if (end >= 3) {
		let b0 = ctx.g.t.src[lit.pos + end - 3];
		let b1 = ctx.g.t.src[lit.pos + end - 2];
		let b2 = ctx.g.t.src[lit.pos + end - 1];
		if (b0 == 'f' && b1 == '3' && b2 == '2') { lit.length -= 3; }
		else if (b0 == 'f' && b1 == '6' && b2 == '4') { lit.length -= 3; };
	};
	emit_s(&ctx.g.em, ".section .rodata");
	e_nl(&ctx.g.em);
	emit_s(&ctx.g.em, ".L");
	e_i(&ctx.g.em, id);
	e_c(&ctx.g.em, ':');
	e_nl(&ctx.g.em);
	if (is_f32) {
		emit_s(&ctx.g.em, "\t.float ");
		e_bref_no_underscore(&ctx.g.em, lit);
		e_nl(&ctx.g.em);
	} else {
		emit_s(&ctx.g.em, "\t.double ");
		e_bref_no_underscore(&ctx.g.em, lit);
		e_nl(&ctx.g.em);
	};
	emit_s(&ctx.g.em, ".text");
	e_nl(&ctx.g.em);
	emit_s(&ctx.g.em, "\t");
	if (is_f32) { emit_s(&ctx.g.em, "movss .L"); }
	else { emit_s(&ctx.g.em, "movsd .L"); };
	e_i(&ctx.g.em, id);
	emit_s(&ctx.g.em, "(%rip), %");
	emit_s(&ctx.g.em, dst);
	e_nl(&ctx.g.em);
};

fn x86_emit_sign_mask(ctx: *x86_ctx, is_f32: bool) i64 = {
	let id = x86_new_label(ctx);
	emit_s(&ctx.g.em, ".section .rodata");
	e_nl(&ctx.g.em);
	emit_s(&ctx.g.em, ".L");
	e_i(&ctx.g.em, id);
	e_c(&ctx.g.em, ':');
	e_nl(&ctx.g.em);
	if (is_f32) {
		emit_s(&ctx.g.em, "\t.long 0x80000000");
		e_nl(&ctx.g.em);
		emit_s(&ctx.g.em, "\t.long 0x80000000");
		e_nl(&ctx.g.em);
		emit_s(&ctx.g.em, "\t.long 0x80000000");
		e_nl(&ctx.g.em);
		emit_s(&ctx.g.em, "\t.long 0x80000000");
		e_nl(&ctx.g.em);
	} else {
		emit_s(&ctx.g.em, "\t.quad 0x8000000000000000");
		e_nl(&ctx.g.em);
		emit_s(&ctx.g.em, "\t.quad 0x8000000000000000");
		e_nl(&ctx.g.em);
	};
	emit_s(&ctx.g.em, ".text");
	e_nl(&ctx.g.em);
	return id;
};
// ============================================================================
// Expression emission (iterative state machine)
// ============================================================================

fn x86_eval(ctx: *x86_ctx, root: *tnode, want_addr: bool) bool = {
	let g = ctx.g;
	let stack: [512]x86_eval_frame = [x86_eval_frame {
		node = null,
		state = 0,
		want_addr = false,
		use_float = false,
		float_is_f32 = false,
		lhs_is_float = false,
		rhs_is_float = false,
		target_is_float = false,
		cast_from_tagged = false,
		cast_payload_ty = null,
		base_is_ptr = false,
		field_deref = 0,
		field_off = 0,
		field_ty = null,
		init_node = null,
		arg_count = 0,
		arg_index = 0,
		arg_nodes = [0...],
		arg_is_float = [false...],
		arg_kind = [0...],
		arg_slots = [0...],
		arg_scratch = [0...],
		arg_expected = [0...],
		scratch_next = 0,
		call_scratch_base = 0,
		idx_is_slice = false,
		idx_is_ptr_slice = false,
		idx_is_ptr_uarr = false,
		idx_deref = 0,
		idx_elem_size = 0,
		idx_elem_ty = null,
		slice_kind = 0,
		slice_elem_ty = null,
		slice_base_len = 0,
	}...];
	let sp: size = 0;
	let stack_ptr = (&stack[0]): *[*]x86_eval_frame;
	x86_eval_push(stack_ptr, &sp, root, want_addr);
	let last_is_float = false;
	for (sp > 0) {
		let idx = sp - 1;
		let fr: *x86_eval_frame = &stack[idx];
		let eval_node_opt = fr.node;
		if (eval_node_opt == null) { abort("x86_eval null node"); };
		let n: *tnode = unwrap(eval_node_opt);
		let k = n.kind;
		if (fr.state == 0) {
			if (fr.want_addr) {
				if (k == N_ID) {
					let addr_off = x86_local_offset(g, n.ref);
					if (addr_off != 0) {
						x86_emit_ins_pre_i_suf(&g.em, "leaq -", addr_off, "(%rbp), %rax");
					} else {
						let static_id_addr = x86_static_find(ctx, n.ref, g.cur_fn);
						if (static_id_addr != 0) {
							emit_s(&g.em, "\tleaq ");
							x86_emit_label_ref(&g.em, static_id_addr);
							emit_s(&g.em, "(%rip), %rax");
							e_nl(&g.em);
						} else {
							let glob_ptr_addr = dict_get_bref(&g.globals, n.ref);
							if (glob_ptr_addr == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown local in address"); };
							let gnode_addr: *tnode = glob_ptr_addr: uintptr: *tnode;
							if (gnode_addr.kind != N_GLOBAL) { err_bref(n.ref, g.t.src, g.t.src_len, "unsupported address-of target"); };
							emit_s(&g.em, "\tleaq ");
							e_prefixed_id(g, n.ref);
							emit_s(&g.em, "(%rip), %rax");
							e_nl(&g.em);
						};
					};
					last_is_float = false;
					sp -= 1;
					continue;
				};
				if (k == N_UN && n.ival == TK_STAR: i64) {
					fr.state = 1;
					let un_inner_addr = t_first_nn(n);
					x86_eval_push(stack_ptr, &sp, un_inner_addr, false);
					continue;
				};
				if (k == N_IDX) {
					x86_idx_setup(g, fr, n);
					fr.state = 1;
					let idx_base_addr = t_first_nn(n);
					x86_eval_push(stack_ptr, &sp, idx_base_addr, false);
					continue;
				};
				if (k == N_FLD) {
					let fld_base_addr = t_first_nn(n);
					x86_field_setup(g, fr, n, fld_base_addr);
					fr.state = 1;
					let fld_base_want_addr = !fr.base_is_ptr;
					x86_eval_push(stack_ptr, &sp, fld_base_addr, fld_base_want_addr);
					continue;
				};
				err_bref(n.ref, g.t.src, g.t.src_len, "unsupported lvalue in x86_64 backend");
			} else {
				if (k == N_NULL) {
					x86_emit_ins(&g.em, "xorl %eax, %eax");
					last_is_float = false;
					sp -= 1;
					continue;
				};
				if (k == N_INT || k == N_BOOL || k == N_CHAR) {
					x86_emit_ins_pre_i_suf(&g.em, "movq $", n.ival, ", %rax");
					last_is_float = false;
					sp -= 1;
					continue;
				};
				if (k == N_FLOAT) {
					let is_f32_lit = false;
					let float_ty_opt = get_expr_type(g, n);
					if (float_ty_opt != null) {
						let float_ty_val = unwrap(float_ty_opt);
						let float_res_val = resolve_alias_type(g, float_ty_val);
						if (float_res_val != null) { float_ty_val = unwrap(float_res_val); };
						if (x86_is_float_ty(g, float_ty_val) && x86_type_prim_size(g, float_ty_val) == 4) {
							is_f32_lit = true;
						};
					};
					if (!is_f32_lit) {
						let r = n.ref;
						let end = r.length;
						if (end >= 3) {
							let b0 = g.t.src[r.pos + end - 3];
							let b1 = g.t.src[r.pos + end - 2];
							let b2 = g.t.src[r.pos + end - 1];
							if (b0 == 'f' && b1 == '3' && b2 == '2') { is_f32_lit = true; };
						};
					};
					x86_emit_float_literal(ctx, n, is_f32_lit);
					last_is_float = true;
					sp -= 1;
					continue;
				};
			if (k == N_STR || k == N_RAWSTR) {
				let str_label = x86_emit_str_literal(ctx, n);
				emit_s(&g.em, "\tleaq .L");
				e_i(&g.em, str_label);
				emit_s(&g.em, "(%rip), %rax");
				e_nl(&g.em);
				last_is_float = false;
				sp -= 1;
				continue;
			};
			if (k == N_MATCH) {
				let match_ty_opt = get_expr_type(g, n);
				if (match_ty_opt == null) {
					err_bref(n.ref, g.t.src, g.t.src_len, "match expression type unknown");
				};
				let match_ty: *tnode = unwrap(match_ty_opt);
				let match_off = x86_match_expr_push(ctx, match_ty);
				let match_end = ctx.match_expr_labels[ctx.match_expr_depth - 1];
				x86_stmt(ctx, n);
				x86_emit_label(&g.em, match_end);
				x86_emit_ins_pre_i_suf(&g.em, "leaq -", match_off, "(%rbp), %rax");
				last_is_float = x86_load_from_addr(ctx, match_ty);
				x86_match_expr_pop(ctx);
				sp -= 1;
				continue;
			};
			if (k == N_STRUCT_LIT) {
				let type_ptr = dict_get_bref(&g.types, n.ref);
				if (type_ptr == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown struct type"); };
				let struct_ty: *tnode = type_ptr: uintptr: *tnode;
					let scratch_off = x86_struct_scratch_alloc(ctx);
					x86_emit_struct_lit_to_off(ctx, struct_ty, n, scratch_off);
					x86_emit_ins_pre_i_suf(&g.em, "leaq -", scratch_off, "(%rbp), %rax");
					last_is_float = false;
					sp -= 1;
					continue;
				};
				if (k == N_QUAL_ID) {
					let mod_ref = bref_empty();
					let member_ref = bref_empty();
					if (!qual_id_parts(g, n, &mod_ref, &member_ref)) {
						err_bref(n.ref, g.t.src, g.t.src_len, "invalid qualified id");
					};
					let ty_ptr = dict_get_bref(&g.types, mod_ref);
					if (ty_ptr != 0) {
						let enum_ty: *tnode = ty_ptr: uintptr: *tnode;
						if (x86_type_is_enum(g, enum_ty)) {
							let val = x86_enum_member_value(g, enum_ty, member_ref);
							x86_emit_ins_pre_i_suf(&g.em, "movq $", val, ", %rax");
							last_is_float = false;
							sp -= 1;
							continue;
						};
					};
					err_bref(n.ref, g.t.src, g.t.src_len, "unsupported qualified id in x86_64 backend");
				};
				if (expr_is_void_literal(n, g.t.src)) {
					x86_emit_ins(&g.em, "xorl %eax, %eax");
					last_is_float = false;
					sp -= 1;
					continue;
				};
				if (k == N_ID) {
					let id_ty_opt_eval = get_expr_type(g, n);
					if (id_ty_opt_eval != null && (x86_type_is_slice(g, unwrap(id_ty_opt_eval)) || x86_type_is_str(g, unwrap(id_ty_opt_eval)) || x86_type_is_array(g, unwrap(id_ty_opt_eval)) || x86_type_is_struct(g, unwrap(id_ty_opt_eval)) || x86_type_is_tagged(g, unwrap(id_ty_opt_eval)))) {
						let addr_off_eval = x86_local_offset(g, n.ref);
						if (addr_off_eval != 0) {
							x86_emit_ins_pre_i_suf(&g.em, "leaq -", addr_off_eval, "(%rbp), %rax");
						} else {
						let static_id_agg = x86_static_find(ctx, n.ref, g.cur_fn);
						if (static_id_agg != 0) {
							emit_s(&g.em, "\tleaq ");
							x86_emit_label_ref(&g.em, static_id_agg);
							emit_s(&g.em, "(%rip), %rax");
							e_nl(&g.em);
						} else {
								let glob_ptr_agg = dict_get_bref(&g.globals, n.ref);
								if (glob_ptr_agg == 0) { err_bref(n.ref, g.t.src, g.t.src_len, "unknown global"); };
								let gnode_agg: *tnode = glob_ptr_agg: uintptr: *tnode;
								if (gnode_agg.kind != N_GLOBAL) { err_bref(n.ref, g.t.src, g.t.src_len, "unsupported global reference"); };
								emit_s(&g.em, "\tleaq ");
								e_prefixed_id(g, n.ref);
								emit_s(&g.em, "(%rip), %rax");
								e_nl(&g.em);
							};
						};
						last_is_float = false;
						sp -= 1;
						continue;
					};
					let id_off_eval = x86_local_offset(g, n.ref);
					if (id_off_eval != 0) {
						if (x86_expr_is_float(g, n)) {
							x86_emit_ins_pre_i_suf(&g.em, "movsd -", id_off_eval, "(%rbp), %xmm0");
							last_is_float = true;
						} else {
							x86_emit_ins_pre_i_suf(&g.em, "movq -", id_off_eval, "(%rbp), %rax");
							last_is_float = false;
						};
						sp -= 1;
						continue;
					};
					let static_id_val = x86_static_find(ctx, n.ref, g.cur_fn);
					if (static_id_val != 0) {
						if (x86_expr_is_float(g, n)) {
							emit_s(&g.em, "\tmovsd ");
							x86_emit_label_ref(&g.em, static_id_val);
							emit_s(&g.em, "(%rip), %xmm0");
							e_nl(&g.em);
							last_is_float = true;
						} else {
							emit_s(&g.em, "\tmovq ");
							x86_emit_label_ref(&g.em, static_id_val);
							emit_s(&g.em, "(%rip), %rax");
							e_nl(&g.em);
							last_is_float = false;
						};
						sp -= 1;
						continue;
					};
					let id_glob_ptr_eval = dict_get_bref(&g.globals, n.ref);
					if (id_glob_ptr_eval != 0) {
						let id_gnode_eval: *tnode = id_glob_ptr_eval: uintptr: *tnode;
						if (id_gnode_eval.kind == N_GLOBAL) {
							let gty_eval: nullable *tnode = null;
							let ginit_eval: nullable *tnode = null;
							x86_global_parts(id_gnode_eval, &gty_eval, &ginit_eval);
							if ((gty_eval != null && (x86_type_is_array(g, unwrap(gty_eval)) || x86_type_is_struct(g, unwrap(gty_eval)) || x86_type_is_str(g, unwrap(gty_eval)) || x86_type_is_slice(g, unwrap(gty_eval)) || x86_type_is_tagged(g, unwrap(gty_eval))))
								|| (gty_eval == null && ginit_eval != null && (unwrap(ginit_eval).kind == N_ARR_LIT || unwrap(ginit_eval).kind == N_STRUCT_LIT || unwrap(ginit_eval).kind == N_STR || unwrap(ginit_eval).kind == N_RAWSTR))) {
								emit_s(&g.em, "\tleaq ");
								e_prefixed_id(g, n.ref);
								emit_s(&g.em, "(%rip), %rax");
								e_nl(&g.em);
								last_is_float = false;
								sp -= 1;
								continue;
							};
						};
						if (id_gnode_eval.kind == N_GLOBAL) {
							if (x86_expr_is_float(g, n)) {
								emit_s(&g.em, "\tmovsd ");
								e_prefixed_id(g, n.ref);
								emit_s(&g.em, "(%rip), %xmm0");
								e_nl(&g.em);
								last_is_float = true;
							} else {
								emit_s(&g.em, "\tmovq ");
								e_prefixed_id(g, n.ref);
								emit_s(&g.em, "(%rip), %rax");
								e_nl(&g.em);
								last_is_float = false;
							};
							sp -= 1;
							continue;
						};
						if (id_gnode_eval.kind == N_DEF) {
							let id_child_eval = t_first(id_gnode_eval);
							let id_init_eval: nullable *tnode = null;
							if (id_child_eval != null && is_type_kind(unwrap(id_child_eval).kind)) {
								id_init_eval = unwrap(id_child_eval).next;
							} else {
								id_init_eval = id_child_eval;
							};
							if (id_init_eval != null) {
								fr.state = 1;
								fr.init_node = unwrap(id_init_eval);
								x86_eval_push(stack_ptr, &sp, unwrap(id_init_eval), false);
								continue;
							};
						};
					};
					if (!dict_has_bref(&g.vars, n.ref) && !dict_has_bref(&g.globals, n.ref) && !dict_has_bref(&g.funcs, n.ref)) {
						let type_def = dict_get_bref(&g.types, n.ref);
						if (type_def != 0) {
							match (resolve_alias_type(g, type_def: uintptr: *tnode)) {
							case let resolved: *tnode =>
