					last_is_float = false;
					sp -= 1;
					continue;
				};
			} else {
				if (k == N_ID && fr.init_node != null) {
					sp -= 1;
					continue;
				};
				if (k == N_UN) {
					let un_op_eval2 = n.ival: u16;
					if (un_op_eval2 == TK_AMP) {
						last_is_float = false;
						sp -= 1;
						continue;
					};
					if (un_op_eval2 == TK_STAR) {
						let un_ty_opt_eval2 = get_expr_type(g, n);
						if (un_ty_opt_eval2 != null) { last_is_float = x86_load_from_addr(ctx, unwrap(un_ty_opt_eval2)); }
						else {
							x86_emit_ins(&g.em, "movq (%rax), %rax");
							last_is_float = false;
						};
						sp -= 1;
						continue;
					};
					if (un_op_eval2 == TK_MINUS) {
						if (last_is_float) {
							let un_ty_opt_neg = get_expr_type(g, n);
							let un_is_f32 = false;
							if (un_ty_opt_neg != null) {
								let un_ty_eval2 = unwrap(un_ty_opt_neg);
								if (x86_is_float_ty(g, un_ty_eval2) && x86_type_prim_size(g, un_ty_eval2) == 4) {
									un_is_f32 = true;
								};
							};
							if (un_is_f32) {
								x86_emit_ins(&g.em, "xorps %xmm1, %xmm1");
								x86_emit_ins(&g.em, "subss %xmm0, %xmm1");
								x86_emit_ins(&g.em, "movaps %xmm1, %xmm0");
							} else {
								x86_emit_ins(&g.em, "xorpd %xmm1, %xmm1");
								x86_emit_ins(&g.em, "subsd %xmm0, %xmm1");
								x86_emit_ins(&g.em, "movapd %xmm1, %xmm0");
