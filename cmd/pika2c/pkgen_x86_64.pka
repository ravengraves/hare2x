				};
				if (k == N_CALL) {
					let call_fn_node_eval = t_first(n);
					if (call_fn_node_eval == null) {
						last_is_float = false;
						sp -= 1;
						continue;
					};
					let call_fn_eval: *tnode = unwrap(call_fn_node_eval);
					fr.arg_count = 0;
					fr.arg_index = 0;
					let call_param_opt_eval: nullable *tnode = null;
					let call_fn_def_ptr_eval = 0u64;
					if (call_fn_eval.kind == N_ID) { call_fn_def_ptr_eval = dict_get_bref(&g.globals, call_fn_eval.ref); };
					if (call_fn_def_ptr_eval != 0) {
						let call_fn_def_eval: *tnode = call_fn_def_ptr_eval: uintptr: *tnode;
						if (call_fn_def_eval.kind == N_FN) { call_param_opt_eval = g_skip_symbol(call_fn_def_eval); };
					};
					let call_arg_iter_eval = call_fn_eval.next;
					let call_arg_opt_eval = call_arg_iter_eval;
					let call_have_defaults_eval = call_param_opt_eval != null;
					if (call_have_defaults_eval) {
						for (true) {
							let call_arg_info_eval = call_arg_next(g, call_fn_eval.ref, &call_param_opt_eval, &call_arg_opt_eval);
							if (call_arg_info_eval.arg == null && call_arg_info_eval.param == null) { break; };
							let call_arg_node_eval: *tnode = unwrap(call_arg_info_eval.arg);
							if (fr.arg_count >= len(fr.arg_nodes): u8) {
