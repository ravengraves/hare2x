					};
					fr.slice_elem_ty = t_first(arr_ty);
					fr.state = 1;
					x86_eval_push(stack_ptr, &sp, slice_arr, false);
					continue;
				};
				if (k == N_ARR_LIT) {
					let arr_lit_ty_opt = get_expr_type(g, n);
					if (arr_lit_ty_opt != null && x86_type_is_slice(g, unwrap(arr_lit_ty_opt))) {
						let slice_ty: *tnode = unwrap(arr_lit_ty_opt);
						let elem_opt = t_first(slice_ty);
						if (elem_opt == null) { err_bref(n.ref, g.t.src, g.t.src_len, "slice literal missing element type"); };
						let slice_label = x86_emit_slice_from_arr_lit(ctx, n, unwrap(elem_opt));
