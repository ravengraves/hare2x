// strings.ha - String and character literal tests
// Note: In Pika, strings become u8 arrays
use rt;
use strings;

// Character literal
export fn get_newline() u8 = {
	return '\n';
};

// Character literal with escape
export fn get_tab() u8 = {
	return '\t';
};

// String length (manual, no recursion)
export fn str_len(s: *u8) size = {
	let p = s: *[*]u8;
	let i = 0z;
	for (p[i] != 0) {
		i += 1;
	};
	return i;
};

// String compare (returns true if equal)
export fn str_eq(a: *u8, b: *u8) bool = {
	let pa = a: *[*]u8;
	let pb = b: *[*]u8;
	let i = 0z;
	for (pa[i] != 0 && pb[i] != 0) {
		if (pa[i] != pb[i]) {
			return false;
		};
		i += 1;
	};
	return pa[i] == pb[i];
};

// Copy string (iterative)
export fn str_copy(dst: *u8, src: *u8) void = {
	let pd = dst: *[*]u8;
	let ps = src: *[*]u8;
	let i = 0z;
	for (ps[i] != 0) {
		pd[i] = ps[i];
		i += 1;
	};
	pd[i] = 0;
};

// Character class checks
export fn is_digit(c: u8) bool = {
	return c >= '0' && c <= '9';
};

export fn is_alpha(c: u8) bool = {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
};

export fn is_space(c: u8) bool = {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r';
};

// Parse simple integer from string
export fn parse_int(s: *u8) i32 = {
	let p = s: *[*]u8;
	let result: i32 = 0;
	let neg = false;
	let i = 0z;

	// Handle sign
	if (p[i] == '-') {
		neg = true;
		i += 1;
	};

	// Parse digits
	for (p[i] != 0 && is_digit(p[i])) {
		result = result * 10 + (p[i] - '0'): i32;
		i += 1;
	};

	if (neg) {
		return -result;
	};
	return result;
};

export fn hello() void = {
	// string array
    const greetings: []str = [
		"Hello, world!",
		"¡Hola Mundo!",
		"Γειά σου Κόσμε!",
		"Привіт, світе!",
		"こんにちは世界！",
	];

	for (let i=0z; i<len(greetings); i += 1) {
		 print(greetings[i]);
	};
};

fn print(msg: str) void = {
	rt::write(1, strings::toutf8(msg): *[*]u8, len(msg));
};

export fn main() void = {
	let nl = get_newline();
	let tab = get_tab();

	let hello_buf: [6]u8 = ['H', 'e', 'l', 'l', 'o', 0];
	let hlen = str_len(&hello_buf[0]);

	let d = is_digit('5');
	let a = is_alpha('x');
	let s = is_space(' ');

	let num: [4]u8 = ['-', '4', '2', 0];
	let val = parse_int(&num[0]);
	hello();
};
