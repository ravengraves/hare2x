// numeric_underscores.pka - Numeric literal underscores

export fn main() void = {
	let dec: int = 1_000_000;
	let hex: u32 = 0xFF_FFu32;
	let oct: u16 = 0o77_77u16;
	let bin: u16 = 0b1010_1010u16;
	let f0: f64 = 3.14_159f64;
	let f1: f64 = 1_00.0_0f64;
	let f2: f64 = 1e10f64;

	assert(dec == 1000000);
	assert(hex == 0xFFFFu32);
	assert(oct == 0o7777u16);
	assert(bin == 0b10101010u16);
	assert(f0 == 3.14159f64);
	assert(f1 == 100.00f64);
	assert(f2 == 1e10f64);
};
