// types.ha - Type system tests

// Struct type
// ERROR: This type is not exported but used in exported function (line 43)
// Expected: "Can't use unexported type point in exported declaration"
// Fix: Add 'export' keyword: export type point = struct { ... };
type point = struct {
	x: i32,
	y: i32,
};

// Nested struct
type rect = struct {
	origin: point,
	width: i32,
	height: i32,
};

// Enum type
// ERROR: This type is not exported but used in exported function (line 48)
// Expected: "Can't use unexported type color in exported declaration"
// Fix: Add 'export' keyword: export type color = enum u8 { ... };
type color = enum u8 {
	RED = 0,
	GREEN = 1,
	BLUE = 2,
};

// Tagged union
type result = (i32 | bool);

// Pointer types
type ptr_i32 = *i32;
type nullable_ptr = nullable *i32;

// Array types
type arr10 = [10]i32;

// Slice types
type slice_i32 = []i32;

// Function using structs
export fn make_point(x: i32, y: i32) point = {
	return point { x = x, y = y };
};

// Function using enum
export fn get_red() color = {
	return color::RED;
};

// Function with pointers
export fn increment(p: *i32) void = {
	*p = *p + 1;
};

export fn _main() void = {
	let p = make_point(10, 20);
	let c = get_red();
	let val: i32 = 42;
	increment(&val);
};
