// interop.ha - Test @symbol attribute for C interop
use rt;

// Function with custom C symbol name
// ERROR on next line: @symbol and export must be on same line
// Expected: "/tmp/interop.ha:6:1: syntax error: expected 'const', 'let', 'def', 'type', 'fn', found 'export'"
// Fix: Put on same line: export @symbol("my_c_function") fn my_c_function() i32 = {
@symbol("my_c_function")
export fn my_c_function() i32 = {
	return 42;
};

// Another example - exposed as compute_sum in C
@symbol("compute_sum")
fn compute_sum(a: i32, b: i32) i32 = {
	return a + b;
};

// Regular function (no @symbol)
fn regular_func() i32 = {
	return 100;
};

export fn _main() void = {
	// Call the @symbol functions by their symbol name
	let x = my_c_function();
	assert(x == 42);

	let y = compute_sum(10, 20);
	assert(y == 30);

	// Regular function works as normal
	let z = regular_func();
	assert(z == 100);
};
