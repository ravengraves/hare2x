// defaults.pka - Test default arguments
use rt;

fn add3(a: i32, b: i32 = 5, c: i32 = 7) i32 = {
	return a + b + c;
};

@symbol("sum_with_default") fn sum_with_default(a: i32, b: i32 = 9) i32 = {
	return a + b;
};

fn scale(v: f32, factor: f32 = 2.5) f32 = {
	return v * factor;
};

export fn main() void = {
	let t0 = add3(1, 2, 3);
	assert(t0 == 6);

	let t1 = add3(1, 2);
	assert(t1 == 10);

	let t2 = add3(1);
	assert(t2 == 13);

	let s0 = sum_with_default(4);
	assert(s0 == 13);

	let f0 = scale(2.0);
	assert(f0 == 5.0);

	let f1 = scale(2.0, 1.5);
	assert(f1 == 3.0);
};
