// Pika string/char escape coverage (Hare-style escapes)
use rt;
use strings;

export fn main() void = {
	let s1: str = "\x41\o0101\O00000101";
	let b1 = strings::toutf8(s1);
	assert(len(b1) == 3);
	assert(b1[0] == 'A');
	assert(b1[1] == 'A');
	assert(b1[2] == 'A');

	let s2: str = "\u00E9";
	let b2 = strings::toutf8(s2);
	assert(len(b2) == 2);

	let s3: str = "\U0001F600";
	let b3 = strings::toutf8(s3);
	assert(len(b3) == 4);

	let c1: u8 = '\x41';
	let c2: u8 = '\o0101';
	let c3: u8 = '\O00000101';
	let c4: u8 = '\u0041';
	let c5: u8 = '\U00000041';
	assert(c1 == 'A');
	assert(c2 == 'A');
	assert(c3 == 'A');
	assert(c4 == 'A');
	assert(c5 == 'A');
};
