// Test yield in if and switch expressions

export fn test_if_yield() i32 = {
    let x = 5;
    let y: i32 = if (x > 0) { yield 1; } else { yield -1; };
    return y;
};

export fn test_if_chain() i32 = {
    let x = 0;
    let y: i32 = if (x > 0) { yield 1; } else if (x < 0) { yield -1; } else { yield 0; };
    return y;
};

export fn test_switch_yield() i32 = {
    let d = 3;
    let v: i32 = switch (d) { case 0, 6 => yield 0; case => yield 1; };
    return v;
};

export fn test_mixed_term() i32 = {
    let x = 5;
    let y: i32 = if (x > 10) { return 100; } else { yield x; };
    return y;
};

export fn test_nested() i32 = {
    let a = 1;
    let b = 2;
    let r: i32 = if (a > 0) {
        let inner: i32 = switch (b) { case 1 => yield 10; case 2 => yield 20; case => yield 0; };
        yield inner;
    } else { yield -1; };
    return r;
};

export fn main() void = {
    assert(test_if_yield() == 1, "test_if_yield failed");
    assert(test_if_chain() == 0, "test_if_chain failed");
    assert(test_switch_yield() == 1, "test_switch_yield failed");
    assert(test_mixed_term() == 5, "test_mixed_term failed");
    assert(test_nested() == 20, "test_nested failed");
};
