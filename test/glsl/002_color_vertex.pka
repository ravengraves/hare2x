// Vertex shader with varying color
#[attribute] let a_pos = gl::vec2 { ... };
#[attribute] let a_color = gl::vec3 { ... };
#[varying] let v_color = gl::vec3 { ... };
#[builtin] let gl_Position = gl::vec4 { ... };

export fn main() void = {
	gl_Position = gl::vec4 {
		x = a_pos.x,
		y = a_pos.y,
		z = 0.0,
		w = 1.0,
	};
	v_color = a_color;
};
