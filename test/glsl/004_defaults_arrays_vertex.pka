// Defaults + arrays vertex shader
#[attribute] let a_pos = gl::vec2 { ... };
#[attribute] let a_color = gl::vec3 { ... };
#[varying] let v_color = gl::vec3 { ... };
#[uniform] let u_time: f32 = 0;
#[uniform] let u_matrix = gl::mat4 { ... };
#[builtin] let gl_Position = gl::vec4 { ... };

def SAMPLE_COUNT: int = 4;

fn wobble_offset(x: f32, t: f32 = 0.0, scale: f32 = 4.0) f32 = {
	return gl::sinf(t + x * scale) * 0.12;
};

export fn main() void = {
	let weights: [SAMPLE_COUNT]f32 = [0.1, 0.2, 0.3, 0.4];
	let offsets: [4]f32 = [0.0, 0.0, 0.0, 0.0];
	let inferred: [_]f32 = [0.0, 1.0, 2.0, 3.0];
	let zeros: [16]f32 = [0.0...];
	let wobble = wobble_offset(a_pos.x, u_time);
	let wobble2 = wobble_offset(a_pos.x);
	let mat_hint = u_matrix.col0.x * 0.0;
	let length = gl::lengthv2(a_pos);
	let dotv = gl::dotv2(a_pos, a_pos);
	let cmp = gl::lessThanv2(a_pos, gl::vec2 { x = 0.0, y = 0.0 });
	let weight_sum = weights[0] + weights[1] + weights[2] + weights[3];
	let idx_sum = inferred[0] + inferred[1] + zeros[15];
	let final_wobble = wobble
		+ wobble2 * 0.25
		+ offsets[0]
		+ weight_sum * 0.0
		+ idx_sum * 0.0
		+ length * 0.0
		+ dotv * 0.0
		+ mat_hint;
	gl_Position = gl::vec4 {
		x = a_pos.x,
		y = a_pos.y + final_wobble,
		z = 0.0,
		w = 1.0,
	};
	v_color = a_color;
};
