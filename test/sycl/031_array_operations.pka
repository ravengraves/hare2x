
// Array operations test
#[kernel] fn array_ops(
	idx: sycl::id1,
	#[global] #[read] input: *[*]f32,
	#[global] #[write] output: *[*]f32,
	N: size
) void = {
	let i = idx[0];
	if (i < N) {
		// Local array for temporary storage
		let temp: [_]f32 = [0.0f32, 1.0f32, 2.0f32, 3.0f32, 4.0f32, 5.0f32, 6.0f32, 7.0f32];

		// Read from input, add temp value, write to output
		if (i < 8z) {
			output[i] = input[i] + temp[i];
		};
	};
};
