// String and char literal coverage for SYCL backend

use sycl;
use strings;

#[kernel] fn string_literals(
	idx: sycl::id1,
	#[global] #[write] out_bytes: *[*]u8,
	#[global] #[write] out_meta: *[*]u32,
) void = {
	let i = idx[0];
	if (i != 0z) {
		return;
	};

	let s1 = "A\nB\tC";
	let s2 = `raw\n`;
	let s3 = "AB" "CD";

	let bytes1 = strings::toutf8(s1);
	let bytes2 = strings::toutf8(s2);

	out_meta[0] = len(bytes1): u32;
	out_meta[1] = len(bytes2): u32;
	out_meta[2] = 'A': u32;
	out_meta[3] = '\n': u32;
	out_meta[4] = 'B': u32;

	out_bytes[0] = bytes1[0];
	out_bytes[1] = bytes1[1];
	out_bytes[2] = bytes1[2];
	out_bytes[3] = bytes1[3];
	out_bytes[4] = bytes1[4];

	out_bytes[5] = bytes2[0];
	out_bytes[6] = bytes2[1];
	out_bytes[7] = bytes2[2];
	out_bytes[8] = bytes2[3];
	out_bytes[9] = bytes2[4];

	let round = strings::fromutf8_unsafe(bytes1);
	assert(round == s1);
	assert(rt::strcmp(s3, "ABCD"));
};
