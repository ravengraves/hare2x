
// Comprehensive test for all SYCL math builtins

#[kernel] fn math_comprehensive(
	idx: sycl::id1,
	#[global] #[read] input: *[*]f32,
	#[global] #[write] output: *[*]f32,
	N: size,
) void = {
	let i = idx[0];
	if (i < N) {
		let x = input[i];
		let result: f32 = 0.0f32;

		// Basic math
		result = result + sycl::sqrt(x * x + 1.0f32);          // sqrt
		result = result + sycl::fabs(x - 0.5f32);              // fabs/abs
		result = result + sycl::floor(x);                      // floor
		result = result + sycl::ceil(x);                       // ceil
		result = result + sycl::round(x);                      // round
		result = result + sycl::trunc(x);                      // trunc

		// Trigonometric
		result = result + sycl::sin(x);                        // sin
		result = result + sycl::cos(x);                        // cos
		result = result + sycl::tan(x * 0.1f32);               // tan
		result = result + sycl::asin(x * 0.1f32);              // asin
		result = result + sycl::acos(x * 0.1f32);              // acos
		result = result + sycl::atan(x);                       // atan
		result = result + sycl::atan2(x, x + 1.0f32);          // atan2

		// Exponential & logarithmic
		result = result + sycl::exp(x * 0.1f32);               // exp
		result = result + sycl::exp2(x * 0.1f32);              // exp2
		result = result + sycl::log(x + 1.0f32);               // log
		result = result + sycl::log2(x + 1.0f32);              // log2
		result = result + sycl::log10(x + 1.0f32);             // log10
		result = result + sycl::pow(x + 1.0f32, 2.0f32);       // pow

		// Advanced math
		result = result + sycl::rsqrt(x + 1.0f32);             // rsqrt
		result = result + sycl::fmin(x, x + 1.0f32);           // fmin
		result = result + sycl::fmax(x, x + 1.0f32);           // fmax
		result = result + sycl::min(x, x + 1.0f32);            // min
		result = result + sycl::max(x, x + 1.0f32);            // max
		result = result + sycl::clamp(x, 0.0f32, 10.0f32);     // clamp
		result = result + sycl::fma(x, 2.0f32, 1.0f32);        // fma (fused multiply-add)
		result = result + sycl::mad(x, 2.0f32, 1.0f32);        // mad (multiply-add)
		result = result + sycl::sign(x - 5.0f32);              // sign

		output[i] = result;
	};
};
