// abort in match (yield never not used)

#[kernel] fn yield_never(
	idx: sycl::id1,
	#[global] #[write] output: *[*]u32,
	N: size
) void = {
	let i = idx[0];
	if (i < N) {
		let v: u32 = i: u32;
		let ptr: nullable *u32 = null;
		if ((i & 1z) == 0z) {
			ptr = &v: nullable *u32;
		};
		let out_val: u32 = match (ptr) {
		case let p: *u32 =>
			yield *p;
		case null =>
			abort();
			yield 0u32;
		};
		output[i] = out_val;
	};
};
