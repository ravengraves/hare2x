// phase6_globals_static_arrays.pka
use rt;

type pair = struct {
	a: i32,
	b: i32,
};

let g_arr: [4]i32 = [1, 2, 3, 4];
let g_bytes: [6]i32 = [1, 2, 3, 4, 5, 6];
let g_pair: pair = pair { a = 9, b = 10 };

fn get_static_buf() *[*]i32 = {
	static let buf: [8]i32 = [0...];
	buf[0] = 11;
	return &buf: *[*]i32;
};

export fn main() void = {
	assert(g_arr[0] == 1);
	assert(g_arr[3] == 4);
	assert(g_bytes[2] == 3);
	assert(g_pair.a == 9);
	assert(g_pair.b == 10);

	let p = get_static_buf();
	assert(p[0] == 11);
};
