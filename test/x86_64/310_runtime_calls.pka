use rt;

fn memcpy_test() void = {
	let src: [4]u8 = [1, 2, 3, 4];
	let dst: [4]u8 = [0...];
	rt::memcpy(&dst: *opaque, &src: *opaque, 4);
	assert(dst[0] == 1, "memcpy[0]");
	assert(dst[3] == 4, "memcpy[3]");
};

fn memset_test() void = {
	let buf: [4]u8 = [0...];
	rt::memset(&buf: *opaque, 255, 4);
	assert(buf[0] == 255, "memset[0]");
	assert(buf[3] == 255, "memset[3]");
};

export fn main() void = {
	memcpy_test();
	memset_test();
};
