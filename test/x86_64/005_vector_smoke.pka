// vector_smoke.pka - autovectorization smoke test

export fn main() void = {
	let a: f32 = 1.0f32;
	let b: f32 = 2.0f32;
	let c: f32 = 3.0f32;
	let d: f32 = 4.0f32;
	let e: f32 = 5.0f32;
	let f: f32 = 6.0f32;
	let g: f32 = 7.0f32;
	let h: f32 = 8.0f32;

	let r0: f32 = a + b;
	let r1: f32 = c + d;
	let r2: f32 = e + f;
	let r3: f32 = g + h;
	let s0: f32 = r0 + r1;
	let s1: f32 = r2 + r3;
	let z: f32 = s0 + s1;
	assert(z > 0.0f32);

	let i0: i32 = 1;
	let i1: i32 = 2;
	let i2: i32 = 3;
	let i3: i32 = 4;
	let i4: i32 = 5;
	let i5: i32 = 6;
	let i6: i32 = 7;
	let i7: i32 = 8;

	let j0: i32 = i0 + i1;
	let j1: i32 = i2 + i3;
	let j2: i32 = i4 + i5;
	let j3: i32 = i6 + i7;
	let j4: i32 = j0 + j1;
	let j5: i32 = j2 + j3;
	let j: i32 = j4 + j5;
	assert(j == 36);
};
