// structs_globals.pka - phase4 global struct coverage

type point = struct {
	x: i32,
	y: i32,
};

type rect = struct {
	min: point,
	max: point,
};

let g_point: point = point { x = 1, y = 2 };
let g_rect: rect = rect { min = point { x = 3, y = 4 }, max = point { x = 5, y = 6 } };

export fn main() void = {
	assert(g_point.x == 1);
	assert(g_point.y == 2);
	assert(g_rect.max.y == 6);
	let r = rect { min = g_point, max = point { x = 9, y = 10 } };
	assert(r.min.y == 2);
	assert(r.max.x == 9);
};
