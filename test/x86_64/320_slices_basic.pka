use rt;
use strings;

fn sum(s: []i32) i32 = {
	let total: i32 = 0;
	for (let i = 0z; i < len(s); i += 1) {
		total += s[i];
	};
	return total;
};

export fn main() void = {
	let arr: [5]i32 = [1, 2, 3, 4, 5];
	let s = arr[1..4];
	assert(len(s) == 3);
	assert(s[0] == 2);
	assert(s[2] == 4);

	let s0 = arr[..2];
	assert(len(s0) == 2);
	assert(s0[1] == 2);

	let s2 = s[1..];
	assert(len(s2) == 2);
	assert(s2[0] == 3);

	let total = sum(arr[0..3]);
	assert(total == 6);

	let buf: [5]u8 = ['H', 'e', 'l', 'l', 'o'];
	let src: *[*]u8 = &buf: *[*]u8;
	let slice = src[0..5];
	assert(len(slice) == 5);
	assert(slice[0] == 'H');
	let s3 = strings::fromutf8_unsafe(slice);
	assert(s3 == "Hello");
};
