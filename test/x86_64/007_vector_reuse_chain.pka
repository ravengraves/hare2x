// vector_reuse_chain.pka - deeper pack reuse chain

export fn main() void = {
	let a0: f32 = 1.0f32;
	let a1: f32 = 2.0f32;
	let a2: f32 = 3.0f32;
	let a3: f32 = 4.0f32;
	let b0: f32 = 5.0f32;
	let b1: f32 = 6.0f32;
	let b2: f32 = 7.0f32;
	let b3: f32 = 8.0f32;
	let c0: f32 = 1.5f32;
	let c1: f32 = 2.5f32;
	let c2: f32 = 3.5f32;
	let c3: f32 = 4.5f32;
	let d0: f32 = 0.5f32;
	let d1: f32 = 1.5f32;
	let d2: f32 = 2.5f32;
	let d3: f32 = 3.5f32;

	let r0: f32 = a0 + b0;
	let r1: f32 = a1 + b1;
	let r2: f32 = a2 + b2;
	let r3: f32 = a3 + b3;

	let s0: f32 = r0 + c0;
	let s1: f32 = r1 + c1;
	let s2: f32 = r2 + c2;
	let s3: f32 = r3 + c3;

	let t0: f32 = s0 * d0;
	let t1: f32 = s1 * d1;
	let t2: f32 = s2 * d2;
	let t3: f32 = s3 * d3;

	let u0: f32 = t0 + 1.0f32;
	let u1: f32 = t1 + 2.0f32;
	let u2: f32 = t2 + 3.0f32;
	let u3: f32 = t3 + 4.0f32;

	let z: f32 = u0 + u1 + u2 + u3;
	assert(z > 120.0f32);

	let i0: i32 = 10;
	let i1: i32 = 20;
	let i2: i32 = 30;
	let i3: i32 = 40;
	let i4: i32 = 50;
	let i5: i32 = 60;
	let i6: i32 = 70;
	let i7: i32 = 80;

	let j0: i32 = i0 + i4;
	let j1: i32 = i1 + i5;
	let j2: i32 = i2 + i6;
	let j3: i32 = i3 + i7;

	let k0: i32 = j0 + 1;
	let k1: i32 = j1 + 2;
	let k2: i32 = j2 + 3;
	let k3: i32 = j3 + 4;

	let m0: i32 = k0 * 2;
	let m1: i32 = k1 * 3;
	let m2: i32 = k2 * 4;
	let m3: i32 = k3 * 5;

	let sum: i32 = m0 + m1 + m2 + m3;
	assert(sum == 1400);
};
