use rt;
use strings;

fn compare(a: str, b: str) bool = {
	return a == b;
};

export fn main() void = {
	let s1: str = "Line 1\nLine 2";
	assert(len(s1) == 13);

	let s2: str = `C:\path\to\file`;
	assert(len(s2) == 15);

	let s3: str = "\u00E9";
	assert(len(s3) == 2);

	let s4: str = "Hello, " "World!";
	assert(len(s4) == 13);

	assert("hello" == "hello");
	assert("hello" != "world");

	let bytes = strings::toutf8("abc");
	assert(len(bytes) == 3);
	assert(bytes[0] == 'a');
	let s5 = strings::fromutf8_unsafe(bytes);
	assert(s5 == "abc");

	let s6: str = "test\\nend";
	let s7: str = `test\nend`;
	assert(s6 == s7);
	assert(compare("hi", "hi"));
};
