fn gl_expv4(x: gl_vec4) gl_vec4;

fn gl_logf(x: f32) f32;
fn gl_logv2(x: gl_vec2) gl_vec2;
fn gl_logv3(x: gl_vec3) gl_vec3;
fn gl_logv4(x: gl_vec4) gl_vec4;

fn gl_exp2f(x: f32) f32;
fn gl_exp2v2(x: gl_vec2) gl_vec2;
fn gl_exp2v3(x: gl_vec3) gl_vec3;
fn gl_exp2v4(x: gl_vec4) gl_vec4;

fn gl_log2f(x: f32) f32;
