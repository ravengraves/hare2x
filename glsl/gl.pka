// gl.pka - GLSL builtin types and function stubs for Pika GLSL target
// Note: function stubs are for documentation/type hints only.
// Vector/matrix overloads exist in GLSL even if not listed here.

// Vector types (struct layout for Pika field access)
type gl_vec2 = struct { x: f32, y: f32 };
type gl_vec3 = struct { x: f32, y: f32, z: f32 };
type gl_vec4 = struct { x: f32, y: f32, z: f32, w: f32 };

type gl_ivec2 = struct { x: i32, y: i32 };
type gl_ivec3 = struct { x: i32, y: i32, z: i32 };
type gl_ivec4 = struct { x: i32, y: i32, z: i32, w: i32 };

type gl_bvec2 = struct { x: bool, y: bool };
type gl_bvec3 = struct { x: bool, y: bool, z: bool };
type gl_bvec4 = struct { x: bool, y: bool, z: bool, w: bool };

// Matrix types (column-major layout)
type gl_mat2 = struct { col0: gl_vec2, col1: gl_vec2 };
type gl_mat3 = struct { col0: gl_vec3, col1: gl_vec3, col2: gl_vec3 };
type gl_mat4 = struct { col0: gl_vec4, col1: gl_vec4, col2: gl_vec4, col3: gl_vec4 };

// Sampler types
type gl_sampler2D = struct { _opaque: i32 };
type gl_samplerCube = struct { _opaque: i32 };

// GLSL builtins (use via gl::name, compiled to GLSL name)
fn gl_radians(degrees: f32) f32;
fn gl_degrees(radians: f32) f32;
fn gl_sin(angle: f32) f32;
fn gl_cos(angle: f32) f32;
fn gl_tan(angle: f32) f32;
fn gl_asin(x: f32) f32;
fn gl_acos(x: f32) f32;
fn gl_atan(y_over_x: f32) f32;
fn gl_atan2(y: f32, x: f32) f32;

fn gl_pow(x: f32, y: f32) f32;
fn gl_exp(x: f32) f32;
fn gl_log(x: f32) f32;
fn gl_exp2(x: f32) f32;
fn gl_log2(x: f32) f32;
fn gl_sqrt(x: f32) f32;
fn gl_inversesqrt(x: f32) f32;

fn gl_abs(x: f32) f32;
fn gl_sign(x: f32) f32;
fn gl_floor(x: f32) f32;
fn gl_ceil(x: f32) f32;
fn gl_fract(x: f32) f32;
fn gl_mod(x: f32, y: f32) f32;
fn gl_min(x: f32, y: f32) f32;
fn gl_max(x: f32, y: f32) f32;
fn gl_clamp(x: f32, min_val: f32, max_val: f32) f32;
fn gl_mix(x: f32, y: f32, a: f32) f32;
fn gl_step(edge: f32, x: f32) f32;
fn gl_smoothstep(edge0: f32, edge1: f32, x: f32) f32;

fn gl_length(v: gl_vec3) f32;
fn gl_distance(p0: gl_vec3, p1: gl_vec3) f32;
fn gl_dot(v1: gl_vec3, v2: gl_vec3) f32;
fn gl_cross(v1: gl_vec3, v2: gl_vec3) gl_vec3;
fn gl_normalize(v: gl_vec3) gl_vec3;
fn gl_faceforward(n: gl_vec3, i: gl_vec3, nref: gl_vec3) gl_vec3;
fn gl_reflect(i: gl_vec3, n: gl_vec3) gl_vec3;
fn gl_refract(i: gl_vec3, n: gl_vec3, eta: f32) gl_vec3;

fn gl_matrixCompMult(m1: gl_mat4, m2: gl_mat4) gl_mat4;

fn gl_lessThan(v1: gl_vec3, v2: gl_vec3) gl_bvec3;
fn gl_lessThanEqual(v1: gl_vec3, v2: gl_vec3) gl_bvec3;
fn gl_greaterThan(v1: gl_vec3, v2: gl_vec3) gl_bvec3;
fn gl_greaterThanEqual(v1: gl_vec3, v2: gl_vec3) gl_bvec3;
fn gl_equal(v1: gl_vec3, v2: gl_vec3) gl_bvec3;
fn gl_notEqual(v1: gl_vec3, v2: gl_vec3) gl_bvec3;
fn gl_any(v: gl_bvec3) bool;
fn gl_all(v: gl_bvec3) bool;
fn gl_not(v: gl_bvec3) gl_bvec3;

fn gl_texture2D(sampler: gl_sampler2D, coord: gl_vec2) gl_vec4;
fn gl_texture2D_bias(sampler: gl_sampler2D, coord: gl_vec2, bias: f32) gl_vec4;
fn gl_textureCube(sampler: gl_samplerCube, coord: gl_vec3) gl_vec4;

// Suffix overload helpers (type hints only)
fn gl_radiansf(degrees: f32) f32;
fn gl_radiansv2(degrees: gl_vec2) gl_vec2;
fn gl_radiansv3(degrees: gl_vec3) gl_vec3;
fn gl_radiansv4(degrees: gl_vec4) gl_vec4;

fn gl_degreesf(radians: f32) f32;
fn gl_degreesv2(radians: gl_vec2) gl_vec2;
fn gl_degreesv3(radians: gl_vec3) gl_vec3;
fn gl_degreesv4(radians: gl_vec4) gl_vec4;

